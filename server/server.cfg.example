echo Executing DRAZVIO server config...
hostname DRAZVIO | DRIFT + DM
language Russian
mapname San Andreas
gamemodetext Drift / DeathMatch
rcon 0
rcon_password REPLACE_WITH_UNIQUE_PRIVATE_RCON_PASSWORD
gamemode0 mod05 1
filterscripts BonusSys elevator2 Garage gatesys2 island keyscan MPSys myobj reklama gps radio3
plugins FileFunctions sscanf streamer
announce 0
query 1
port 7777
maxplayers 100
