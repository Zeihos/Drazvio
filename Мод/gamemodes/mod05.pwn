				case 1: format(string, sizeof(string), " Игрок %s [%d]: {FFFF00}VIP-1 {FFFF00}1-LVL випа.", giveplayer, para1);
				case 2: format(string, sizeof(string), " Игрок %s [%d]: {FFFF00}VIP-2 {FFFF00}2-LVL випа.", giveplayer, para1);
				case 3: format(string, sizeof(string), " Игрок %s [%d]: {FFFF00}VIP-3 {FFFF00}3-LVL випа.", giveplayer, para1);
			}
			new aa222[64];//доработка для использования Русских ников
			format(aa222, sizeof(aa222), "%s", sendername);//доработка для использования Русских ников
			new aa333[64];//доработка для использования Русских ников
			format(aa333, sizeof(aa333), "%s", giveplayer);//доработка для использования Русских ников
			printf(" --> Игрок %s [%d] просмотрел статистику игрока %s [%d] .", aa222, playerid, aa333, para1);//доработка для использования Русских ников
//			printf(" --> Игрок %s [%d] просмотрел статистику игрока %s [%d] .", sendername, playerid, giveplayer, para1);
			SendClientMessage(playerid, COLOR_LIGHTBLUE, "---------------------------------------------------------------");
			SendClientMessage(playerid, COLOR_GREEN, string);
			format(string, sizeof(string), " Время бана чата: {FFFF00}%d секунд. {00FF00}Время тюрьмы: {FFFF00}%d секунд.",
			PlayerInfo[para1][pMutedsec], PlayerInfo[para1][pPrisonsec]);
			SendClientMessage(playerid, COLOR_GREEN, string);
			if(pertrain == 0)
			{
				SendClientMessage(playerid, COLOR_RED, " Всем игрокам ЗАПРЕЩЕНО водить поезда !");
			}
			else
