				OpenIP22[32],OpenIP[32],OpenIP22[33],OpenIP[33],OpenIP22[34],OpenIP[34],OpenIP22[35],OpenIP[35]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
