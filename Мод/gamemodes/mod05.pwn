        KillTimer(ServerTimerOne);
        KillTimer(ServerTimerTwo);
//==============================================================================
//                              GarHouse
//==============================================================================
	new file[HOUSEFILE_LENGTH], tmp;
	Loop(i, MAX_PLAYERS)
	{
	    if(IsPlayerConnected(i) && !IsPlayerNPC(i))
	    {
	        tmp = GetPVarInt(i, "LastHouseCP");
			format(file, sizeof(file), FILEPATH, tmp);
		    if(!strcmp(GetHouseOwner(tmp), pNick(i), CASE_SENSETIVE) && GetPVarInt(i, "IsInHouse") == 1 && dini_Exists(file))
			{
			    dini_IntSet(file, "QuitInHouse", 1);
			    #if defined GH_HOUSECARS
			    	SaveHouseCar(tmp);
		        #endif
			}
		}
	}
    UnloadHouses(); // Выгрузка домов (также разгружает дом автомобили)
//==============================================================================
//                              End GarHouse
//==============================================================================

	Delete3DTextLabel(fantxt);//удаляем 3D-текст с несущесвующим ИД

	new Max = GetMaxPlayers();//drift bonus
	for(new i=0; i<Max; i++)
	{
		Delete3DTextLabel(Level3D[i]);
	}

	for(new i = 0; i < MAX_PLAYERS; i++)//speedometer
	{
	    TextDrawHideForPlayer(i, VehicleSpeed[i]);
	    TextDrawHideForPlayer(i, KMH[i]);
	}

//------------------------------- Elevator -------------------------------------
	DestroyObject(Obj_Elevator);
	DestroyObject(Obj_ElevatorDoors[0]);
	DestroyObject(Obj_ElevatorDoors[1]);
	Delete3DTextLabel(Label_Elevator);

	for(new i; i < sizeof(Obj_FloorDoors); i ++)
	{
	    DestroyDynamicObject(Obj_FloorDoors[i][0]);
		DestroyDynamicObject(Obj_FloorDoors[i][1]);
		Delete3DTextLabel(Label_Floors[i]);
		Delete3DTextLabel(Label_Floors22[i]);
	}
//----------------------------- End Elevator -----------------------------------

	UnloadBusSystem();//выгрузка системы бизнесов//BusSystem

#if (MOD22INS == 1)
	fileClose(ServerLogFile);//античит-2
#endif

#if (MOD90INS == 1)
	db_close(playerdb);//отключаем базу данных аккаунтов игроков от сервера
#endif

	for(new i = 0; i < MAX_PLAYERS; i++)//удаление мап иконок наблюдения
	{
    	if(mapiconid[i] != -600)//если ID мап иконки наблюдения НЕ пустой, то:
    	{
			DestroyDynamicMapIcon(mapiconid[i]);//удаление мап иконки наблюдения
		}
	}
	return 1;
}

public OnPlayerRequestClass(playerid, classid)
{
	SetPlayerCameraPos(playerid, 2193.8118, 1593.0004, 1006.1416);
	SetPlayerCameraLookAt(playerid, 2193.7944, 1593.9994, 1006.0316);
	SetPlayerPos(playerid, 2193.9412,1597.5872,1005.0625);
	SetPlayerInterior(playerid, 1);
 	SetPlayerFacingAngle(playerid, 176.6017);
	return 1;
}

public OnPlayerConnect(playerid)
{
    // Stage 7: remove the previous occupant's identity BEFORE any early return.
    // A rejected connection must never retain the old account's privileges.
    gPlayerLogged[playerid] = 0;
    gPlayerAccount[playerid] = 0;
    PlayerInfo[playerid][pKey][0] = EOS;
    PlayerInfo[playerid][pAdmin] = 0;
    PlayerInfo[playerid][pVIP] = 0;
    PlayerInfo[playerid][pAdmshad] = 0;
    PlayerInfo[playerid][pAdmlive] = 0;
    PlayerInfo[playerid][pAdmscancom] = 0;
    PlayerInfo[playerid][pLock] = 0;
    PlayerCombo[playerid] = 1;
    DZ_PlayerEpoch[playerid]++;
    twoIP[playerid][0] = EOS; // Reused slot must not retain the old IP. 
    DZ_MinerSession[playerid]++; // invalidate callbacks from a previous occupant of this ID
TextDrawSetString(LoadScreen, RandomLoadScreen[random(sizeof(RandomLoadScreen))]);
TextDrawShowForPlayer(playerid, LoadScreen);
FPS[playerid] = CreatePlayerTextDraw(playerid, 10.000000,430.000000,"_");
        PlayerTextDrawAlignment(playerid, FPS[playerid],0);
        PlayerTextDrawBackgroundColor(playerid, FPS[playerid],0x000000ff);
        PlayerTextDrawFont(playerid, FPS[playerid],1);
        PlayerTextDrawLetterSize(playerid, FPS[playerid],0.500000,1.5);
        PlayerTextDrawColor(playerid, FPS[playerid], COLOR_YELLOW);
        PlayerTextDrawSetOutline(playerid, FPS[playerid],1);
        PlayerTextDrawSetProportional(playerid, FPS[playerid],1);
	PlayerTextDrawSetShadow(playerid, FPS[playerid],1);
    PlayerTextDrawShow(playerid, FPS[playerid]);
	new pname[MAX_PLAYER_NAME];
 	GetPlayerName(playerid, pname, sizeof(pname));
new unixtime = GetTickCount();
for(new i=0; i<MAX_PLAYERS; i++)

{
    if(!strcmp(ExitInfo[i][ExitName],pname,true))
    {
        if(unixtime - ExitInfo[i][ExitTime] <= 15000) return SendClientMessage(playerid,COLOR_LIGHTRED,"Повторный вход на сервер возможен не раньше, чем через 15 секунд"), SetTimerEx("DZ_Guard_PlayKick", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
        else strmid(ExitInfo[i][ExitName],"None", 0, strlen("None"), 32), ExitInfo[i][ExitTime] = 0;
    }
}
        playerworking[playerid] = 0;
        TextDrawHideForPlayer(playerid,ServerTextDrawTwo);
    	TextDrawHideForPlayer(playerid,ServerTextDrawThree[playerid]);
        TextDrawHideForPlayer(playerid,ServerTextDrawFour[playerid]);
        TextDrawHideForPlayer(playerid,ServerTextDrawFive[playerid]);
        TextDrawSetString(ServerTextDrawThree[playerid]," ");
        TextDrawSetString(ServerTextDrawFour[playerid]," ");
        TextDrawSetString(ServerTextDrawFive[playerid]," ");
        PlayerMoney[playerid] = 0;
        PlayerPositionX[playerid] = 0.0;
        PlayerPositionY[playerid] = 0.0;
        PlayerPositionZ[playerid] = 0.0;
        PlayerCombo[playerid] = 1; // Updated after successful login.
        DZ_AchievementTick[playerid] = 0;
        PlayerInfo[playerid][pDostig]       = 0;
		PlayerInfo[playerid][pDostigg]      = 0;
		PlayerInfo[playerid][pDostiggg]     = 0;
		PlayerInfo[playerid][pDostigggg]    = 0;
		PlayerInfo[playerid][pDostiggggg]    = 0;
		PlayerInfo[playerid][pDostigggggg]    = 0;
		PlayerInfo[playerid][pDostiggggggg]    = 0;
		PlayerInfo[playerid][pDostigggggggg]    = 0;
        KillTimer(PlayerTimerOne[playerid]);
	SetPVarInt(playerid, "Music", 0);
	Intropic[playerid] = 0;
	Watching[playerid] = 0;
	Goto[playerid] = 0;
    DM[playerid] = 0;
    noTotForest[playerid] = 0;
	PlayerOnJob[playerid] = false;
	PlayerStartJob[playerid] = false;
	GetPlayerMetall[playerid] = 0;
	AllPlayerMetall[playerid] = 0;
	GetPlayerMetallEx[playerid] = 0;
	AllPlayerMetallEx[playerid] = 0;
	ExtraMetall[playerid] = 0;
    DarkPowerText[playerid] = CreatePlayerTextDraw(playerid, 550.000000, 2.000000, "] DRAZVIO ]");
    PlayerTextDrawColor(playerid, DarkPowerText[playerid], COLOR_YELLOW);
	PlayerTextDrawFont(playerid, DarkPowerText[playerid],2);
	PlayerTextDrawLetterSize(playerid, DarkPowerText[playerid],0.360000,2.000000);
	PlayerTextDrawSetOutline(playerid, DarkPowerText[playerid],1);
	PlayerTextDrawShow(playerid, DarkPowerText[playerid]);
    Checkpoint[playerid]=0;
 	SetPVarInt(playerid, "SpawnMusic", 0);
	PlayAudioStreamForPlayer(playerid, "http://air.radiorecord.ru:8102/rus_320");
 //////////////////////Мирцающий ник
    Glow[playerid] = 0;///
	/////////////////////
	functioncon[playerid]++;//прибавляем 1 к контрольной переменной функций

	DontRepeat[playerid] = false;

    PGang[playerid] = 0;//Gangs system
    GangLvl[playerid] = 0;

	playspa[playerid] = 0;//переменная спавна игрока

	new ip[126];
	GetPlayerIp(playerid, ip, sizeof(ip));
	PlayerInfo[playerid][pIPAdr] = ip;

#if (MOD90INS == 1)
	migration[playerid] = 0;//обнулить режим миграции аккаунта
#endif
	LevelStats[playerid] = 0;//drift bonus
	DerbyID[playerid] = 0;//обнулить дерби-режим
	SetPVarInt(playerid, "MnMode", 1);//глобальная переменная режима меню
	PlayCRSH[playerid] = 0;//обнулить блокировку спидхака
	PlayCRTP[playerid] = 1;//блокировка контроля координат
	mapiconid[playerid] = -600;//очистка ID мап иконки наблюдения
	StopReport[playerid] = 0;//переменная задержки команды /report
	StopHeal[playerid] = 0;//переменная задержки команды /heal
	LocTime[playerid] = GlTime;//передать общее время в локальное
	PlayLock1[0][playerid] = 600;//отключить блокировку игрока
	NETrecPl[playerid] = 0;//обнулить контроль сети
	NETsenPl[playerid] = 0;
	NETafkPl[playerid][1] = 0;//обнулить время AFK
	LockSpawn[playerid] = 0;//разблокировать заполнение слотов оружия и предметов
	idgangsave[playerid] = 0;//очистка ID банды для записи
	prisoncount[playerid] = 0;//задержка контроля игрока в тюрьме
	passrcon[playerid] = 0;//бан взлома RCON-пароля
	oneminkick[playerid] = 0;//кик - если не заспавнился
	countdown[playerid] = -1;//очистка обратного отсчёта
	strdel(PlayerInfo[playerid][pTDReg], 0, 256);//очистка времени и даты регистрации
	strdel(fbanreason[playerid], 0, 256);//очистка причины бана
    gPlayerLogTries[playerid] = 0;
    gPlayerLogged[playerid] = 0;

	NRadio[playerid] = 0;//задаём игроку несуществующий номер подключенного радио//Радио
	StopAudioStreamForPlayer(playerid);//отключим любой поток

	//вход на сервер
	new pervh[256];
	GetPlayerName(playerid,pname,sizeof(pname));
	strdel(RealName[playerid],0,MAX_PLAYER_NAME);//очистить реальный ник игрока
	new aa333[64];//доработка для использования Русских ников
	format(aa333, sizeof(aa333), "%s", pname);//доработка для использования Русских ников
	strcat(RealName[playerid], aa333);//запомнить реальный ник игрока (доработка для использования Русских ников)
//	strcat(RealName[playerid], pname);//запомнить реальный ник игрока
	format(pervh,sizeof(pervh),"* %s [%d] присоединился к серверу.",pname,playerid);
	SendClientMessageToAll(COLOR_GREEN,pervh);
	printf("* Игрок %s [%d] присоединился к серверу.",aa333,playerid);
	SetPlayerColor(playerid, ColNick[17]);//присвоить игроку серый цвет (до спавна)

//------------------------------ BusSystem -------------------------------------
	playspabs[playerid] = 0;//игрок не заспавнился
	playIDbus[playerid] = -600;//не существующий ИД бизнеса для игрока
//---------------------------- End BusSystem -----------------------------------

	for(new i = 0; i < 20; i++)
	{
		SendClientMessage(playerid, 0xFFFFFFFF, " ");
	}
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Обязательно прочтите {60FF00}правила игры {FFFFFF}на сервере: {60FF00}/rules");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Мы рады вас видеть на {FFE400}•.:DRAZVIO:.• {FFFFFF}, для справки введите {60ff00}/help");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FF0000}Дополнительные телепорты: {60ff00}/helptp!!!!");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Чтобы поприветствовать всех игроков, введите: {2F60FF}/hh");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Чтобы попрощаться со всеми игроками, введите: {2F60FF}/bb");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Покупайте дома, гаражи, бизнесы. {2F60FF}Так же создавайте свои банды");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Для входа в меню нажмите {FFF82F}Alt {FFFFFF}или {FFF82F}2 {FFE400}(вы должны быть в автомобиле)");
	SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FFFFFF}Официальная группа проекта: {2F60FF}DRAZVIO (новости уточняйте у администрации)");
	SendClientMessage(playerid, COLOR_YELLOW, "DRAZVIO | {FFFFFF}Приятной игры!");
	SendDeathMessage(INVALID_PLAYER_ID, playerid, 200);//отобразить иконку коннекта в килл-чате

	exitcheat[playerid] = 0;//присоединившийся игрок - НЕ чит
	locper1[playerid] = 0;
	locper2[playerid] = 0;
	locper33[playerid] = 0;//сборка шаблона IP-адреса игрока
	locper44[playerid] = 0;
	while(locper33[playerid] <= strlen(PlayerInfo[playerid][pIPAdr]))
	{
		if(PlayerInfo[playerid][pIPAdr][locper33[playerid]] == 46) { locper44[playerid]++; }
		clipip[playerid][locper33[playerid]] = PlayerInfo[playerid][pIPAdr][locper33[playerid]];
		locper33[playerid]++;
		if(locper44[playerid] == 2) { break; }
	}
	clipip[playerid][locper33[playerid]] = 42;
	locper33[playerid]++;
	clipip[playerid][locper33[playerid]] = 46;
	locper33[playerid]++;
	clipip[playerid][locper33[playerid]] = 42;
	locper33[playerid]++;
	clipip[playerid][locper33[playerid]] = 0;
	locper33[playerid]++;
	clipip[playerid][locper33[playerid]] = 0;
	locper44[playerid] = 4; // Stage 7: default four users behind one NAT; OpenIP may override.
	for(new m = 0; m < 40; m++)//поиск IP-адреса игрока в IP-слотах
	{
		if((strcmp(PlayerInfo[playerid][pIPAdr], OpenIP[m], false) == 0 || strcmp(clipip[playerid], OpenIP[m], false) == 0) && strlen(OpenIP[m]) != 0)
		{//если IP-адреса игрока был найден в IP-слотах, то:
			locper44[playerid] = OpenIP22[m];//запоминаем новый максимум подключений для заданного IP-адреса
		}
	}
	while (locper1[playerid] < MAX_PLAYERS)//цикл для всех игроков
	{
		if(strcmp(PlayerInfo[playerid][pIPAdr], twoIP[locper1[playerid]], true) == 0 && strlen(twoIP[locper1[playerid]]) != 0)
		{//сравниваем IP игрока с IP вышедших игроков
			locper2[playerid] = 1;
			break;
		}
		locper1[playerid]++;
	}
	if(locper2[playerid] == 1)
    {
        // Stage 7: a recently reused IP is not proof of cheating.
        // A dropped connection or NAT can trigger this heuristic.
        printf("[DRAZVIO] Recent IP reconnect (no automatic ban): playerid=%d", playerid);
    }

	locper33[playerid] = 0;//контрольная переменная максимума подключений для заданного IP-адреса = 0
	for(new k=0;k<MAX_PLAYERS;k++)//цикл для всех игроков
	{
		if(IsPlayerConnected(k))//дальнейшее выполняем если игрок в коннекте
		{//сравниваем IP игрока с уже "подключенными" IP
			if(strcmp(PlayerInfo[playerid][pIPAdr], PlayerInfo[k][pIPAdr], true) == 0)
			{
				locper33[playerid]++;//прибавляем 1 к контрольной переменной максимума подключений для заданного IP-адреса
			}
		}
	}
	if(locper33[playerid] > locper44[playerid])
    {
        // Stage 7: limit concurrent sessions only, never ban a whole IP.
        // This is an operational limit, not an anti-cheat conviction.
        printf("[DRAZVIO] Per-IP connection limit: playerid=%d count=%d limit=%d", playerid, locper33[playerid], locper44[playerid]);
        SendClientMessage(playerid, COLOR_LIGHTRED, "DRAZVIO: превышен лимит подключений с одного IP.");
        SetTimerEx("DZ_Guard_PlayKick", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
        return 1;
    }

	scrmod[0][playerid] = 0;//переменная режимов экрана
	scrmod[1][playerid] = 0;//переменная режимов экрана
	scrmod[2][playerid] = 0;//переменная режимов экрана
	scrmod[3][playerid] = 0;//переменная режимов экрана
	scrmod[4][playerid] = 0;//переменная режимов экрана
	scrmod[5][playerid] = 0;//переменная режимов экрана
	SetPlayerFightingStyle(playerid, FIGHT_STYLE_NORMAL);//установить нормальный стиль боя
    perfrost[playerid] = 600;//отключение заморозки
	compdrift[playerid] = -1000000;//отключение от дрифт-соревнования
//	caravto[playerid] = 0;
	playcar[playerid] = 0;
	tunset[playerid] = 1;//0-тюнинг в любом транспорте, 1-тюнинг в своём транспорте
    autorepair[playerid] = 1;

    PlayerInfo[playerid][pMinlog] = 0;//минут на сервере

	dialogadm[playerid] = 0;//обнуляем контрольную переменную админ-меню
	dialogcon[playerid] = 0;//обнуляем контрольную переменную диалогов
	chatcon[playerid] = 0;//обнуляем контрольную переменную чата
	PlayerInfo[playerid][pAdmlive] = 0;//убрать бессмертие
	livdop[playerid] = 0;
	admper1[playerid] = 600;//переменная наблюдения 1
	admper6[playerid] = 0;//переменная наблюдения 6
	SetPVarInt(playerid, "PlMon", 100000);//глобальная переменная денег игрока
 	SetPVarInt(playerid, "PlSkin", 0);//глобальная переменная скина игрока
	neon[playerid][0] = 0;//присваиваем неону несуществующий номер объекта
	neon[playerid][1] = 0;//присваиваем неону несуществующий номер объекта
	neon[playerid][2] = 0;//несуществующий ид транспорта с неоном
    PlayerInfo[playerid][pDeaths] = 0;
    PlayerInfo[playerid][pKills] = 0;
    PlayerInfo[playerid][pAdmscancom] = 0;
    PlayerInfo[playerid][pVIP] = 0;
    PlayerInfo[playerid][pDeport] = 0;
    PlayerInfo[playerid][pRecPM] = 1;
    PlayerInfo[playerid][pWanted] = 0;
    PlayerInfo[playerid][pAdmin] = 0;
	PlayerInfo[playerid][pAdmshad] = 0;//переменная скрытого админа
	PlayerInfo[playerid][pFragSlvl] = 0;
	PlayerInfo[playerid][pFragTlvl] = 0;
    PlayerInfo[playerid][pFragBlvl] = 0;
    PlayerInfo[playerid][pLock] = 0;

	PlayerInfo[playerid][pPrison] = 0;
	PlayerInfo[playerid][pPrisonsec] = 0;
	SetPVarInt(playerid, "SecPris", PlayerInfo[playerid][pPrisonsec]);//записываем в глобальную переменную секунды тюрьмы
	PlayerInfo[playerid][pMuted] = 0;
	PlayerInfo[playerid][pMutedsec] = 0;

//	PlayerInfo[playerid][pPISTOL] = 1;
//	PlayerInfo[playerid][pPISTOL_SILENCED] = 1;
//	PlayerInfo[playerid][pDESERT_EAGLE] = 1;
//	PlayerInfo[playerid][pSHOTGUN] = 1;
//	PlayerInfo[playerid][pSAWNOFF_SHOTGUN] = 1;
//	PlayerInfo[playerid][pSPAS12_SHOTGUN] = 1;
//	PlayerInfo[playerid][pMICRO_UZI] = 1;
//	PlayerInfo[playerid][pMP5] = 1;
//	PlayerInfo[playerid][pAK47] = 1;
//	PlayerInfo[playerid][pM4] = 1;
//	PlayerInfo[playerid][pSNIPERRIFLE] = 1;

//	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_PISTOL_SILENCED, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_DESERT_EAGLE, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_SHOTGUN, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_SAWNOFF_SHOTGUN, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_SPAS12_SHOTGUN, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_MICRO_UZI, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_MP5, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_AK47, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_M4, 1);
//	SetPlayerSkillLevel(playerid, WEAPONSKILL_SNIPERRIFLE, 1);

//==============================================================================
//                              GarHouse
//==============================================================================

	lockpas[playerid] = 0;//разблокировать диалог ввода пароля

//==============================================================================
//                              End GarHouse
//==============================================================================

	TpDestA[playerid][0] = playspax[tpspa];//установка случайных телепортов
	TpDestA[playerid][1] = playspay[tpspa];
	TpDestA[playerid][2] = playspaz[tpspa];
	TpDestA[playerid][3] = playspaa[tpspa];
	TpPosA[playerid][0] = 0;
	TpPosA[playerid][1] = 0;
	TpDestP[playerid][0] = playspax[tpspa];
	TpDestP[playerid][1] = playspay[tpspa];
	TpDestP[playerid][2] = playspaz[tpspa];
	TpDestP[playerid][3] = playspaa[tpspa];
	TpPosP[playerid] = 0;

	for(new i=0;i<13;i++)//обнуление слотов оружия
	{
		playweap[playerid][i] = 0;
		playammo[playerid][i] = 0;
	}
if(exitcheat[playerid] == 0)//если присоединившийся игрок - НЕ чит, то:
	{
    	new playrname[MAX_PLAYER_NAME];
		new connect[128];
		GetPlayerName(playerid, playrname, sizeof(playrname));
		new regdialog[128];
		GetPlayerName(playerid, regdialog, sizeof(regdialog));
        new logdialog[128];
		GetPlayerName(playerid, logdialog, sizeof(logdialog));
#if (MOD90INS == 0 && MOD33INS == 0)
		format(connect, sizeof(connect), "players/%s.ini", playrname);
//		format(connect, sizeof(connect), "%s.ini", playrname);
	    format(regdialog, sizeof(regdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь не {44A5FF}зарегистированы\n{FFFFFF}Придумайте себе {44A5FF}пароль", playrname, playerid);
        format(logdialog, sizeof(logdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь уже {44A5FF}зарегистированы\n{FFFFFF}Введите свой пароль.", playrname, playerid);
		if(fexist(connect))
		{
    		gPlayerAccount[playerid] = 1;
 			ShowPlayerDialog(playerid,1,DIALOG_STYLE_INPUT,"{00C8E7}Авторизация",logdialog,"Войти","Отмена");
		}
		else
		{
    		gPlayerAccount[playerid] = 0;
     		ShowPlayerDialog(playerid,0,DIALOG_STYLE_PASSWORD,"{00C8E7}Регистрация",regdialog,"Войти","Отмена");
 		}
#endif
#if (MOD90INS == 0 && MOD33INS == 1)
		format(connect, sizeof(connect), "players/%s.ini", playrname);
//		format(connect, sizeof(connect), "%s.ini", playrname);
	    format(regdialog, sizeof(regdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь не {44A5FF}зарегистированы\n{FFFFFF}Придумайте себе {44A5FF}пароль", playrname, playerid);
	    format(logdialog, sizeof(logdialog),"{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь уже {44A5FF}зарегистированы\n{FFFFFF}Введите свой пароль.", playrname, playerid);
		if(fexist(connect))
		{
    		gPlayerAccount[playerid] = 1;
            ShowPlayerDialog(playerid,1,DIALOG_STYLE_PASSWORD,"{00C8E7}Авторизация",logdialog,"Войти","Отмена");
		}
		else
		{
    		gPlayerAccount[playerid] = 0;
			ShowPlayerDialog(playerid,0,DIALOG_STYLE_PASSWORD,"{00C8E7}Регистрация",regdialog,"Войти","Отмена");
 		}
#endif
#if (MOD90INS == 1 && MOD33INS == 0)
		format(connect, sizeof(connect), "players/%s.ini", playrname);
//		format(connect, sizeof(connect), "%s.ini", playrname);
	    format(regdialog, sizeof(regdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь не {44A5FF}зарегистированы\n{FFFFFF}Придумайте себе {44A5FF}пароль", playrname, playerid);
        format(logdialog, sizeof(logdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь уже {44A5FF}зарегистированы\n{FFFFFF}Введите свой пароль.", playrname, playerid);
		if(fexist(connect))//если аккаунт зарегистрирован в fopen, то:
		{
    		migration[playerid] = 1;//делаем отметку о миграции аккаунта в SQLite,
    		gPlayerAccount[playerid] = 1;//и входим в аккаунт
 			ShowPlayerDialog(playerid,1,DIALOG_STYLE_INPUT,"{00C8E7}Авторизация",logdialog,"Войти","Отмена");
		}
		else//иначе:
		{
			format(connect, sizeof(connect), "SELECT * FROM Players WHERE (Name = '%s')", playrname);//создаём запрос БД
			querydb[playerid] = db_query(playerdb, connect);//отправляем запрос БД
			if(db_num_rows(querydb[playerid]) == 0)//переведём результат запроса в число найденных строк в БД
			{//если число строк = 0 (такого аккаунта в БД нет), то - регистрация аккаунта
    			gPlayerAccount[playerid] = 0;
			    ShowPlayerDialog(playerid,0,DIALOG_STYLE_PASSWORD,"{00C8E7}Регистрация",regdialog,"Войти","Отмена");
				db_free_result(querydb[playerid]);//очищаем результат запроса БД
			}
			else//иначе - {00C8E7}Авторизация
			{
    			gPlayerAccount[playerid] = 1;
 				ShowPlayerDialog(playerid,1,DIALOG_STYLE_INPUT,"{00C8E7}Авторизация",logdialog,"Войти","Отмена");
				db_free_result(querydb[playerid]);//очищаем результат запроса БД
 			}
 		}
#endif
#if (MOD90INS == 1 && MOD33INS == 1)
		format(connect, sizeof(connect), "players/%s.ini", playrname);
//		format(connect, sizeof(connect), "%s.ini", playrname);
	    format(regdialog, sizeof(regdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь не {44A5FF}зарегистированы\n{FFFFFF}Придумайте себе {44A5FF}пароль", playrname, playerid);
        format(logdialog, sizeof(logdialog), "{FFFFFF}Здравствуйте {44A5FF}%s \n{FFFFFF}Вы здесь уже {44A5FF}зарегистированы\n{FFFFFF}Введите свой пароль.", playrname, playerid);
		if(fexist(connect))//если аккаунт зарегистрирован в fopen, то:
		{
    		migration[playerid] = 1;//делаем отметку о миграции аккаунта в SQLite,
    		gPlayerAccount[playerid] = 1;//и входим в аккаунт
 			ShowPlayerDialog(playerid,1,DIALOG_STYLE_PASSWORD,"{00C8E7}Авторизация",logdialog,"Войти","Отмена");
		}
		else//иначе:
		{
			format(connect, sizeof(connect), "SELECT * FROM Players WHERE (Name = '%s')", playrname);//создаём запрос БД
			querydb[playerid] = db_query(playerdb, connect);//отправляем запрос БД
			if(db_num_rows(querydb[playerid]) == 0)//переведём результат запроса в число найденных строк в БД
			{//если число строк = 0 (такого аккаунта в БД нет), то - регистрация аккаунта
    			gPlayerAccount[playerid] = 0;
			    ShowPlayerDialog(playerid,0,DIALOG_STYLE_PASSWORD,"{00C8E7}Регистрация",regdialog,"Войти","Отмена");
				db_free_result(querydb[playerid]);//очищаем результат запроса БД
			}
			else//иначе - вход в аккаунт
			{
    			gPlayerAccount[playerid] = 1;
 				ShowPlayerDialog(playerid,1,DIALOG_STYLE_PASSWORD,"{00C8E7}Авторизация",logdialog,"Войти","Отмена");
				db_free_result(querydb[playerid]);//очищаем результат запроса БД
 			}
 		}
#endif
	}
	else//иначе:
	{
		SendClientMessage(playerid,0xA9C4E4FF,"{FFFFFF}Для выхода напишите {FFA344}/q. {FFFFFF}Заходите, мы вам всегда рады.");
	}
	return 1;
}


public OnPlayerDisconnect(playerid, reason)
{
    DZ_PlayerEpoch[playerid]++; // Cancel pending asynchronous actions on old player ID.
    DZ_MinerSession[playerid]++; // invalidate old timers before account cleanup
    PlayerStartJob[playerid] = false;
    PlayerOnJob[playerid] = false;
	new pname[MAX_PLAYER_NAME];
 	GetPlayerName(playerid, pname, sizeof(pname));
if(gPlayerLogged[playerid] == 1) strmid(ExitInfo[playerid][ExitName],pname, 0, strlen(pname), 32), ExitInfo[playerid][ExitTime] = GetTickCount();
        playerworking[playerid] = 0;
        TextDrawHideForPlayer(playerid,ServerTextDrawTwo);
    TextDrawHideForPlayer(playerid,ServerTextDrawThree[playerid]);
        TextDrawHideForPlayer(playerid,ServerTextDrawFour[playerid]);
        TextDrawHideForPlayer(playerid,ServerTextDrawFive[playerid]);
        TextDrawSetString(ServerTextDrawThree[playerid]," ");
        TextDrawSetString(ServerTextDrawFour[playerid]," ");
        TextDrawSetString(ServerTextDrawFive[playerid]," ");
        PlayerMoney[playerid] = 0;
        PlayerPositionX[playerid] = 0.0;
        PlayerPositionY[playerid] = 0.0;
        PlayerPositionZ[playerid] = 0.0;
        if(PlayerInfo[playerid][pVIP] == 0) PlayerCombo[playerid] = 1;
        if(PlayerInfo[playerid][pVIP] == 1) PlayerCombo[playerid] = 2;
        if(PlayerInfo[playerid][pVIP] == 2) PlayerCombo[playerid] = 4;
        if(PlayerInfo[playerid][pVIP] == 3) PlayerCombo[playerid] = 6;
        KillTimer(PlayerTimerOne[playerid]);
	SetPVarInt(playerid, "Music", 0);
	Intropic[playerid] = 0;
	Watching[playerid] = 0;
	Goto[playerid] = 0;
//Грузчик
	PlayerInJob[playerid] = 0;
	Meshok[playerid] = 0;
    Meshki[playerid] = 0;
    Oldskin2[playerid] = 0;

//==============================================================================
//                              GarHouse
//==============================================================================

	if(GetPVarInt(playerid, "HousePrevTime") != 0)
	{//если игрок осматривает интерьер, то вернуть старый интерьер
	    SetPVarInt(playerid, "HousePreview", 0);
	    KillTimer(GetPVarInt(playerid, "HousePrevTimer"));
	    SetPVarInt(playerid, "IsHouseVisiting", 0);
		SetPVarInt(playerid, "HousePrevTime", 0);
		new file555[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP");
		format(file555, sizeof(file555), FILEPATH, h);
        if(h >= 0 && h < MAX_HOUSES && dini_Exists(file555))
        {
	    dini_IntSet(file555, "HouseInterior", GetPVarInt(playerid, "OldHouseInt"));

		#if defined GH_DEBUGGING
			printf(DEBUG_ODR5, h, GetPVarInt(playerid, "OldHouseInt"));
		#endif

  		DestroyHouseEntrance(h, TYPE_INT);
		CreateCorrectHouseExitCP(h);
		Loop(i, MAX_PLAYERS)
		{
  			if(GetPVarInt(i, "LastHouseCP") == h && GetPVarInt(i, "IsInHouse") == 1)
  			{
				SetPlayerHouseInterior(i, h);
			}
		}
//		#if defined GH_DEBUGGING
//			printf(DEBUG_ODR5, h, GetPVarInt(playerid, "HousePrevInt"));
//		#endif
        }
	}

	new file[HOUSEFILE_LENGTH];
    new lastHouse = GetPVarInt(playerid, "LastHouseCP");
	format(file, sizeof(file), FILEPATH, lastHouse);
    if(lastHouse >= 0 && lastHouse < MAX_HOUSES && dini_Exists(file) &&
       GetPVarInt(playerid, "IsInHouse") == 1 &&
       !strcmp(GetHouseOwner(lastHouse), pNick(playerid), CASE_SENSETIVE))
	{
	    dini_IntSet(file, "QuitInHouse", 1);
	    #if defined GH_HOUSECARS
	    	SaveHouseCar(GetPVarInt(playerid, "LastHouseCP"));
	    	UnloadHouseCar(GetPVarInt(playerid, "LastHouseCP"));
        #endif
	    #if defined GH_DEBUGGING
	    	printf(DEBUG_OP_DISCONNECT, pNick(playerid), playerid);
    	#endif
	}
//==============================================================================
//                              End GarHouse
//==============================================================================

	SendDeathMessage(INVALID_PLAYER_ID, playerid, 201);//отобразить иконку дисконнекта в килл-чате
	TextDrawHideForPlayer(playerid, Text:Times);//выключить часы игроку
    new string[256];
	GetPlayerName(playerid,pname,sizeof(pname));
    if(mapiconid[playerid] != -600)//если ID мап иконки наблюдения НЕ пустой, то:
    {
		DestroyDynamicMapIcon(mapiconid[playerid]);//удаление мап иконки наблюдения
	}
	mapiconid[playerid] = -600;//очистка ID мап иконки наблюдения
	OnPlayerSaveA(playerid);//сохраняем аккаунт игрока
    if(exitcheat[playerid] == 0)//если игрок - НЕ чит, то:
    {
    	if(PlayerInfo[playerid][pDeport] == 1)
    	{
        	format(string, sizeof(string), "•.:DRAZVIO:.• | Игрок %s [%d] вышел с сервера со статусом депортации.",pname,playerid);
			print(string);
			SendClientMessageToAll(COLOR_YELLOW, string);
		}
    	if(PlayerInfo[playerid][pPrisonsec] > 0)
    	{
        	format(string, sizeof(string), "•.:DRAZVIO:.• | Игрок %s [%d] вышел с сервера с %d секундами тюрьмы.",pname,playerid,PlayerInfo[playerid][pPrisonsec]);
			print(string);
			SendClientMessageToAll(COLOR_YELLOW, string);
		}
    	if(PlayerInfo[playerid][pMutedsec] > 0)
    	{
        	format(string, sizeof(string), "•.:DRAZVIO:.• | Игрок %s [%d] вышел с сервера с %d секундами бана чата.",pname,playerid,PlayerInfo[playerid][pMutedsec]);
			print(string);
			SendClientMessageToAll(COLOR_YELLOW, string);
		}
	}
	exitcheat[playerid] = 0;//обнуляем переменную чита
	switch(reason)
	{
		case 0: printf("* Игрок %s [%d] вышел с сервера (вылет) .", pname, playerid);
		case 1: printf("* Игрок %s [%d] вышел с сервера (вышел) .",pname, playerid);
		case 2: printf("* Игрок %s [%d] вышел с сервера (кик/бан) .",pname, playerid);
	}

	R_Vehicle[playerid] = VehicleSpeed_1;//speedometer

//------------------------------ BusSystem -------------------------------------
	playspabs[playerid] = 0;//игрок не заспавнился
	for(new j; j < BUS_MAX; j++)//цикл для всех бизнесов
	{
		if(buscount[j] == 1 && strcmp(RealName[playerid], busplayname[j], false) == 0)//если бизнес существует,
		{//и это бизнес игрока, то:
			busidplay[j] = -600;//даём бизнесу несуществующий ИД игрока
			busmoney[j] = 0;//обнуляем счётчик минут бизнеса
		}
	}
//---------------------------- End BusSystem -----------------------------------

	scrmod[0][playerid] = 0;//переменная режимов экрана
	scrmod[1][playerid] = 0;//переменная режимов экрана
	scrmod[2][playerid] = 0;//переменная режимов экрана
	if(scrmod[3][playerid] == 1)
	{
		Level3D[playerid] = Create3DTextLabel(" ",0xFFFFFFAA,0.000,0.000,-4.000,18.0,0,1);
		LevelStats[playerid] = 0;
	}
	scrmod[3][playerid] = 0;//переменная режимов экрана
	scrmod[4][playerid] = 0;//переменная режимов экрана
	scrmod[5][playerid] = 0;//переменная режимов экрана
	compdrift[playerid] = -1000000;//отключение от дрифт-соревнования
	ClearAnimations(playerid);//остановить анимацию
    perfrost[playerid] = 600;//отключение заморозки
	TogglePlayerControllable(playerid, 1);//разморозить ид вышедшего игрока
	DestroyObject(neon[playerid][0]);//убрать неон
	DestroyObject(neon[playerid][1]);//убрать неон
	neon[playerid][0] = 0;//присваиваем неону несуществующий номер объекта
	neon[playerid][1] = 0;//присваиваем неону несуществующий номер объекта
	neon[playerid][2] = 0;//несуществующий ид транспорта с неоном
	if(playcar[playerid] != 0)//если у игрока есть свой транспорт, то:
	{
		for(new i=0;i<MAX_PLAYERS;i++)//поиск и удаление чужого неона
		{
			if(playcar[playerid] == neon[i][2])
			{
				DestroyObject(neon[i][0]);//убрать неон
				DestroyObject(neon[i][1]);//убрать неон
				neon[i][0] = 0;//присваиваем неону несуществующий номер объекта
				neon[i][1] = 0;//присваиваем неону несуществующий номер объекта
				neon[i][2] = 0;//несуществующий ид транспорта с неоном
 			}
		}
		DestroyVehicle(playcar[playerid]);//уничтожить свой транспорт
		playcar[playerid] = 0;//несуществующий ид транспорта
	}

	NRadio[playerid] = 0;//задаём игроку несуществующий номер подключенного радио//Радио
	StopAudioStreamForPlayer(playerid);//отключим любой поток

	SetPlayerFightingStyle(playerid, FIGHT_STYLE_NORMAL);//установить нормальный стиль боя
	gPlayerLogged[playerid] = 0;//запретить запись аккаунта
	playspa[playerid] = 0;//переменная спавна игрока
	countdown[playerid] = -1;//очистка обратного отсчёта
	oneminkick[playerid] = 0;//кик - если не заспавнился
	passrcon[playerid] = 0;//бан взлома RCON-пароля
	prisoncount[playerid] = 0;//задержка контроля игрока в тюрьме
	DeletePVar(playerid, "AdmLvl");//удаляем глобальную переменную уровня админки
	DeletePVar(playerid, "SecPris");//удаляем глобальную переменную секунд тюрьмы
	DeletePVar(playerid, "PlSkin");//удаляем глобальную переменную скина игрока
	DeletePVar(playerid, "PlMon");//удаляем глобальную переменную денег игрока
	DeletePVar(playerid, "PlGng");//удаляем глобальную переменную ID банды игрока
	strdel(RealName[playerid],0,MAX_PLAYER_NAME);//очистить реальный ник игрока
	dialogadm[playerid] = 0;//обнуляем контрольную переменную админ-меню
	dialogcon[playerid] = 0;//обнуляем контрольную переменную диалогов
	functioncon[playerid] = 0;//обнуляем контрольную переменную функций
	chatcon[playerid] = 0;//обнуляем контрольную переменную чата
	strdel(fbanreason[playerid], 0, 256);//очистка причины бана
	LockSpawn[playerid] = 0;//разблокировать заполнение слотов оружия и предметов
	NETafkPl[playerid][1] = 0;//обнулить время AFK
	NETrecPl[playerid] = 0;//обнулить контроль сети
	NETsenPl[playerid] = 0;
	PlayLock1[0][playerid] = 600;//отключить блокировку игрока
	LocTime[playerid] = GlTime;//передать общее время в локальное
	StopHeal[playerid] = 0;//переменная задержки команды /heal
	StopReport[playerid] = 0;//переменная задержки команды /report
	PlayCRTP[playerid] = 1;//блокировка контроля координат
	PlayCRSH[playerid] = 0;//обнулить блокировку спидхака
	DeletePVar(playerid, "MnMode");//удаляем глобальную переменную режима меню
	DerbyID[playerid] = 0;//обнулить дерби-режим
	LevelStats[playerid] = 0;//drift bonus
#if (MOD90INS == 1)
	migration[playerid] = 0;//обнулить режим миграции аккаунта
#endif
	if(SnowONOFF[playerid] == 1)//если на сервере ядерный взрыв, то:
	{//удаляем объект снега
		DestroyPlayerObject(playerid,snowobj[playerid]);
		SnowONOFF[playerid] = 0;
	}
	strdel(twoIP[playerid],0,126);//запоминаем IP вышедшего игрока на 100 миллисекунд
	strcat(twoIP[playerid],PlayerInfo[playerid][pIPAdr]);
	SetTimerEx("DZ_Guard_ClearIP", 100, 0, "ii", playerid, DZ_EpochAt(playerid));
	OutOut(playerid);//задержка, на время записи аккаунта банды
 return 1;
}

forward OutOut(playerid);
public OutOut(playerid)
{
	if(idgangsave[playerid] > 0)//если ID банды для записи - активен, то:
	{
		idgangsave[playerid] = 0;//очистка ID банды для записи
		locper3[playerid] = 0;
		while(locper3[playerid] < MAX_PLAYERS)//цикл для всех игроков
		{
			if(PGang[playerid] > 0 && PGang[playerid] == PGang[locper3[playerid]] && playerid != locper3[playerid])
			{//если есть хотя бы один игрок из банды выходящего, то:
				idgangsave[locper3[playerid]] = PGang[playerid];
				break;
			}
			locper3[playerid]++;
		}
	}
	idgangsave[playerid] = 0;//очистка ID банды для записи

	PGang[playerid] = 0;//Gangs system
	GangLvl[playerid] = 0;
	return 1;
}

public SendAdminMessage(color, string[])
{
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(PlayerInfo[i][pAdmin] >= 1)
		    {
				SendClientMessage(i, color, string);
			}
		}
	}
	return 1;
}

public SendSinMessage(color, string[])
{
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i))
		{
		    if(PlayerInfo[i][pFragSlvl] >= 1)
		    {
				SendClientMessage(i, color, string);
			}
		}
	}
	return 1;
}

