			{
				SetWeather(19);
				GlWeat = 19;
				SetWorldTime(0);
				GlTime = 0;
				TimePlay(0);
				new Float:sx,Float:sy,Float:sz;
				for(new i = 0; i < MAX_PLAYERS; i++)
				{
					if(IsPlayerConnected(i))
					{
						SnowONOFF[i] = 1;
						SetPlayerHealth(i,0);
						GetPlayerCameraPos(i,sx,sy,sz);
						snowobj[i] = CreatePlayerObject(i,18864, sx, sy, sz-5, 0.0, 0.0, 0.0, 300.0);
					}
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(string, sizeof(string), " *** Администратор %s произвёл ядерный взрыв !!!", sendername);
				print(string);
				SendClientMessageToAll(COLOR_RED, string);
				nucexplos = 1;
			}
			else
			{
				SetWeather(1);
				GlWeat = 1;
				if(timecor[8] == 1)//если включено реальное время, то:
				{
					ReadCorTime();//чтение коррекции времени
					gettime(timecor[0], timecor[1]);
					TimCor();//коррекция времени
					SetWorldTime(timecor[0]);
					GlTime = timecor[0];
					TimePlay(timecor[0]);
				}
				else
				{
					SetWorldTime(12);
					GlTime = 12;
					TimePlay(12);
				}
				for(new i = 0; i < MAX_PLAYERS; i++)
				{
					if(IsPlayerConnected(i))
					{
						SnowONOFF[i] = 0;
						DestroyPlayerObject(i,snowobj[i]);
					}
				}
				GetPlayerName(playerid, sendername, sizeof(sendername));
				format(string, sizeof(string), " *** Администратор %s ликвидировал последствия ядерного взрыва.", sendername);
				print(string);
				SendClientMessageToAll(COLOR_GREEN, string);
				nucexplos = 0;
			}
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, " У Вас нет прав на использование этой команды !");
		}
		return 1;
	}
