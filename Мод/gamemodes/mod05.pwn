//			printf("[GangsSystem] %s [%d] сменил название команды на %s.", pname, playerid, GName[PGang[playerid]]);
			GangSave(PGang[playerid]);//запись ID команды в файл
	    }
		else
		{
			ShowPlayerDialog(playerid, 1001, DIALOG_STYLE_LIST, "Система команд", "Создать команду\nУдалить команду\nНазначить скины\nНазначить место спавна\
			\nОтменить спавн команды\nНазначить уровень\nПригласить в команду\nВыгнать из команды\nОткл. / вкл. разрешение приглашать Вас в команду\
