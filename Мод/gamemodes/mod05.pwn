	if(strcmp(cmd, "/cord", true) == 0)
	{
		if (PlayerInfo[playerid][pAdmin] >= 1)
		{
			new cord[256], Float:x, Float:y, Float:z, Float:Angle;
			GetPlayerPos(playerid, x, y, z);
			GetPlayerFacingAngle(playerid, Angle);
			format(cord, sizeof(cord), "x = %f   y = %f   z = %f   поворот = %f   интерьер = %d   виртуальный мир = %d",
			x, y, z, Angle, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
			SendClientMessage(playerid, COLOR_WHITE, cord);
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, " У Вас нет прав на использование этой команды !");
		}
		return 1;
	}
    if(strcmp(cmd, "/givemoney", true) == 0)
	{
    	if(PlayerInfo[playerid][pDeport] == 1)
    	{
			SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FF0000}Ваш личный счёт заморожен, пока дело о Вашей депортации на слушании !");
			return 1;
		}
		tmp = strtok(cmdtext, idx);
		if(!strlen(tmp))
		{
			SendClientMessage(playerid, COLOR_GRAD2, " Используйте: /givemoney [ид игрока] [сумма]");
			return 1;
		}
		new playset;
		playset = strval(tmp);
		if(playset == playerid)
		{
			SendClientMessage(playerid, COLOR_RED, " Вы не можете передать деньги самому себе !");
			return 1;
		}
		if(IsPlayerConnected(playset))
		{
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
			{
				SendClientMessage(playerid, COLOR_RED, " Вы не указали сумму !");
				return 1;
			}
			new money;
			money = strval(tmp);
			if(money < 0) { SendClientMessage(playerid, COLOR_RED, " Сумма не может быть отрицательным числом !"); return 1; }
			if(GetPVarInt(playerid, "PlMon") < money) { SendClientMessage(playerid, COLOR_RED, " У Вас нет такой суммы."); return 1; }
			SetPVarInt(playerid, "PlMon", GetPVarInt(playerid, "PlMon") - money);
			SetPVarInt(playset, "PlMon", GetPVarInt(playset, "PlMon") + money);
			new soob[256];
			GetPlayerName(playerid, sendername, sizeof(sendername));
			GetPlayerName(playset, giveplayer, sizeof(giveplayer));
			format(soob, sizeof(soob), " Игрок %s [%d] передал игроку %s [%d] %d $", sendername, playerid, giveplayer, playset, money);
			print(soob);
			SendAdminMessage(0xF4C330FF, soob);
			if (PlayerInfo[playerid][pAdmin] == 0)
			{
				format(soob, sizeof(soob), " Вы передали игроку %s [%d] %d $", giveplayer, playset, money);
				SendClientMessage(playerid, 0xF4C330FF, soob);
			}
			if (PlayerInfo[playset][pAdmin] == 0)
			{
				format(soob, sizeof(soob), " Игрок %s [%d] передал Вам %d $", sendername, playerid, money);
				SendClientMessage(playset, 0xF4C330FF, soob);
			}
		}
