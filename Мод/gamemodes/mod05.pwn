public LoadGangAcc(playerid)
{
    new f[256];
    format(f, 256, "gangs/players/%s.ini", PlayNam(playerid));
	new file = ini_openFile(f);
	if(file == INI_OK)
	{
	    ini_getInteger(file, "Gang", PGang[playerid]);
	    ini_getInteger(file, "GangLvl", GangLvl[playerid]);
		ini_closeFile(file);
	}
	if(fexist(f))
	{
		fremove(f);
	}
	return true;
}
