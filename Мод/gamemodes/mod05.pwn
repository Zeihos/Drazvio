//------------------------------------------------------------------------------
//                               Money Storage
//------------------------------------------------------------------------------
	if(dialogid == 510 && response)
	{
        if(!DZ_HouseOwnerAccess(playerid)) return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: нет прав на этот дом.");
		new string[384], file[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP"); // Don't complain about huge size, just change it if you need.
    	format(file, sizeof(file), FILEPATH, h);
	    new tmp = dini_Int(file, "HouseStorage");
    	if(listitem == 0) // Deposit
	   	{
     		format(string, sizeof(string), I_HINT_DEPOSIT1, tmp);
  			ShowPlayerDialog(playerid, 511, DIALOG_STYLE_INPUT, "Хранение денег: положить на хранение", string, "Положить", "Отмена");
	    }
	    if(listitem == 1) // Withdraw
	    {
     		format(string, sizeof(string), I_HINT_WITHDRAW1, tmp);
       		ShowPlayerDialog(playerid, 512, DIALOG_STYLE_INPUT, "Хранение денег: снять с хранения", string, "Снять", "Отмена");
    	}
	    if(listitem == 2) // Check Balance
	    {
     		ShowInfoBox(playerid, INFORMATION_HEADER, I_HINT_CHECKBALANCE, tmp);
            #if defined GH_DEBUGGING
				printf(DEBUG_ODR6, pNick(playerid), playerid, h, tmp);
			#endif
		}
		return 1;
	}
//------------------------------------------------------------------------------
	if(dialogid == 511 && response)
	{
        if(!DZ_HouseOwnerAccess(playerid)) return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: нет прав на этот дом.");
		if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1) return SendClientMessage(playerid, COLOUR_SYSTEM, "Сумма содержит недопустимые символы (знак процентов или ~).");
		new file[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP"); // Don't complain about huge size, just change it if you need.
    	format(file, sizeof(file), FILEPATH, h);
	    new amount = DZ_AmountFromInput(inputtext);
//		format(file, sizeof(file), FILEPATH, h);
		if(amount > GetPVarInt(playerid, "PlMon")) return SendClientMessage(playerid, COLOUR_SYSTEM, E_NOT_ENOUGH_PMONEY);
		if(amount < 1) return SendClientMessage(playerid, COLOUR_SYSTEM, E_INVALID_AMOUNT);
		if(dini_Int(file, "HouseStorage") < 0 || dini_Int(file, "HouseStorage") >= 25000000 || amount >= 25000000 - dini_Int(file, "HouseStorage")) return SendClientMessage(playerid, COLOUR_SYSTEM, E_HSTORAGE_L_REACHED);
		else
		{
            new dz_storage_new = dini_Int(file, "HouseStorage") + amount;
            dini_IntSet(file, "HouseStorage", dz_storage_new);
            if(dini_Int(file, "HouseStorage") != dz_storage_new)
                return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: ошибка сохранения хранилища, баланс не изменён.");
			SetPVarInt(playerid, "PlMon", GetPVarInt(playerid, "PlMon") - amount);
			ShowInfoBox(playerid, INFORMATION_HEADER, I_HINT_DEPOSIT2, amount, dini_Int(file, "HouseStorage"));
            #if defined GH_DEBUGGING
				printf(DEBUG_ODR7, pNick(playerid), playerid, amount, h);
			#endif
		}
		return 1;
	}
//------------------------------------------------------------------------------
	if(dialogid == 512 && response)
	{
        if(!DZ_HouseOwnerAccess(playerid)) return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: нет прав на этот дом.");
		if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1) return SendClientMessage(playerid, COLOUR_SYSTEM, "Сумма содержит недопустимые символы (знак процентов или ~).");
		new file[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP"); // Don't complain about huge size, just change it if you need.
    	format(file, sizeof(file), FILEPATH, h);
	    new amount = DZ_AmountFromInput(inputtext);
//		format(file, sizeof(file), FILEPATH, h);
		if(amount > dini_Int(file, "HouseStorage")) return SendClientMessage(playerid, COLOUR_SYSTEM, E_NOT_ENOUGH_HSMONEY);
        if(GetPVarInt(playerid, "PlMon") < 0 || GetPVarInt(playerid, "PlMon") >= DZ_MAX_BALANCE || amount > DZ_MAX_BALANCE - GetPVarInt(playerid, "PlMon"))
            return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: недостаточно места на счёте для снятия суммы.");
		if(amount < 1) return SendClientMessage(playerid, COLOUR_SYSTEM, E_INVALID_AMOUNT);
		else
		{
            new dz_storage_new = dini_Int(file, "HouseStorage") - amount;
            dini_IntSet(file, "HouseStorage", dz_storage_new);
            if(dini_Int(file, "HouseStorage") != dz_storage_new)
                return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: ошибка сохранения хранилища, баланс не изменён.");
			DZ_CreditMoney(playerid, amount);
			ShowInfoBox(playerid, INFORMATION_HEADER, I_HINT_WITHDRAW2, amount, dini_Int(file, "HouseStorage"));
            #if defined GH_DEBUGGING
				printf(DEBUG_ODR8, pNick(playerid), playerid, amount, h);
			#endif
		}
		return 1;
	}
//------------------------------------------------------------------------------
//                          House Storage
//------------------------------------------------------------------------------
	if(dialogid == 518 && response)
	{
        if(!DZ_HouseOwnerAccess(playerid)) return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: нет прав на этот дом.");
		switch(listitem)
		{
		    case 0: ShowPlayerDialog(playerid, 510, DIALOG_STYLE_LIST, "Хранение денег", "Положить на хранение\nСнять с хранения\nПроверить сумму", "OK", "Отмена");
		    case 1: ShowPlayerDialog(playerid, 519, DIALOG_STYLE_LIST, "Хренение оружия", "Положить на хранение\nСнять с хранения", "OK", "Отмена");
		}
		return 1;
	}
//------------------------------------------------------------------------------
//                          Weapon Storage
//------------------------------------------------------------------------------
	if(dialogid == 519 && response)
	{
        if(!DZ_HouseOwnerAccess(playerid)) return SendClientMessage(playerid, COLOUR_SYSTEM, "DRAZVIO: нет прав на этот дом.");
	    new WeaponData[13][2], tmp[9], tmp2[13], tmpcount;
		switch(listitem)
		{
		    case 0: // Store weapons
		    {
				new file[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP"); // Don't complain about huge size, just change it if you need.
    			format(file, sizeof(file), FILEPATH, h);
				Loop(weap, 13)
				{
				    format(tmp, sizeof(tmp), "Weapon%d", weap);
  					format(tmp2, sizeof(tmp2), "Weapon%dAmmo", weap);
				    if(weap == 0) continue;
				    #if !defined GH_SAVE_ADMINWEPS
				    if(weap == 7 || weap == 8 || weap == 9 || weap == 12) continue;
				    #endif
				    GetPlayerWeaponData(playerid, weap, WeaponData[weap][0], WeaponData[weap][1]);
				    if(WeaponData[weap][1] == 0 || (weap == 11 && WeaponData[weap][0] != 46)) continue;
					dini_IntSet(file, tmp, WeaponData[weap][0]);
					dini_IntSet(file, tmp2, WeaponData[weap][1]);
					GivePlayerWeapon(playerid, WeaponData[weap][0], -WeaponData[weap][1]);
					tmpcount++;
				}
				if(tmpcount >= 1)
				{
					ShowInfoBox(playerid, INFORMATION_HEADER, I_HS_WEAPONS1, tmpcount, AddS(tmpcount));
				}
				if(tmpcount == 0)
				{
					ShowInfoBox(playerid, INFORMATION_HEADER, E_NO_WEAPONS, tmpcount);
				}
	            #if defined GH_DEBUGGING

					printf(DEBUG_ODR10, pNick(playerid), playerid, tmpcount, h);

//					printf(DEBUG_ODR10, pNick(playerid), playerid, tmpcount, AddS(tmpcount), h);
				#endif
			}
			case 1: // Recieve Weapons
			{
				new file[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP"); // Don't complain about huge size, just change it if you need.
    			format(file, sizeof(file), FILEPATH, h);
				Loop(weap, 13)
				{
				    format(tmp, sizeof(tmp), "Weapon%d", weap);
  					format(tmp2, sizeof(tmp2), "Weapon%dAmmo", weap);
  					if(dini_Int(file, tmp2) == 0) continue;
				    if(weap == 0) continue;
				    #if !defined GH_SAVE_ADMINWEPS
				    if(weap == 7 || weap == 8 || weap == 9 || weap == 11 || weap == 12) continue;
				    #endif
					GivePlayerWeapon(playerid, dini_Int(file, tmp), dini_Int(file, tmp2));
					dini_IntSet(file, tmp, 0);
					dini_IntSet(file, tmp2, 0);
					tmpcount++;
				}
				if(tmpcount >= 1)
				{
					ShowInfoBox(playerid, INFORMATION_HEADER, I_HS_WEAPONS2, tmpcount, AddS(tmpcount));
				}
				if(tmpcount == 0)
				{
					ShowInfoBox(playerid, INFORMATION_HEADER, E_NO_HS_WEAPONS, tmpcount); // I had to add tmpcount or it gave an error ^_^
				}
				#if defined GH_DEBUGGING

					printf(DEBUG_ODR11, pNick(playerid), playerid, tmpcount, h);

//					printf(DEBUG_ODR11, pNick(playerid), playerid, tmpcount, AddS(tmpcount), h);
				#endif
			}
		}
		return 1;
	}
//------------------------------------------------------------------------------
//                          Enter House Using Password
//------------------------------------------------------------------------------
	if(dialogid == 521)
	{
        new dz_pass_house = GetPVarInt(playerid, "LastHouseCP");
        new dz_pass_house_file[HOUSEFILE_LENGTH];
        if(!gPlayerLogged[playerid] || dz_pass_house < 0 || dz_pass_house >= MAX_HOUSES) return 1;
        format(dz_pass_house_file, sizeof(dz_pass_house_file), FILEPATH, dz_pass_house);
        if(!dini_Exists(dz_pass_house_file)) return 1;

		lockpas[playerid] = 0;//разблокировать диалог ввода пароля

		new file[HOUSEFILE_LENGTH], h = GetPVarInt(playerid, "LastHouseCP"); // Don't complain about huge size, just change it if you need.
		format(file, sizeof(file), FILEPATH, h);
		if(response)
		{
//		    format(file, sizeof(file), FILEPATH, h);
		    if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1) return SendClientMessage(playerid, COLOUR_SYSTEM, E_INVALID_HPASS_CHARS2);
		    if(strlen(inputtext) < MIN_HOUSE_PASSWORD || strlen(inputtext) > MAX_HOUSE_PASSWORD) return SendClientMessage(playerid, COLOUR_SYSTEM, E_INVALID_HPASS_LENGTH);
			if (!DZ_HouseVerifyPassword(file, inputtext)) // проверка хеша или старого пароля
//			if(udb_hash(inputtext) != dini_Int(file, "HousePassword"))
			{
				ShowInfoBox(playerid, INFORMATION_HEADER, I_WRONG_HPASS1, GetHouseOwner(GetPVarInt(playerid, "LastHouseCP")), "********");
				if(IsPlayerConnected(GetHouseOwnerEx(GetPVarInt(playerid, "LastHouseCP"))))
				{
					SendMSG(GetHouseOwnerEx(h), COLOUR_INFO, 128, I_WRONG_HPASS2, pNick(playerid), playerid, "********");
    			}
			}
			else
			{
				ShowInfoBox(playerid, INFORMATION_HEADER, I_CORRECT_HPASS1, GetHouseOwner(GetPVarInt(playerid, "LastHouseCP")), "********");
				SetPVarInt(playerid, "IsInHouse", 1);
				SetPlayerHouseInterior(playerid, GetPVarInt(playerid, "LastHouseCP"));
				if(IsPlayerConnected(GetHouseOwnerEx(GetPVarInt(playerid, "LastHouseCP"))))
				{
					SendMSG(GetHouseOwnerEx(h), COLOUR_INFO, 128, I_CORRECT_HPASS2, pNick(playerid), playerid, "********");
				}
				#if defined GH_DEBUGGING
					printf(DEBUG_ODR12, pNick(playerid), playerid, h);
				#endif
			}
		}
		return 1;
	}
//==============================================================================
//                              End GarHouse
//==============================================================================

    if(dialogid == 0)
	{
 		if(!response)
		{
			SendClientMessage(playerid, COLOR_RED, "DRAZVIO: Авторизация отменена.");
            SetTimerEx("DZ_Guard_PlayKick", 300, false, "ii", playerid, DZ_EpochAt(playerid));
            return 1;
		}
		else
		{
 			if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1)
