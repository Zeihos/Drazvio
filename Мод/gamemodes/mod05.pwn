//==============================================================================
// DRAZVIO: сохранение паролей в формате SHA256$<32 hex salt>$<64 hex hash>.
// Совместимость: старые текстовые пароли преобразуются после успешного входа.
// Примечание: SHA-256 является промежуточной защитой; для публичного сервера
// рекомендуется bcrypt/Argon2id с отдельным проверенным плагином.
//==============================================================================
stock DZ_SetPassword(playerid, password[])
{
    new salt[33], digest[65];
    format(salt, sizeof(salt), "%08x%08x%08x%08x", random(2147483647), random(2147483647), random(2147483647), random(2147483647));
    SHA256_PassHash(password, salt, digest, sizeof(digest));
    if (strlen(digest) != 64) return 0;
    format(PlayerInfo[playerid][pKey], 128, "SHA256$%s$%s", salt, digest);
    return 1;
}
stock DZ_IsHexText(const text[], length)
{
    if(strlen(text) != length) return 0;
    for(new i = 0; i < length; i++)
    {
        if(!((text[i] >= '0' && text[i] <= '9') || (text[i] >= 'a' && text[i] <= 'f') || (text[i] >= 'A' && text[i] <= 'F'))) return 0;
    }
    return 1;
}

stock DZ_VerifyPassword(playerid, password[])
{
    new salt[33], digest[65], expected[65];
    if (strfind(PlayerInfo[playerid][pKey], "SHA256$", true) == 0)
    {
        if (strlen(PlayerInfo[playerid][pKey]) != 104) return 0;
        strmid(salt, PlayerInfo[playerid][pKey], 7, 39, sizeof(salt));
        strmid(expected, PlayerInfo[playerid][pKey], 40, 104, sizeof(expected));
        if(!DZ_IsHexText(salt, 32) || !DZ_IsHexText(expected, 64)) return 0;
        SHA256_PassHash(password, salt, digest, sizeof(digest));
        return strcmp(digest, expected, false) == 0;
    }
    // Поддержка миграции старого аккаунта из LeimaN.
    if (strcmp(PlayerInfo[playerid][pKey], password, false) != 0) return 0;
    return DZ_SetPassword(playerid, password);
}


// DRAZVIO: bounded loader for Key= field (strips CR/LF without touching the digest).
stock DZ_LoadPasswordKey(playerid, const value[])
{
    new len = strlen(value);
    while (len > 0 && (value[len - 1] == 10 || value[len - 1] == 13)) len--;
    PlayerInfo[playerid][pKey][0] = EOS;
    if (len < 1 || len >= 128) return 0;
    strmid(PlayerInfo[playerid][pKey], value, 0, len, 128);
    return 1;
}


// Verify persisted dini values using a fresh file read. A failed write must never
// be reported as a successful password change.
stock DZ_FileHasValue(file[], key[], value[])
{
    if(!dini_Exists(file)) return 0;
    return strcmp(dini_Get(file, key), value, false) == 0;
}

// Stage 8: verify the complete account snapshot BEFORE publishing it.
// Unlike Key/Money-only checks, this also catches truncation after Money=.
// Stage 9: strict textual comparison; dini_Int silently accepts malformed numbers.
// Account writes always use format("%d"), so a different representation is corruption.
stock DZ_AccountIntEquals(file[], field[], expected_value)
{
    if(!dini_Isset(file, field)) return 0;
    new expected_text[16];
    format(expected_text, sizeof(expected_text), "%d", expected_value);
    return strcmp(dini_Get(file, field), expected_text, false) == 0;
}

stock DZ_AccountSnapshotValid(file[], playerid)
{
    if(!dini_Exists(file) || playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    if(!dini_Isset(file, "Key") || !DZ_FileHasValue(file, "Key", PlayerInfo[playerid][pKey])) return 0;
    if(!dini_Isset(file, "TDReg") || !DZ_FileHasValue(file, "TDReg", PlayerInfo[playerid][pTDReg])) return 0;
    if(!dini_Isset(file, "IPAdr") || !DZ_FileHasValue(file, "IPAdr", PlayerInfo[playerid][pIPAdr])) return 0;
    if(!DZ_AccountIntEquals(file, "MinLog", PlayerInfo[playerid][pMinlog])) return 0;
    if(!DZ_AccountIntEquals(file, "AdminLevel", PlayerInfo[playerid][pAdmin])) return 0;
    if(!DZ_AccountIntEquals(file, "AdminShadow", PlayerInfo[playerid][pAdmshad])) return 0;
    if(!DZ_AccountIntEquals(file, "AdminLive", PlayerInfo[playerid][pAdmlive])) return 0;
    if(!DZ_AccountIntEquals(file, "AdminScanCom", PlayerInfo[playerid][pAdmscancom])) return 0;
    if(!DZ_AccountIntEquals(file, "Registered", PlayerInfo[playerid][pReg])) return 0;
