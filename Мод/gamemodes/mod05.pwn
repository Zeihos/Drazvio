			format(s09, 256, "Gang = %d,GangLvl = %d ",data2[18],data2[19]);
			format(s10, 256, "WHERE (Name = '%s')",akk);
			format(s00, 2560, "%s%s%s%s%s%s%s%s%s%s", s01, s02, s03, s04, s05, s06, s07, s08, s09, s10);
			db_query(playerdb, s00);//отправляем запрос на обновление (перезапись) аккаунта в БД
