    if(!DZ_AccountIntEquals(file, "DZ_Ach7", PlayerInfo[playerid][pDostigggggggg])) return 0;
    return 1;
}

// House access password: supports old plaintext files and migrates on successful login.
stock DZ_HouseSetPassword(file[], password[])
{
    new salt[33], digest[65], stored[105];
    format(salt, sizeof(salt), "%08x%08x%08x%08x", random(2147483647), random(2147483647), random(2147483647), random(2147483647));
    SHA256_PassHash(password, salt, digest, sizeof(digest));
    if (strlen(digest) != 64) return 0;
    format(stored, sizeof(stored), "SHA256$%s$%s", salt, digest);
    dini_Set(file, "HousePassword", stored);
    return DZ_FileHasValue(file, "HousePassword", stored);
}
stock DZ_HouseVerifyPassword(file[], password[])
{
    new stored[128], salt[33], digest[65], expected[65];
    format(stored, sizeof(stored), "%s", dini_Get(file, "HousePassword"));
    if(!strlen(stored) || !strcmp(stored, "INVALID_HOUSE_PASSWORD", false)) return 0;
    if (strfind(stored, "SHA256$", true) == 0)
    {
        if (strlen(stored) != 104) return 0;
        strmid(salt, stored, 7, 39, sizeof(salt));
        strmid(expected, stored, 40, 104, sizeof(expected));
        if(!DZ_IsHexText(salt, 32) || !DZ_IsHexText(expected, 64)) return 0;
        SHA256_PassHash(password, salt, digest, sizeof(digest));
        return strcmp(digest, expected, false) == 0;
    }
    if (strcmp(stored, password, false) != 0) return 0;
    // Legacy plaintext must only be accepted if the upgrade is persisted.
    return DZ_HouseSetPassword(file, password);
}


