			new s01[256], s02[256], s03[256], s04[256], s05[256], s06[256], s07[256], s08[256], s09[256], s10[256];
			new s00[2560];//создаём запрос БД
			format(s01, 256, "UPDATE Players SET Key = '%s',TDReg = '%s',",igkey,tdreg);
			format(s02, 256, "DEndConD = %d,DEndConM = %d,DEndConY = %d,",dddata2[0],dddata2[1],dddata2[2]);
			format(s03, 256, "IPAdr = '%s',MinLog = %d,AdminLevel = %d,",adrip,data2[0],data2[1]);
