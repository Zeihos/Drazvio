					SendClientMessage(playerid, COLOR_LIGHTRED, " Внимание !!! IP-адрес обнаружен в бан-листе !");
				}

				return 1;
			}
			for(new i=0;i<MAX_PLAYERS;i++)//проверка аккаунта на On-Line
			{
   				if(IsPlayerConnected(i))
