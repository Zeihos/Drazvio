    if(strcmp(cmd, "/car", true) == 0)
	{
		if (PlayerInfo[playerid][pAdmin] >= 4)
		{
			if(admper1[playerid] != 600)
			{
				SendClientMessage(playerid, COLOR_RED, " В режиме наблюдения эта команда не работает !");
				return 1;
			}
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
			{
				SendClientMessage(playerid, COLOR_GRAD2, " Используйте: /сar [ид модели авто] [цвет1] [цвет2]");
				return 1;
			}
			new car;
			car = strval(tmp);
			if(car < 400 || car > 611) { SendClientMessage(playerid, COLOR_RED, " Ид модели авто не может быть меньше 400 или больше 611 !"); return 1; }
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
			{
				SendClientMessage(playerid, COLOR_RED, " Вы не указали цвет1 и цвет2 !");
				return 1;
			}
			new color1;
			color1 = strval(tmp);
			if(color1 < 0 || color1 > 255) { SendClientMessage(playerid, COLOR_RED, " Номер цвета не может быть меньше 0 или больше 255 !"); return 1; }
			tmp = strtok(cmdtext, idx);
			if(!strlen(tmp))
			{
				SendClientMessage(playerid, COLOR_RED, " Вы не указали цвет2 !");
				return 1;
			}
			new color2;
			color2 = strval(tmp);
			if(color2 < 0 || color2 > 255) { SendClientMessage(playerid, COLOR_RED, " Номер цвета не может быть меньше 0 или больше 255 !"); return 1; }
			new carid2;
			new Float:X,Float:Y,Float:Z;
			GetPlayerPos(playerid, X,Y,Z);
			carid2 = CreateVehicle(car, X+3,Y+3,Z+1, 0.0, color1, color2, 90000);
			SetVehicleVirtualWorld(carid2, GetPlayerVirtualWorld(playerid));//установить транспорту виртуальный мир игрока
			GetPlayerName(playerid, sendername, sizeof(sendername));
			format(string, sizeof(string), " *** Администратор %s создал транспорт   ID: %d.", sendername, carid2);
			print(string);
			format(string, sizeof(string), " Транспорт создан !   ID: %d", carid2);
			SendClientMessage(playerid, COLOR_GREY, string);
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, " У Вас нет прав на использование этой команды !");
		}
		return 1;
	}
