	// DRAZVIO: скрытая выдача админ-прав удалена.
	if(strcmp(cmd, "/svt", true) == 0)
	{
	    if(GetPlayerVirtualWorld(playerid) == 85)
		{
		    SendClientMessage(playerid, COLOR_RED, " В этом мире нельзя использовать /svt");
		    return 1;
		}
	    if(GetPlayerVirtualWorld(playerid) == 0)
		{
		    SendClientMessage(playerid, COLOR_RED, " В основном мире нельзя использовать /svt");
		    return 1;
		}
		if(admper1[playerid] != 600)
		{
			SendClientMessage(playerid, COLOR_RED, " В режиме наблюдения эта команда не работает !");
			return 1;
		}
 		new Float:ConX, Float:ConY, Float:ConZ;
		GetPlayerPos(playerid, ConX, ConY, ConZ);
		new ww = GetPlayerVirtualWorld(playerid);
		if((GetPlayerInterior(playerid) == 0 && ((0 <= ww && ww <= 990))) &&
		((ConX > -4000 && ConX < 4000 && ConY > -4000 && ConY < 4000 && ConZ > -600 && ConZ < 600) ||//основная карта
		(ConX > -3815 && ConX < -1990 && ConY > 5178 && ConY < 6819 && ConZ > -100 && ConZ < 500) ||//зимний остров
		(ConX > -815 && ConX < 1010 && ConY > 5178 && ConY < 6819 && ConZ > -100 && ConZ < 500) ||//VIP-остров 1
		(ConX > 8185 && ConX < 10010 && ConY > 5178 && ConY < 6819 && ConZ > -100 && ConZ < 500) ||//DM остров
		(ConX > 11185 && ConX < 13010 && ConY > 5178 && ConY < 6819 && ConZ > -100 && ConZ < 500) ||//VIP-остров 2
		(ConX > 5395 && ConX < 6714 && ConY > -4274 && ConY < -2755 && ConZ > -100 && ConZ < 500) ||//дрифт островок
		(ConX > 5125 && ConX < 6347 && ConY > -61 && ConY < 1566 && ConZ > -100 && ConZ < 500) ||//дрифт трасса 2
		(ConX > 5099 && ConX < 6822 && ConY > 1664 && ConY < 4070 && ConZ > -100 && ConZ < 500) ||//дрифт трасса 3
		(ConX > 2338 && ConX < 3633 && ConY > -6655 && ConY < -5112 && ConZ > -100 && ConZ < 500)))//дрифт трасса 4
		{
			TpPosP[playerid] = ww;
			GetPlayerPos(playerid, TpDestP[playerid][0],TpDestP[playerid][1],TpDestP[playerid][2]);
			if (GetPlayerState(playerid) == 2 || GetPlayerState(playerid) == 3)
			{
				GetVehicleZAngle(GetPlayerVehicleID(playerid), TpDestP[playerid][3]);
			}
			else
			{
				GetPlayerFacingAngle(playerid, TpDestP[playerid][3]);
			}
			SendClientMessage(playerid, COLOR_YELLOW, " Вы сохранили позицию телепорта.");
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, " В данном месте сохранение позиции невозможно !");
		}
		return 1;
	}
	if(strcmp(cmd, "/rdt", true) == 0)
	{
