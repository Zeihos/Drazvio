				SendClientMessage(playerid, COLOR_GREEN, " Всем игрокам РАЗРЕШЕНО водить поезда !");
			}
			SendClientMessage(playerid, COLOR_LIGHTBLUE, "---------------------------------------------------------------");
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, " Такого [ид игрока] на сервере нет !");
		}
    	return 1;
