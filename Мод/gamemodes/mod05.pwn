		checkpo2[playerid] = 1;
		PlayerPlaySound(playerid, 1052, 0.0, 0.0, 0.0);
		SetPVarInt(playerid,"ZP",2);
		SetPlayerRaceCheckpoint(playerid,0,-2252.8325,-78.1630,34.7712,-2142.5322,-73.2336,34.7685,5.0);
		return 1;
