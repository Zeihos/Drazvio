			{
				tmp = strtok(cmdtext, idx);
				if(!strlen(tmp))
				{
					SendClientMessage(playerid, COLOR_GRAD2, " Используйте: /servcon 15 [лимит переданных байт(10000-500000)]");
					return 1;
				}
				new para2;
				para2 = strval(tmp);
				if(para2 < 10000 || para2 > 500000)
