public OnPlayerText(playerid, text[])
{
    if (!gPlayerLogged[playerid]) return 0;
	if(GetPVarInt(playerid, "ChatFlood") > gettime()) return SendClientMessage(playerid, COLOR_RED, "В чат можно писать раз в три секунды!") & 0;
	SetPVarInt(playerid, "ChatFlood", gettime() + 3);
	new word[256],Index;while(Index < strlen(text))
	{
		word = strtook(text,Index);
		if(Adv(word)==1||ZP(word)||U(word)||T(word)||N(word)||PP(word)||P(word)||V(word)||R(word)||PL(word)||ZV(word)||I(word)||ST(word)||PR(word)||DL(word)||RE(word)||VOC(word)||A(word)||NO(word)||TCZ(word)||BOP(word))
		{
			new i=strfind(text,word),j=i+strlen(word)-1; text[i++]='[';
			while(i<j) {text[i]='|';i++;}
			text[j]=']';
		}
 	}
    if(strval(text) == Viktorina)
	{
	new str[256],name[24],prize;
	GetPlayerName(playerid,name,sizeof name);
	prize = 100000;
	format(str,sizeof str,"{FFA500}Викторина: {ffffff}Игрок {FFA500}%s[id: %d]{ffffff} угадал! Ответ был: {FFA500}%d{ffffff}. Он получает: {00ff00}%d$",name,playerid,Viktorina,prize);
	SendClientMessageToAll(1,str);
	SetPVarInt(playerid, "PlMon", GetPVarInt(playerid, "PlMon") + prize);
	Viktorina = -5415614561541;
}
	#if !defined TOLOWER_IN_ANY_CASE
		if(IsTextUppercase(text))
		{
		#if defined TOLOWER_WITHOUT_CAP_LETTERS
			UpperToLowerWithoutCapLetters(text);
		#else
			UpperToLower(text);
		#endif
		}
	#elseif defined TOLOWER_WITHOUT_CAP_LETTERS
		UpperToLowerWithoutCapLetters(text);
	#else
		UpperToLower(text);
	#endif
	chatcon[playerid]++;//прибавляем 1 к контрольной переменной чата
	new string[1024];
	new sendername[MAX_PLAYER_NAME];
	GetPlayerName(playerid, sendername, sizeof(sendername));
	new aa333[64];//доработка для использования Русских ников
	format(aa333, sizeof(aa333), "%s", sendername);//доработка для использования Русских ников
	if(playspa[playerid] == 0)//игрок НЕ заспавнился
	{
		printf("-----[Игрок не заспавнился] %s [%d]: %s", aa333, playerid, text); // Отправляем сообщение в сервер-лог (доработка для использования Русских ников)
//		printf("-----[Игрок не заспавнился] %s [%d]: %s", sendername, playerid, text); // Отправляем сообщение в сервер-лог
		format(string, sizeof(string), "•.:DRAZVIO:.• | {FF0000} Вам запрещено писать сообщения в чат до спавна !", sendername, playerid);
		SendClientMessage(playerid, COLOR_YELLOW, string);
		return 0;
	}
	if(PlayerInfo[playerid][pDeport] == 1)
	{
		SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FF0000}Вы не можете говорить, пока дело о Вашей депортации на слушании !");
		SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FF0000}Все сообщения отправляйте в админ-чат ( /a [текст] ) !");
		printf("-----[Игрок на депортации] %s [%d]: %s", aa333, playerid, text); // Отправляем сообщение в сервер-лог (доработка для использования Русских ников)
//		printf("-----[Игрок на депортации] %s [%d]: %s", sendername, playerid, text); // Отправляем сообщение в сервер-лог
		return 0;
	}
	if(PlayerInfo[playerid][pMutedsec] > 0)
	{
		SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FF0000}Вы не можете писать, у вас бан чата !");
		printf("-----[У игрока бан чата] %s [%d]: %s", aa333, playerid, text); // Отправляем сообщение в сервер-лог (доработка для использования Русских ников)
//		printf("-----[У игрока бан чата] %s [%d]: %s", sendername, playerid, text); // Отправляем сообщение в сервер-лог
		return 0;
	}
	SetPlayerChatBubble(playerid, text, COLOR_WHITE, 15.0, 6000);
	if(PlayerInfo[playerid][pWanted] == 0)
	{
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 0 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s [%d]: {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 1 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s {FFFF00}[VIP-1] [%d]: {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 2 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s {FFFF00}[VIP-2] [%d]: {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 3 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s {FFFF00}[VIP-3] [%d]: {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
	}
	else
	{
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 0 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s [%d] {FF0000}[Wanted] : {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 1 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s [%d]{FF0000} [Wanted] {FFFF00}[VIP-1]: {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 2 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s  [%d]{FF0000} [Wanted] {FFFF00}[VIP-2] : {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 3 && PGang[playerid] <= 0)//игрок УЖЕ заспавнился
		{
			format(string, sizeof(string), "%s  [%d]{FF0000} [Wanted] {FFFF00}[VIP-3] : {FFFFFF}%s", sendername, playerid, text); // Прикрепляем ид к нику
			SendClientMessageToAll(GetPlayerColor(playerid), string); // Отправляем сообщение
			return 0;
		}
	}

	if(PlayerInfo[playerid][pWanted] == 0)
	{
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 0 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d]: {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 1 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FFFF00}[VIP-1]: {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 2 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FFFF00}[VIP-2]: {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 3 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FFFF00}[VIP-3]: {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
	}
	else
	{
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 0 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FF0000}[Wanted] : {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 1 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FF0000}[Wanted] {FFFF00}[VIP-1] : {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 2 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FF0000}[Wanted] {FFFF00}[VIP-2] : {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
		if(playspa[playerid] == 1 && PlayerInfo[playerid][pVIP] == 3 && PGang[playerid] > 0)//Gangs system
		{
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			format(string, sizeof(string), "[%s] %s [%d] {FF0000}[Wanted] {FFFF00}[VIP-3] : {FFFFFF}%s", GName[PGang[playerid]], PlayNam(playerid), playerid, text);
			SendClientMessageToAll(hex[playerid], string);
			return 0;
		}
	}
	return 1;
}

stock ini_GetKey( line[] )
{
	new keyRes[256];
	keyRes[0] = 0;
    if ( strfind( line , "=" , true ) == -1 ) return keyRes;
    strmid( keyRes , line , 0 , strfind( line , "=" , true ) , sizeof( keyRes) );
    return keyRes;
}

stock ini_GetValue( line[] )
{
	new valRes[256];
	valRes[0]=0;
	if ( strfind( line , "=" , true ) == -1 ) return valRes;
	strmid( valRes , line , strfind( line , "=" , true )+1 , strlen( line ) , sizeof( valRes ) );
	return valRes;
}

strtok(const string[], &index)
{
	new length = strlen(string);
	while ((index < length) && (string[index] <= ' '))
	{
		index++;
	}

	new offset = index;
	new result[30];
	while ((index < length) && (string[index] > ' ') && ((index - offset) < (sizeof(result) - 1)))
	{
		result[index - offset] = string[index];
		index++;
	}
	result[index - offset] = EOS;
	return result;
}

public OnPlayerCommandText(playerid, cmdtext[])
{
    if (!gPlayerLogged[playerid])
    {
        SendClientMessage(playerid, COLOR_RED, "DRAZVIO: Сначала войдите в аккаунт.");
        return 1;
    }
	if(!strcmp(cmdtext, "/piratedm"))
	{
		new Random = random(sizeof(PirateDMSpawns));
		SetPlayerPos(playerid, PirateDMSpawns[Random][0], PirateDMSpawns[Random][1], PirateDMSpawns[Random][2]);
		SetPlayerFacingAngle(playerid, PirateDMSpawns[Random][3]);
		SendClientMessage(playerid, COLOR_GREY, "Вы зашли на пиратский корабль!");
		ResetPlayerWeapons(playerid);
		GivePlayerWeapon(playerid, WEAPON_KATANA, 1000);
		GivePlayerWeapon(playerid, WEAPON_SAWEDOFF, 1000);
		GivePlayerWeapon(playerid, WEAPON_GRENADE, 1000);
		return 1;
	}
	if(!strcmp(cmdtext, "/piratedmexit"))
	{
		SendClientMessage(playerid, -1, "Вы вышли с пиратского корабля.");
		OnPlayerSpawn(playerid);
		return 1;
	}
	if(strcmp(cmdtext, "/radoff", true) == 0)
	{
	    StopAudioStreamForPlayer(playerid);
	    SendClientMessage(playerid, COLOR_YELLOW, "Вы отключили радио");
	    return 1;
	}
	if(strcmp(cmdtext, "/spawncars", true) == 0)
	    {
	    	new string[256];
			new sendername[MAX_PLAYER_NAME];
			GetPlayerName(playerid, sendername, sizeof(sendername));
	        if(IsPlayerConnected(playerid))
 	       {
	            if(PlayerInfo[playerid][pAdmin] < 8)
    	        {
        	        SendClientMessage(playerid, COLOR_GRAD1, "   Вы не можете использовать эту команду!");
            	    return 1;
            	}
	            for(new c=0; c<MAX_VEHICLES; c++)
    	        {
        	        if(!IsVehicleOccupiedCar(c))
            	    {
                	    SetVehicleToRespawn(c);
         	        }
            	}
            	GetPlayerName(playerid,sendername,sizeof(sendername));
            	format(string,sizeof(string),"*Администратор %s зареспавнил незанятый людьми транспорт!",sendername);
            	SendClientMessageToAll(COLOR_LIGHTBLUE,string);
        	}
        	return 1;
    	}
		if(strcmp(cmdtext, "/exitdm", true) == 0)
		{
		DM[playerid] = GetPlayerVirtualWorld(playerid);
		if (DM[playerid] == 96)
		{
		StopAudioStreamForPlayer(playerid);
		SetPVarInt(playerid, "Music", 0);
		DM[playerid] = 0;
		SpawnPlayer(playerid);
		SetPlayerVirtualWorld(playerid, 0);
		SetPlayerHealth(playerid, 100);
		SetPlayerArmour(playerid, 100);
		return 1;
		}
      	}
		if(strcmp(cmdtext, "/topdm",true) == 0)
		{
		        if(GetPVarInt(playerid, "Music") == 0)
		        {
					new string[256],PlayerName[MAX_PLAYER_NAME];
					GetPlayerName(playerid,PlayerName,MAX_PLAYER_NAME);
					DestrCar(playerid);
					tpdrift[playerid] = 1;
					DM[playerid] = 96;
	 				SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 96);
					format(string,sizeof(string),"%s[%d]:{FFFF00}Телепортировался на {FF0000} °• DeathMatch •° {FFFFFF}(/topdm)",PlayerName,playerid);
	                SendClientMessageToAll(COLOR_RED,string);
					SendClientMessage(playerid, -1, "{FF26D1}================ Чтобы выйти с ДМ зоны пропишите: /exitdm , для отключения музыки введите /radoff ================");
					ResetPlayerWeapons(playerid);
					GivePlayerWeapon(playerid, weapons1[random(sizeof(weapons1))], 1000);
					SetPVarInt(playerid, "Music", 1);
			 		switch(random(5))
			 		{
			 		case 0: SetPlayerPos(playerid, -1089.2100,-933.9091,129.2188);
			 		case 1: SetPlayerPos(playerid, -1089.4825,-1044.7700,129.2119);
			 		case 2: SetPlayerPos(playerid, -1194.7784,-1045.4269,129.2188);
				 	case 3: SetPlayerPos(playerid, -1180.6783,-923.7373,129.2119);
				 	case 4: SetPlayerPos(playerid, -1007.3196,-915.4716,129.2188);
			 		case 5: SetPlayerPos(playerid, -1010.9894,-1060.1567,129.2188);
					}
		        	PlayAudioStreamForPlayer(playerid, "http://air.radiorecord.ru:8102/club_128");
					return 1;
				}
			 	else
				{
					DestrCar(playerid);
					tpdrift[playerid] = 1;
					DM[playerid] = 96;
	 				SetPlayerInterior(playerid, 0);
					SetPlayerVirtualWorld(playerid, 96);
					SendClientMessage(playerid, -1, "{FF26D1}================ Чтобы выйти с ДМ зоны пропишите: /exitdm , для отключения музыки введите /radoff ================");
					ResetPlayerWeapons(playerid);
					GivePlayerWeapon(playerid, weapons1[random(sizeof(weapons1))], 1000);
			 		switch(random(5))
			 		{
			 		//DM зона 14
			 		case 0: SetPlayerPos(playerid, -1089.2100,-933.9091,129.2188);
			 		case 1: SetPlayerPos(playerid, -1089.4825,-1044.7700,129.2119);
			 		case 2: SetPlayerPos(playerid, -1194.7784,-1045.4269,129.2188);
				 	case 3: SetPlayerPos(playerid, -1180.6783,-923.7373,129.2119);
				 	case 4: SetPlayerPos(playerid, -1007.3196,-915.4716,129.2188);
			 		case 5: SetPlayerPos(playerid, -1010.9894,-1060.1567,129.2188);
			 		}
				    return 1;
			 	}
		}
        if(strcmp(cmdtext, "/po4ta",true) == 0)
        {
                SetPlayerVirtualWorld(playerid, 0);
                playerworking[playerid] = 1;
               SetPlayerCheckpoint(playerid,1804.5814,-2117.0742,13.2305, 2.0);//Ваши координаты 2 означает размер чекпоинта
               checkp[playerid] = 1;// запускаем метку
               SendClientMessage(playerid,COLOR_YELLOW, "Возьмите машину и развезите {F30F40}письма по домам.");
               return 1;
        }
    if(!strcmp("/lift", cmdtext, true))
	{
		if(!PlayerOnJob[playerid]) return SendClientMessage(playerid, -1, "Вы не устроились на работу шахтёра.");
	    if(exitp) return SendClientMessage(playerid, -1, "Пожалуйста подождите.");
		if(!IsPlayerInRangeOfPoint(playerid, 5, -1899.0999755859, -1636.5999755859, 25.700000762939)
		&& !IsPlayerInRangeOfPoint(playerid, 5, -1899.0996093750, -1636.5996093750, -59.40000152587)) return SendClientMessage(playerid, -1, "Вы не у лифта.");
		if(vputi) return SendClientMessage(playerid, -1, "Лифт уже в пути.");
	    if(!lift)
		{
			SetTimer("UpdateDoors", 17500, false);
			MoveObject(floorlift[0], -1900.1999511719, -1638.9000244141, -61.0, 5);
			MoveObject(floorlift[1], -1901.4000244141, -1638.9000244141, -61.0, 5);
			MoveObject(floorlift[2], -1902.0999755859, -1638.9000244141, -61.0, 5);
			MoveObject(upgate, -1899.0999755859, -1636.5999755859, 25.700000762939, 5);
			vputi = true;
			lift = true;
		}
		else
		{
			SetTimer("UpdateDoors", 17500, false);
			MoveObject(floorlift[0], -1900.1999511719, -1638.9000244141, 23.89999961853, 5);
			MoveObject(floorlift[1], -1901.4000244141, -1638.9000244141, 23.89999961853, 5);
			MoveObject(floorlift[2], -1902.0999755859, -1638.9000244141, 23.89999961853, 5);
			MoveObject(downgate, -1899.099609375, -1636.599609375, -59.400001525879, 5);
			vputi = true;
			lift = false;
		}
		return 1;
	}
	#if !defined TOLOWER_IN_ANY_CASE
		if(IsTextUppercase(cmdtext))
		{
		#if defined TOLOWER_WITHOUT_CAP_LETTERS
			UpperToLowerWithoutCapLetters(cmdtext);
		#else
			UpperToLower(cmdtext);
		#endif
		}
	#elseif defined TOLOWER_WITHOUT_CAP_LETTERS
		UpperToLowerWithoutCapLetters(cmdtext);
	#else
		UpperToLower(cmdtext);
	#endif
	chatcon[playerid]++;//прибавляем 1 к контрольной переменной чата
	//new giveplayerid;
	new idx;
	idx = 0;
	new string[256];
	//new playermoney;
	new sendername[MAX_PLAYER_NAME];
	new giveplayer[MAX_PLAYER_NAME];
	//new playername[MAX_PLAYER_NAME];
	new cmd[256];
	new tmp[256];
	cmd = strtok(cmdtext, idx);
    new pname[MAX_PLAYER_NAME];
	GetPlayerName(playerid,pname,sizeof(pname));
	new aa444[64];//доработка для использования Русских ников
	format(aa444, sizeof(aa444), "%s", pname);//доработка для использования Русских ников
	new stringdop22[256];
	if(PlayerInfo[playerid][pMutedsec] == 0)
	{
		printf(" Игрок %s [%d] ввёл команду: %s .",aa444,playerid,cmdtext);//доработка для использования Русских ников
		format(stringdop22, sizeof(stringdop22), " Игрок %s [%d] ввёл команду: {FFFF00}%s .",aa444,playerid,cmdtext);//доработка для использования Русских ников
	}
	if(PlayerInfo[playerid][pMutedsec] > 0)
	{
		printf(" Игрок %s [%d] (бан чата) ввёл команду: %s .",aa444,playerid,cmdtext);//доработка для использования Русских ников
		format(stringdop22, sizeof(stringdop22), " Игрок %s [%d] {FF0000}(бан чата) {00FF00}ввёл команду: {FFFF00}%s .",aa444,playerid,cmdtext);//доработка для использования Русских ников
	}
	for(new i = 0; i < MAX_PLAYERS; i++)
	{
		if(IsPlayerConnected(i) && PlayerInfo[i][pAdmin] >= 1 && PlayerInfo[i][pAdmscancom] == 1 && PlayerInfo[playerid][pAdmin] < 10)
		{
				SendClientMessage(i, COLOR_GREEN, stringdop22);
		}
	}
	if(strcmp(cmdtext, "/bar", true) == 0)
	{
		if(PlayerToPoint(100.0,playerid,-2561.9153, -2686.7068, 805.7360))
    	{
			ShowPlayerDialog(playerid, 6532, DIALOG_STYLE_LIST, "Бармен","Пиво\nВино\nСпрайт\nМетамфетамин\nОтрезвитель","OK", "Отмена");
			return 1;
		}
		else
		{
			SendClientMessage(playerid, COLOR_RED, "Вы не в баре");
			return 1;
		}
	}
	if(strcmp(cmd, "/iznas", true) == 0)
	{
		tmp = strtok(cmdtext,idx);
		new otherplayer = strval(tmp);
		if(GetDistanceBetweenPlayers(playerid, otherplayer) > 2) return SendClientMessage(playerid, 0xFF0000AA, "Вы слишком далеко!");
		if(otherplayer == playerid) return SendClientMessage(playerid, -1, " * DRAZVIO: Вы не можете изнасиловать самого себя");
		SendClientMessage(playerid, 0xFF0000AA, "Вы изнасиловали игрока!");
		SendClientMessage(otherplayer, 0x00FF00AA, "Вас изнасиловали!");
		LoopingAnim(otherplayer, "SNM", "SPANKINGW", 4.1, 0, 1, 1, 1, 1, 1);
		LoopingAnim(playerid, "SNM", "SPANKEDW", 4.1, 0, 1, 1, 1, 1, 1);
		return 1;
	}
	if(strcmp(cmd, "/me", true) == 0)
    {
        if(PlayerInfo[playerid][pMutedsec] > 0)
		{
			SendClientMessage(playerid, COLOR_YELLOW, "•.:DRAZVIO:.• | {FF0000}Вы не можете писать, у вас бан чата !");
			return 1;
		}
		GetPlayerName(playerid, sendername, sizeof(sendername));
        new length = strlen(cmdtext);
        while ((idx < length) && (cmdtext[idx] <= ' '))
		{
        	idx++;
		}
        new offset = idx;
        new result[64];
        while ((idx < length) && ((idx - offset) < (sizeof(result) - 1)))
        {
        	result[idx - offset] = cmdtext[idx];
         	idx++;
        }
        result[idx - offset] = EOS;
        if(!strlen(result)) return     SendClientMessage(playerid, COLOR_GREY, "Используйте: /me [действие]");
        format(string, sizeof(string), "%s %s", sendername, result);
        ProxDetector(30.0, playerid, string, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF, 0xDD90FFFF);
