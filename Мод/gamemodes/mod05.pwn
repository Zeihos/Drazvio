			format(var, sizeof(var), "MinLog=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "AdminLevel=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "AdminShadow=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "AdminLive=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "AdminScanCom=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Registered=%d\n",1);fwrite(hFile44, var);
			format(var, sizeof(var), "Prison=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Prisonsec=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Muted=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Mutedsec=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Money=%d\n",1000);fwrite(hFile44, var);
			format(var, sizeof(var), "Kills=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Deaths=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "VIP=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Deport=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "RecPM=%d\n",1);fwrite(hFile44, var);
			format(var, sizeof(var), "Wanted=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Lock=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "Gang=%d\n",0);fwrite(hFile44, var);
			format(var, sizeof(var), "GangLvl=%d\n",0);fwrite(hFile44, var);
