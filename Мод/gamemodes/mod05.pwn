		Obj_FloorDoors[i][1] = CreateDynamicObject(18756, X_DOOR_CLOSED, -1303.171142, GetDoorsZCoordForFloor(i), 0.000000, 0.000000, 270.000000, -1, -1, -1, 500);
		format(string, sizeof(string), "[ %s ]\n{33AA33}Нажмите {AA2222}''N'' {33AA33}для\nвызова лифта", FloorNames[i]);
		if(i == 0)//3D-тексты на этажах
		{
		    z = 13.4713;
		}
		else
		{
		    z = 13.4713 + 8.7396 + ((i-1) * 5.45155);
		}
		Label_Floors[i] = Create3DTextLabel(string, 0xF0F0F0FF, 1783.9799, -1300.7660, z, 10.5, 0, 1);
		format(string, sizeof(string), "[ %s ]", FloorNames[0]);
		Label_Floors22[i] = Create3DTextLabel(string, 0x33AA33FF, 1786.6799, -1300.7660, z + 2.3, 10.5, 0, 0);
	}
	Floor_OpenDoors(0);
	Elevator_OpenDoors();
//----------------------------- End Elevator -----------------------------------

	LoadBusSystem();//загрузка системы бизнесов//BusSystem

	return 1;
}

#if (MOD90INS == 1 && MOD91INS == 1)
forward CreateDB();
public CreateDB()
{
	playerdb = db_open("players/players.db");//подключаем базу данных аккаунтов игроков к серверу
	new s01[256], s02[256], s03[256], s04[256], s05[256], s00[1280];//создаём запрос БД
	format(s01, 256, "CREATE TABLE Players(IDCopy INTEGER,Name VARCHAR(32),Key VARCHAR(128),TDReg VARCHAR(32),DEndConD INTEGER,");
	format(s02, 256, "DEndConM INTEGER,DEndConY INTEGER,IPAdr VARCHAR(32),MinLog INTEGER,AdminLevel INTEGER,AdminShadow INTEGER,");
	format(s03, 256, "AdminLive INTEGER,AdminScanCom INTEGER,Registered INTEGER,Prison INTEGER,Prisonsec INTEGER,Muted INTEGER,");
	format(s04, 256, "Mutedsec INTEGER,Money INTEGER,Kills INTEGER,Deaths INTEGER,VIP INTEGER,Deport INTEGER,RecPM INTEGER,");
//	format(s05, 256, "Wanted INTEGER,Lock INTEGER,Gang INTEGER,GangLvl INTEGER)");//удалить строку (изменения от 25.12.2015)
	format(s05, 256, "Wanted INTEGER,Lock INTEGER,Gang INTEGER,GangLvl INTEGER,FragSlvl INTEGER,FragTlvl INTEGER,FragBlvl INTEGER)");//вставить строку (изменения от 25.12.2015)
	format(s00, 1280, "%s%s%s%s%s", s01, s02, s03, s04, s05);
	db_query(playerdb, s00);//отправляем запрос на создание новой (пустой) БД
	print(" ");
	print(" * Новая (пустая) база данных аккаунтов игроков успешно создана !");
	print(" * Теперь сервер можно выключить (закрыть), и перевести его в");
	print(" * нормальный режим работы (MOD91INS 0) !");
	print(" ");
	return 1;
}
#endif

