			format(sbb, 1792, "%s%s%s%s%s%s%s%s", s11, s12, s13, s14, s15, s16, s18, s17);//вставить строку (изменения от 25.12.2015)
			format(s00, 3328, "%s%s", saa, sbb);
			db_query(playerdb, s00);//отправляем запрос на обновление (перезапись) аккаунта в БД
#endif
		}
	}
	return 1;
}

public ClearChat(playerid, lines)
{
	if (IsPlayerConnected(playerid))
	{
		for(new i=0; i<lines; i++)
		{
			SendClientMessage(playerid, COLOR_WHITE, " ");
		}
	}
	return 1;
}

// DRAZVIO STAGE5: in-memory per-IP/per-nickname login throttle across reconnects.
// The account and source IP must both match: do not penalize all players behind NAT.
// The table resets on a full server restart; this is NOT a distributed firewall.
#define DZ_AUTH_BUCKETS (256)
#define DZ_AUTH_WINDOW_SECONDS (600)
#define DZ_AUTH_LOCK_SECONDS (300)
#define DZ_AUTH_MAX_FAILURES (10)
new DZ_AuthIP[DZ_AUTH_BUCKETS][46];
new DZ_AuthNick[DZ_AUTH_BUCKETS][MAX_PLAYER_NAME];
new DZ_AuthFirst[DZ_AUTH_BUCKETS];
new DZ_AuthBlockUntil[DZ_AUTH_BUCKETS];
new DZ_AuthLastSeen[DZ_AUTH_BUCKETS];
new DZ_AuthFails[DZ_AUTH_BUCKETS];

stock DZ_AuthSlot(playerid)
{
    new ip[46], nick[MAX_PLAYER_NAME];
    GetPlayerIp(playerid, ip, sizeof(ip));
    GetPlayerName(playerid, nick, sizeof(nick));
    new slot = -1, oldest = 2147483647, now = gettime();
    for(new i = 0; i < DZ_AUTH_BUCKETS; i++)
    {
        if(DZ_AuthIP[i][0] != EOS && !strcmp(DZ_AuthIP[i], ip, true) && !strcmp(DZ_AuthNick[i], nick, true))
        {
            DZ_AuthLastSeen[i] = now;
            return i;
        }
        if(DZ_AuthIP[i][0] == EOS || (DZ_AuthBlockUntil[i] <= now && now - DZ_AuthLastSeen[i] > DZ_AUTH_WINDOW_SECONDS))
        {
            slot = i;
            break;
        }
        if(DZ_AuthLastSeen[i] < oldest && DZ_AuthBlockUntil[i] <= now)
        {
            oldest = DZ_AuthLastSeen[i];
            slot = i;
        }
    }
    if(slot == -1) return -1; // Never evict an active cooldown.
    format(DZ_AuthIP[slot], 46, "%s", ip);
    format(DZ_AuthNick[slot], MAX_PLAYER_NAME, "%s", nick);
    DZ_AuthFails[slot] = 0;
    DZ_AuthFirst[slot] = now;
    DZ_AuthLastSeen[slot] = now;
    DZ_AuthBlockUntil[slot] = 0;
    return slot;
}

stock DZ_AuthCanAttempt(playerid)
{
    new slot = DZ_AuthSlot(playerid);
    if(slot < 0) return 0; // Fail closed if table is exhausted.
    if(DZ_AuthBlockUntil[slot] > gettime()) return 0;
    return 1;
}

stock DZ_AuthInvalidPassword(playerid)
{
    new slot = DZ_AuthSlot(playerid);
    if(slot < 0) return 1;
    new now = gettime();
    if(now - DZ_AuthFirst[slot] >= DZ_AUTH_WINDOW_SECONDS)
    {
        DZ_AuthFails[slot] = 0;
        DZ_AuthFirst[slot] = now;
    }
    DZ_AuthFails[slot]++;
    if(DZ_AuthFails[slot] >= DZ_AUTH_MAX_FAILURES)
    {
        DZ_AuthBlockUntil[slot] = now + DZ_AUTH_LOCK_SECONDS;
        return 1;
    }
    return 0;
}

stock DZ_AuthLoggedIn(playerid)
{
    new slot = DZ_AuthSlot(playerid);
    if(slot >= 0)
    {
        DZ_AuthFails[slot] = 0;
        DZ_AuthBlockUntil[slot] = 0;
        DZ_AuthFirst[slot] = gettime();
    }
    return 1;
}

public OnPlayerLogin(playerid,password[])
{
    if(!DZ_AuthCanAttempt(playerid))
    {
        SendClientMessage(playerid, COLOR_RED, "DRAZVIO: вход временно ограничен. Повторите через 5 минут.");
        SetTimerEx("DZ_Guard_PlayKick", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
        return 1;
    }
    PlayerInfo[playerid][pKey][0] = EOS; // Данные предыдущего игрока нельзя использовать при ошибке чтения.
	strdel(PlayerInfo[playerid][pTDReg], 0, 256);//очистка времени и даты регистрации
