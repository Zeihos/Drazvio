				case 'Л':result[i] = '‡';
				case 'м':result[i] = 'Ї';
				case 'М':result[i] = 'M';
				case 'н':result[i] = '®';
				case 'Н':result[i] = '­';
				case 'о':result[i] = 'o';
				case 'О':result[i] = 'O';
				case 'п':result[i] = 'Ј';
