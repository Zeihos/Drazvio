// Saturating credit. Never produce signed integer overflow in player balances.
stock DZ_CreditMoney(playerid, amount)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid) || amount <= 0) return 0;
    new balance = GetPVarInt(playerid, "PlMon");
    if(balance < 0) balance = 0;
    if(balance >= DZ_MAX_BALANCE) return 0;
    if(amount > DZ_MAX_BALANCE - balance) amount = DZ_MAX_BALANCE - balance;
    SetPVarInt(playerid, "PlMon", balance + amount);
    return amount;
}


// DRAZVIO 25.10.2026: compensating an owner MUST succeed before forced house sale.
// There is no cross-file transaction support in legacy dini; keep a backup and audit sales.
stock DZ_PayForcedHouseSale(houseid, housefile[])
{
    if(houseid < 0 || houseid >= MAX_HOUSES || !dini_Exists(housefile)) return 0;
    new owner[MAX_PLAYER_NAME + 1];
    format(owner, sizeof(owner), "%s", GetHouseOwner(houseid));
    if(!strlen(owner) || !strcmp(owner, INVALID_HOWNER_NAME, CASE_SENSETIVE)) return 0;
    new payment = ReturnProcent(GetHouseValue(houseid), HOUSE_SELLING_PROCENT);
    new storage = dini_Int(housefile, "HouseStorage");
    if(payment < 0 || storage < 0 || payment > DZ_MAX_BALANCE || storage > DZ_MAX_BALANCE - payment) return 0;
    payment += storage;
    if(payment == 0) return 1;

    new ownerid = GetHouseOwnerEx(houseid);
    if(ownerid != INVALID_PLAYER_ID)
    {
        if(!gPlayerLogged[ownerid]) return 0;
        new balance = GetPVarInt(ownerid, "PlMon");
        if(balance < 0 || balance > DZ_MAX_BALANCE || payment > DZ_MAX_BALANCE - balance) return 0;
        if(DZ_CreditMoney(ownerid, payment) != payment) return 0;
        printf("[DRAZVIO HOUSE SALE] house=%d owner=%s online=1 paid=%d", houseid, owner, payment);
        return 1;
    }
#if (MOD90INS == 0)
    // Reject untrusted path fragments, never create nonexistent or incomplete accounts.
    if(strfind(owner, "/", true) != -1 || strfind(owner, "\\", true) != -1 || strfind(owner, "..", true) != -1 || strfind(owner, ":", true) != -1) return 0;
    new account[128];
    format(account, sizeof(account), "players/%s.ini", owner);
    if(!dini_Exists(account) || !dini_Isset(account, "Money") || !dini_Isset(account, "Registered")) return 0;
    if(dini_Int(account, "Registered") != 1) return 0;
    new balance = dini_Int(account, "Money");
    if(balance < 0 || balance > DZ_MAX_BALANCE || payment > DZ_MAX_BALANCE - balance) return 0;
    // Stage 11: offline payouts must use the same staged-snapshot discipline
    // as online account saves.  Never overwrite the only live .ini directly.
    new updated = balance + payment;
    new backup[144], staged[144], parked[144], oldKey[128];
    format(backup, sizeof(backup), "%s.bak", account);
    format(staged, sizeof(staged), "%s.savenew", account);
    format(parked, sizeof(parked), "%s.swapold", account);
    if(fexist(staged) || fexist(parked))
    {
        printf("[DRAZVIO HOUSE SALE] Pending account recovery for owner=%s; sale blocked.", owner);
        return 0;
    }
    if(!dini_Isset(account, "Key") || !dini_Isset(account, "VIP") ||
       !dini_Isset(account, "AdminLevel")) return 0;
    format(oldKey, sizeof(oldKey), "%s", dini_Get(account, "Key"));
    if(!strlen(oldKey)) return 0;
    new oldVIP = dini_Int(account, "VIP");
    new oldAdmin = dini_Int(account, "AdminLevel");
    if(!fcopytextfile(account, backup) ||
       !DZ_FileHasValue(backup, "Key", oldKey) ||
       !DZ_AccountIntEquals(backup, "Money", balance) ||
       !DZ_AccountIntEquals(backup, "Registered", 1) ||
       !DZ_AccountIntEquals(backup, "VIP", oldVIP) ||
       !DZ_AccountIntEquals(backup, "AdminLevel", oldAdmin))
    {
        printf("[DRAZVIO HOUSE SALE] Cannot back up owner=%s; sale blocked.", owner);
        return 0;
    }
    if(!fcopytextfile(account, staged)) return 0;
    if(!DZ_FileHasValue(staged, "Key", oldKey) ||
       !DZ_AccountIntEquals(staged, "Money", balance) ||
       !DZ_AccountIntEquals(staged, "Registered", 1) ||
       !DZ_AccountIntEquals(staged, "VIP", oldVIP) ||
       !DZ_AccountIntEquals(staged, "AdminLevel", oldAdmin))
    {
        printf("[DRAZVIO HOUSE SALE] Bad staged owner account=%s; sale blocked.", owner);
        return 0;
    }
    dini_IntSet(staged, "Money", updated);
    if(!DZ_AccountIntEquals(staged, "Money", updated) ||
       !DZ_FileHasValue(staged, "Key", oldKey) ||
       !DZ_AccountIntEquals(staged, "VIP", oldVIP) ||
       !DZ_AccountIntEquals(staged, "AdminLevel", oldAdmin)) return 0;
    if(!fileMove(account, parked)) return 0;
    if(!fileMove(staged, account))
    {
        if(!fexist(account) && !fileMove(parked, account))
            printf("[DRAZVIO HOUSE SALE] CRITICAL: restore .swapold manually owner=%s", owner);
        return 0;
    }
    if(!DZ_AccountIntEquals(account, "Money", updated) ||
       !DZ_FileHasValue(account, "Key", oldKey))
    {
        printf("[DRAZVIO HOUSE SALE] CRITICAL: post-move verification failed owner=%s", owner);
        return 0;
    }
    if(!fileRemove(parked))
        printf("[DRAZVIO HOUSE SALE] WARNING: .swapold cleanup failed owner=%s", owner);
    printf("[DRAZVIO HOUSE SALE] house=%d owner=%s online=0 paid=%d", houseid, owner, payment);
    return 1;
#else
    // The SQLite account mode needs its own transactional payout implementation.
    return 0;
#endif
}

// Full decimal validation instead of strval on untrusted dialog input.
stock DZ_AmountFromInput(const inputtext[])
{
    new len = strlen(inputtext), amount = 0;
    if(len < 1 || len > 10) return 0;
    for(new i = 0; i < len; i++)
    {
        if(inputtext[i] < '0' || inputtext[i] > '9') return 0;
        new digit = inputtext[i] - '0';
        if(amount > (DZ_MAX_BALANCE - digit) / 10) return 0;
        amount = amount * 10 + digit;
    }
    return amount;
}

stock DZ_HouseOwnerAccess(playerid)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid) || !gPlayerLogged[playerid]) return 0;
    new hid = GetPVarInt(playerid, "LastHouseCP"), file[HOUSEFILE_LENGTH];
    if(hid < 0 || hid >= MAX_HOUSES) return 0;
    format(file, sizeof(file), FILEPATH, hid);
    if(!dini_Exists(file)) return 0;
    return !strcmp(GetHouseOwner(hid), pNick(playerid), CASE_SENSETIVE);
}

// DRAZVIO: player-ID epochs protect asynchronous actions against slot reuse.
// Monotonically incremented on connect and disconnect. Never reset for a new client.
new DZ_PlayerEpoch[MAX_PLAYERS];
stock DZ_EpochAt(playerid)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS) return 0;
    return DZ_PlayerEpoch[playerid];
}
stock DZ_EpochValid(playerid, epoch)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || epoch == 0) return 0;
    return (DZ_PlayerEpoch[playerid] == epoch);
}
stock DZ_SameSession(playerid, epoch)
{
    return (DZ_EpochValid(playerid, epoch) && IsPlayerConnected(playerid));
}


// DRAZVIO: pending gang rank dialogs must validate both parties on every response.
new DZ_GangTargetEpoch[MAX_PLAYERS];
stock DZ_ValidGangRankTarget(playerid)
{
    if(playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid) || !gPlayerLogged[playerid]) return 0;
    new gang = PGang[playerid];
    if(gang <= 0 || gang >= MAX_GANGS || GangLvl[playerid] != 6) return 0;
    new target = play333[playerid];
    if(target < 0 || target >= MAX_PLAYERS || target == playerid || !IsPlayerConnected(target) || !gPlayerLogged[target]) return 0;
    if(PGang[target] != gang || !DZ_SameSession(target, DZ_GangTargetEpoch[playerid])) return 0;
    return 1;
}

stock DZ_GangDecimalPlayerId(const inputtext[])
{
    new len = strlen(inputtext), result = 0;
    if(len < 1 || len > 5) return -1;
    for(new i = 0; i < len; i++)
    {
        if(inputtext[i] < '0' || inputtext[i] > '9') return -1;
        result = result * 10 + (inputtext[i] - '0');
        if(result >= MAX_PLAYERS) return -1;
    }
    return result;
}

