                TextDrawBackgroundColor(ServerTextDrawFour[Player],255);
                TextDrawFont(ServerTextDrawFour[Player],2);
                TextDrawLetterSize(ServerTextDrawFour[Player],0.200000,1.000000);
                TextDrawColor(ServerTextDrawFour[Player],-1);
