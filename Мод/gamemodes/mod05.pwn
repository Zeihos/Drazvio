				format(s02, 256, "AdminShadow,AdminLive,AdminScanCom,Registered,Prison,Prisonsec,Muted,Mutedsec,Money,Kills,Deaths,");
//				format(s03, 256, "VIP,Deport,RecPM,Wanted,Lock,Gang,GangLvl) ");//удалить строку (изменения от 25.12.2015)
				format(s03, 256, "VIP,Deport,RecPM,Wanted,Lock,Gang,GangLvl,FragSlvl,FragTlvl,FragBlvl) ");//вставить строку (изменения от 25.12.2015)
				format(s04, 256, "VALUES (1,'%s','%s','%s',",RealName[playerid],PlayerInfo[playerid][pKey],PlayerInfo[playerid][pTDReg]);
				format(s05, 256, "%d,%d,%d,'%s',",EndConD,EndConM,EndConY,PlayerInfo[playerid][pIPAdr]);
				format(s06, 256, "%d,%d,%d,",PlayerInfo[playerid][pMinlog],PlayerInfo[playerid][pAdmin],PlayerInfo[playerid][pAdmshad]);
				format(s11, 256, "%d,%d,%d,",PlayerInfo[playerid][pAdmlive],PlayerInfo[playerid][pAdmscancom],PlayerInfo[playerid][pReg]);
				format(s12, 256, "%d,%d,%d,",PlayerInfo[playerid][pPrison],PlayerInfo[playerid][pPrisonsec],PlayerInfo[playerid][pMuted]);
				format(s13, 256, "%d,%d,%d,",PlayerInfo[playerid][pMutedsec],GetPVarInt(playerid, "PlMon"),PlayerInfo[playerid][pKills]);
				format(s14, 256, "%d,%d,%d,",PlayerInfo[playerid][pDeaths],PlayerInfo[playerid][pVIP],PlayerInfo[playerid][pDeport]);
				format(s15, 256, "%d,%d,%d,",PlayerInfo[playerid][pRecPM],PlayerInfo[playerid][pWanted],PlayerInfo[playerid][pLock]);
//				format(s16, 256, "%d,%d)",PGang[playerid],GangLvl[playerid]);//удалить строку (изменения от 25.12.2015)
//----------- вставить группу строк (изменения от 25.12.2015) ------------------
				format(s16, 256, "%d,%d,",PGang[playerid],GangLvl[playerid]);
				format(s17, 256, "%d,%d,%d)",PlayerInfo[playerid][pFragSlvl],PlayerInfo[playerid][pFragTlvl],PlayerInfo[playerid][pFragBlvl]);
//------------------ (изменения от 25.12.2015) конец ---------------------------
				format(saa, 1536, "%s%s%s%s%s%s", s01, s02, s03, s04, s05, s06);
//				format(sbb, 1536, "%s%s%s%s%s%s", s11, s12, s13, s14, s15, s16);//удалить строку (изменения от 25.12.2015)
				format(sbb, 1536, "%s%s%s%s%s%s%s", s11, s12, s13, s14, s15, s16, s17);//вставить строку (изменения от 25.12.2015)
				format(s00, 3072, "%s%s", saa, sbb);
				db_query(playerdb, s00);//отправляем запрос на добавление нового аккаунта в БД

				migration[playerid] = 0;//обнуляем режим миграции аккаунта
				if(fexist(string2))//если аккаунт в fopen обнаружен, то:
				{
					fremove(string2);//удаляем аккаунт из fopen
				}
			}
			else//иначе - НЕ читаем аккаунт из fopen
			{
				new s[128];
    			format(s,sizeof(s),"Вы ввели неправильный пароль.\n Аккаунт: %s\n\nВведите свой пароль для продолжения!",playername2);
   				ShowPlayerDialog(playerid,3,DIALOG_STYLE_PASSWORD,"{00C8E7}Авторизация",s,"Вход","Отмена");
	        	fclose(UserFile);
	        	gPlayerLogTries[playerid] += 1;
	        	if(DZ_AuthInvalidPassword(playerid))
            {
                // Wrong passwords are not proof of malicious activity on a shared IP.
                // Kick this session; do not permanently ban every user behind the address.
                printf("[DRAZVIO AUTH] Too many invalid passwords: player=%s id=%d", playername2, playerid);
                SendClientMessage(playerid, COLOR_RED, "DRAZVIO: Too many incorrect passwords. Wait five minutes before trying again.");
                SetTimerEx("DZ_Guard_PlayKick", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
            }
	        	return 1;
			}
		}
	}
	else//иначе - если НЕ включен режим миграции аккаунта, то:
	{//читаем аккаунт из SQLite
		new string2[256];
		format(string2, sizeof(string2), "SELECT * FROM Players WHERE (Name = '%s')", RealName[playerid]);//создаём запрос БД
		querydb[playerid] = db_query(playerdb, string2);//отправляем запрос на чтение аккаунта из БД
		db_get_field(querydb[playerid], 2, PlayerInfo[playerid][pKey], 128);//читаем пароль из БД
		new loccor = 0;//переводим коды символов пароля из отрицательного диапазона чисел в положительный диапазон
		while(loccor < 128)//(в БД, коды символов от 128 до 255 - представляются в отрицательном диапазоне чисел !!!
		{//(коды символов Русских букв))
	    	if(PlayerInfo[playerid][pKey][loccor] == 0) { break; }
	    	if(PlayerInfo[playerid][pKey][loccor] < 0) { PlayerInfo[playerid][pKey][loccor] = PlayerInfo[playerid][pKey][loccor] + 256; }
			loccor++;
		}
		if (DZ_VerifyPassword(playerid, password))//если пароль из БД сходится с набранным паролем, то:
		{//читаем аккаунт из БД
			new buffer[32];
			db_get_field(querydb[playerid], 3, PlayerInfo[playerid][pTDReg], 256);
			db_get_field(querydb[playerid], 8, buffer, 32); PlayerInfo[playerid][pMinlog] = strval(buffer);
			db_get_field(querydb[playerid], 9, buffer, 32); PlayerInfo[playerid][pAdmin] = strval(buffer);
			db_get_field(querydb[playerid], 10, buffer, 32); PlayerInfo[playerid][pAdmshad] = strval(buffer);
			db_get_field(querydb[playerid], 11, buffer, 32); PlayerInfo[playerid][pAdmlive] = strval(buffer);
			db_get_field(querydb[playerid], 12, buffer, 32); PlayerInfo[playerid][pAdmscancom] = strval(buffer);
			db_get_field(querydb[playerid], 13, buffer, 32); PlayerInfo[playerid][pReg] = strval(buffer);
			db_get_field(querydb[playerid], 14, buffer, 32); PlayerInfo[playerid][pPrison] = strval(buffer);
			db_get_field(querydb[playerid], 15, buffer, 32); PlayerInfo[playerid][pPrisonsec] = strval(buffer);
			db_get_field(querydb[playerid], 16, buffer, 32); PlayerInfo[playerid][pMuted] = strval(buffer);
			db_get_field(querydb[playerid], 17, buffer, 32); PlayerInfo[playerid][pMutedsec] = strval(buffer);
			db_get_field(querydb[playerid], 18, buffer, 32); SetPVarInt(playerid, "PlMon", strval(buffer));
			db_get_field(querydb[playerid], 19, buffer, 32); PlayerInfo[playerid][pKills] = strval(buffer);
			db_get_field(querydb[playerid], 20, buffer, 32); PlayerInfo[playerid][pDeaths] = strval(buffer);
			db_get_field(querydb[playerid], 21, buffer, 32); PlayerInfo[playerid][pVIP] = strval(buffer);
			db_get_field(querydb[playerid], 22, buffer, 32); PlayerInfo[playerid][pDeport] = strval(buffer);
			db_get_field(querydb[playerid], 23, buffer, 32); PlayerInfo[playerid][pRecPM] = strval(buffer);
			db_get_field(querydb[playerid], 24, buffer, 32); PlayerInfo[playerid][pWanted] = strval(buffer);
			db_get_field(querydb[playerid], 25, buffer, 32); PlayerInfo[playerid][pLock] = strval(buffer);
			db_get_field(querydb[playerid], 26, buffer, 32); PGang[playerid] = strval(buffer);
			db_get_field(querydb[playerid], 27, buffer, 32); GangLvl[playerid] = strval(buffer);
//----------- вставить группу строк (изменения от 25.12.2015) ------------------
			db_get_field(querydb[playerid], 28, buffer, 32); PlayerInfo[playerid][pFragSlvl] = strval(buffer);
			db_get_field(querydb[playerid], 29, buffer, 32); PlayerInfo[playerid][pFragTlvl] = strval(buffer);
			db_get_field(querydb[playerid], 30, buffer, 32); PlayerInfo[playerid][pFragBlvl] = strval(buffer);
//------------------ (изменения от 25.12.2015) конец ---------------------------
			db_free_result(querydb[playerid]);//очищаем результат запроса БД
		}
		else//иначе - НЕ читаем аккаунт из БД
		{
			db_free_result(querydb[playerid]);//очищаем результат запроса БД (после чтения пароля)
			new s[128];
    		format(s,sizeof(s),"Вы ввели неправильный пароль.\n Аккаунт: %s\n\nВведите свой пароль для продолжения!",playername2);
			ShowPlayerDialog(playerid,3,DIALOG_STYLE_PASSWORD,"{00C8E7}Авторизация",s,"Вход","Отмена");
			gPlayerLogTries[playerid] += 1;
	        if(DZ_AuthInvalidPassword(playerid))
            {
                // Wrong passwords are not proof of malicious activity on a shared IP.
                // Kick this session; do not permanently ban every user behind the address.
                printf("[DRAZVIO AUTH] Too many invalid passwords: player=%s id=%d", playername2, playerid);
                SendClientMessage(playerid, COLOR_RED, "DRAZVIO: Too many incorrect passwords. Wait five minutes before trying again.");
                SetTimerEx("DZ_Guard_PlayKick", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
            }
			return 1;
		}
	}
#endif
    DZ_AuthLoggedIn(playerid);
	ResetPlayerMoney(playerid);
	if(PlayerInfo[playerid][pReg] == 0)
	{
		PlayerInfo[playerid][pAdmin] = 0;
		PlayerInfo[playerid][pAdmshad] = 0;
		PlayerInfo[playerid][pFragSlvl] = 0;
		PlayerInfo[playerid][pFragTlvl] = 0;
		PlayerInfo[playerid][pFragBlvl] = 0;
		PlayerInfo[playerid][pKills] = 0;
		PlayerInfo[playerid][pDeaths] = 0;
		SetPVarInt(playerid, "PlMon", 100000);
		PlayerInfo[playerid][pAdmscancom] = 0;
		PlayerInfo[playerid][pVIP] = 0;
		PlayerInfo[playerid][pDeport] = 0;
		PlayerInfo[playerid][pRecPM] = 1;
		PlayerInfo[playerid][pWanted] = 0;
		PlayerInfo[playerid][pAdmlive] = 0;
		livdop[playerid] = 0;

		PlayerInfo[playerid][pMinlog] = 0;
		PlayerInfo[playerid][pPrison] = 0;
		PlayerInfo[playerid][pPrisonsec] = 0;
		PlayerInfo[playerid][pMuted] = 0;
		PlayerInfo[playerid][pMutedsec] = 0;
		PlayerInfo[playerid][pLock] = 0;
		PlayerInfo[playerid][pReg] = 1;
	}
	if(PlayerInfo[playerid][pLock] == 1)
	{
		new string[256],pname[MAX_PLAYER_NAME];
		GetPlayerName(playerid,pname,sizeof(pname));
		format(string,sizeof(string),"•.:DRAZVIO:.• | {FF0000}Игрок %s [%d] был кикнут - аккаунт заблокирован !",pname,playerid);
		print(string);
		SendClientMessageToAll(COLOR_YELLOW,string);
		SendClientMessage(playerid,COLOR_YELLOW,"•.:DRAZVIO:.• | {FF0000}Для выяснения причин свяжитесь с администрацией сервера !");
		SendClientMessage(playerid,COLOR_YELLOW,"•.:DRAZVIO:.• | {FF0000}Если хотите Разбан, оставляйте заявку в группе DRAZVIO (новости уточняйте у администрации)");
		SetTimerEx("DZ_Guard_PlayKick", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
		TextDrawHideForPlayer(playerid, LoadScreen);
//		Kick(playerid);
		return 1;
	}
	if(PlayerInfo[playerid][pPrisonsec] == 1){PlayerInfo[playerid][pPrisonsec] = 2;}
	if(PlayerInfo[playerid][pMutedsec] == 1){PlayerInfo[playerid][pMutedsec] = 2;}
	if (PlayerInfo[playerid][pAdmin] == 0 && (PlayerInfo[playerid][pAdmshad] == 1 || PlayerInfo[playerid][pAdmlive] == 1))
	{
		PlayerInfo[playerid][pAdmshad] = 0;
		PlayerInfo[playerid][pAdmlive] = 0;
	}
	new string52[128];
	if (PlayerInfo[playerid][pAdmin] > 0)
	{
		format(string52, sizeof(string52), "* Админка %d уровня загружена.",PlayerInfo[playerid][pAdmin]);
		SendClientMessage(playerid, COLOR_WHITE,string52);
		new pname[MAX_PLAYER_NAME];
		GetPlayerName(playerid, pname, sizeof(pname));
		new aa333[64];//доработка для использования Русских ников
		format(aa333, sizeof(aa333), "%s", pname);//доработка для использования Русских ников
		AdmUpdate(aa333, PlayerInfo[playerid][pAdmin], 4);//доработка для использования Русских ников
//		AdmUpdate(pname, PlayerInfo[playerid][pAdmin], 4);
		if (PlayerInfo[playerid][pAdmshad] == 0)
		{
			SendClientMessage(playerid, COLOR_RED, " Скрытость выключена.");
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, " Скрытость включена.");
		}
		if (PlayerInfo[playerid][pAdmscancom] == 0)
		{
			SendClientMessage(playerid, COLOR_RED, " Сканирование команд сервера выключено.");
		}
		else
		{
			SendClientMessage(playerid, COLOR_GREEN, " Сканирование команд сервера включено.");
		}
		if (PlayerInfo[playerid][pAdmin] >= 5)
		{
			if (PlayerInfo[playerid][pAdmlive] == 0)
			{
				SendClientMessage(playerid, COLOR_RED, " Бессмертие выключено.");
			}
			else
			{
				SendClientMessage(playerid, COLOR_GREEN, " Бессмертие включено.");
			}
		}
		else
		{
			PlayerInfo[playerid][pAdmlive] = 0;//убрать бессмертие
			livdop[playerid] = 0;
		}
	}
	if (PlayerInfo[playerid][pVIP] > 0)
	{
		format(string52, sizeof(string52), "* Уровень %d випа загружен.",PlayerInfo[playerid][pVIP]);
		SendClientMessage(playerid, COLOR_WHITE,string52);
	}
	if (PlayerInfo[playerid][pRecPM] == 0)
	{
		SendClientMessage(playerid, COLOR_RED, " Приём PM от игроков запрещён.");
	}
	else
	{
		SendClientMessage(playerid, COLOR_GREEN, " Приём PM от игроков разрешён.");
	}

	skinstatplay[playerid] = 0;
	nickstatcol[playerid] = 0;
	TextDrawShowForPlayer(playerid, Text:Times);//включить часы игроку
	TextDrawHideForPlayer(playerid, LoadScreen);

	new sendername[MAX_PLAYER_NAME];
	GetPlayerName(playerid, sendername, sizeof(sendername));
	gPlayerLogged[playerid] = 1;
	gPlayerAccount[playerid] = 1;
    // Stage 7: apply VIP drift multiplier immediately on authenticated login.
    PlayerCombo[playerid] = 1;
    if(PlayerInfo[playerid][pVIP] == 1) PlayerCombo[playerid] = 2;
    if(PlayerInfo[playerid][pVIP] == 2) PlayerCombo[playerid] = 4;
    if(PlayerInfo[playerid][pVIP] == 3) PlayerCombo[playerid] = 6;
	SetPVarInt(playerid, "SecPris", PlayerInfo[playerid][pPrisonsec]);//записываем в глобальную переменную секунды тюрьмы
	new aa444[64];//доработка для использования Русских ников
	format(aa444, sizeof(aa444), "%s", sendername);//доработка для использования Русских ников
	printf("* Игрок %s [%d] --> (логирование) .", aa444, playerid);//доработка для использования Русских ников
//	printf("* Игрок %s [%d] --> (логирование) .", sendername, playerid);
	new dopper;
	dopper = 0;
	OnPlayerRequestClass(playerid, dopper);
//	SpawnPlayer(playerid);
	return 1;
}

