				GetPlayerName(player[playerid],targetname,sizeof(targetname)); GetPlayerName(playerid,aName,sizeof(aName));
				if(!IsPlayerConnected(player[playerid]) || strcmp(playtarget[playerid],targetname,false) != 0)
				{
					ShowPlayerDialog(playerid,2,0,"Ошибка.","Выбранный игрок вышел с сервера !","OK","");
					return 1;
				}
