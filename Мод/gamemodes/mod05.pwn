				OpenIP22[28],OpenIP[28],OpenIP22[29],OpenIP[29],OpenIP22[30],OpenIP[30],OpenIP22[31],OpenIP[31]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
