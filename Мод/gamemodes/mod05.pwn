public OnPlayerDeath(playerid, killerid, reason)
{
    TextDrawShowForPlayer(playerid, Wasted);
    TextDrawShowForPlayer(playerid, Wasted1);
    TextDrawShowForPlayer(playerid, Wasted2);
    TextDrawShowForPlayer(playerid, Wasted3);
	Intropic[playerid] = 0;
	Watching[playerid] = 0;
	Goto[playerid] = 0;
    noTotForest[playerid] = 0;
    for(new i = 0; i < MAX_PLAYERS; i++)
        if(IsPlayerConnected(i))
            ShowPlayerNameTagForPlayer(playerid, i, true);
	PlayerOnJob[playerid] = false;
	PlayerStartJob[playerid] = false;
	GetPlayerMetall[playerid] = 0;
	AllPlayerMetall[playerid] = 0;
	GetPlayerMetallEx[playerid] = 0;
	AllPlayerMetallEx[playerid] = 0;
	ExtraMetall[playerid] = 0;
	functioncon[playerid]++;//прибавляем 1 к контрольной переменной функций
            DisablePlayerCheckpoint(playerid);
			Checkpoint[playerid] = 0;
        if (IsPlayerInAnyVehicle(playerid))
        {
            new trailerid = GetVehicleTrailer(GetPlayerVehicleID(playerid));
            if (trailerid > 0) SetVehicleToRespawn(trailerid);
        }
    R_Vehicle[playerid] = VehicleSpeed_1;//speedometer

    if (killerid != INVALID_PLAYER_ID && killerid != playerid && IsPlayerConnected(killerid))
        PlayerInfo[killerid][pKills] += 1;
    PlayerInfo[playerid][pDeaths] += 1;
    SendDeathMessage(killerid,playerid,reason);
	if(PlayerInfo[playerid][pAdmin] == 0)//если умер - НЕ админ
	{
		new dz_deathBalance = GetPVarInt(playerid, "PlMon");
        SetPVarInt(playerid, "PlMon", dz_deathBalance > 1000 ? dz_deathBalance - 1000 : 0);
		SendClientMessage(playerid, 0xFFFFFFFF, "{8800FF}Вы умерли :{FCFF5C} - 1000 вирт!");
	}
	new Float:PosX12, Float:PosY13, Float:PosZ14;//проверка игрока в X-зоне
	GetPlayerPos(playerid, PosX12, PosY13, PosZ14);//чтение координат (playerid) игрока
	if(((-1602 < PosX12 && PosX12 < -1193) && (840 < PosY13 && PosY13 < 1158) && (973 < PosZ14 && PosZ14 < 1101)) ||
	((-1547 < PosX12 && PosX12 < -1247) && (1506 < PosY13 && PosY13 < 1705) && (1002 < PosZ14 && PosZ14 < 1123)))//сравниваем координаты
	{//игрок в зоне дерби
		LockSpawn[playerid] = 1;//если игрок умер в зоне дерби, то блокируем заполнение слотов оружия и предметов
	}
    if (killerid == INVALID_PLAYER_ID || killerid == playerid || !IsPlayerConnected(killerid)) return 1;
	if(PlayerInfo[killerid][pFragSlvl] >= 1)//если килер - син
	{
		DZ_CreditMoney(killerid, 3000);
		SendClientMessage(killerid, 0xFFFFFFFF, "{8800FF}Да ты прям тачир :{00F09C} + 3000 вирт;)");
		return 1;
	}
	else//если килер - НЕ син
	{
		if(PlayerInfo[killerid][pFragBlvl] >= 1)//если килер - байкер
		{
			DZ_CreditMoney(killerid, 3000);
			SendClientMessage(killerid, 0xFFFFFFFF, "{8800FF}Да ты прям тачир :{00F09C} + 3000 вирт;)");
			return 1;
		}
		else//если килер - НЕ байкер (и НЕ син)
		{
			if(PlayerInfo[killerid][pAdmin] == 0)//если килер - НЕ админ
			{
				DZ_CreditMoney(killerid, 3000);
				SendClientMessage(killerid, 0xFFFFFFFF, "{8800FF}Да ты прям тачир :{00F09C} + 3000 вирт;)");
			}
		}
	}
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
//	SetVehicleToRespawn(vehicleid);
	return 1;
}

public OnPlayerRegister(playerid, password[])
{
	if(IsPlayerConnected(playerid))
	{
		strdel(PlayerInfo[playerid][pTDReg], 0, 256);//очистка времени и даты регистрации
		gettime(timecor[0], timecor[1]);
		getdate(timecor[2], timecor[3], timecor[4]);
		TimCor();//коррекция времени
		DatCor();//коррекция даты
		format(PlayerInfo[playerid][pTDReg], 256, "%02d:%02d - %02d/%02d/%04d", timecor[0], timecor[1], timecor[4], timecor[3], timecor[2]);
#if (MOD90INS == 0)
		new string3[64];
//		new playername3[MAX_PLAYER_NAME];
//		GetPlayerName(playerid, playername3, sizeof(playername3));
		format(string3, sizeof(string3), "players/%s.ini", RealName[playerid]);//реальный ник игрока
        // A registration callback must never truncate an existing account.
        if(fexist(string3))
        {
            printf("[DRAZVIO SECURITY] Registration refused: account file already exists for %s", RealName[playerid]);
            return 0;
        }
//		format(string3, sizeof(string3), "players/%s.ini", playername3);
//		format(string3, sizeof(string3), "%s.ini", playername3);
		if (!DZ_SetPassword(playerid, password)) return 0;
        // Stage 8: construct and validate an account off to the side.
        new dz_regstage[80];
        format(dz_regstage, sizeof(dz_regstage), "%s.regnew", string3);
        if(fexist(dz_regstage))
        {
            printf("[DRAZVIO REGISTER] Interrupted registration for playerid=%d; inspect .regnew manually.", playerid);
            return 0;
        }
		new File: hFile = fopen(dz_regstage, io_write);
		if (hFile)
		{
			new var[256];
			PlayerInfo[playerid][pReg] = 0;
			format(var, sizeof(var), "Key=%s\n",PlayerInfo[playerid][pKey]);fwrite(hFile, var);
			format(var, sizeof(var), "TDReg=%s\n",PlayerInfo[playerid][pTDReg]);fwrite(hFile, var);
			format(var, sizeof(var), "IPAdr=%s\n",PlayerInfo[playerid][pIPAdr]);fwrite(hFile, var);
			format(var, sizeof(var), "MinLog=%d\n",PlayerInfo[playerid][pMinlog]);fwrite(hFile, var);
			format(var, sizeof(var), "AdminLevel=%d\n",PlayerInfo[playerid][pAdmin]);fwrite(hFile, var);
			format(var, sizeof(var), "AdminShadow=%d\n",PlayerInfo[playerid][pAdmshad]);fwrite(hFile, var);
			format(var, sizeof(var), "AdminLive=%d\n",PlayerInfo[playerid][pAdmlive]);fwrite(hFile, var);
			format(var, sizeof(var), "AdminScanCom=%d\n",PlayerInfo[playerid][pAdmscancom]);fwrite(hFile, var);
			format(var, sizeof(var), "Registered=%d\n",PlayerInfo[playerid][pReg]);fwrite(hFile, var);
			format(var, sizeof(var), "Prison=%d\n",PlayerInfo[playerid][pPrison]);fwrite(hFile, var);
			format(var, sizeof(var), "Prisonsec=%d\n",PlayerInfo[playerid][pPrisonsec]);fwrite(hFile, var);
			format(var, sizeof(var), "Muted=%d\n",PlayerInfo[playerid][pMuted]);fwrite(hFile, var);
			format(var, sizeof(var), "Mutedsec=%d\n",PlayerInfo[playerid][pMutedsec]);fwrite(hFile, var);
			format(var, sizeof(var), "Money=%d\n",GetPVarInt(playerid, "PlMon"));fwrite(hFile, var);
			format(var, sizeof(var), "Kills=%d\n",PlayerInfo[playerid][pKills]);fwrite(hFile, var);
			format(var, sizeof(var), "Deaths=%d\n",PlayerInfo[playerid][pDeaths]);fwrite(hFile, var);
			format(var, sizeof(var), "VIP=%d\n",PlayerInfo[playerid][pVIP]);fwrite(hFile, var);
			format(var, sizeof(var), "Deport=%d\n",PlayerInfo[playerid][pDeport]);fwrite(hFile, var);
			format(var, sizeof(var), "RecPM=%d\n",PlayerInfo[playerid][pRecPM]);fwrite(hFile, var);
			format(var, sizeof(var), "Wanted=%d\n",PlayerInfo[playerid][pWanted]);fwrite(hFile, var);
			format(var, sizeof(var), "Lock=%d\n",PlayerInfo[playerid][pLock]);fwrite(hFile, var);
			format(var, sizeof(var), "Gang=%d\n",PGang[playerid]);fwrite(hFile, var);
			format(var, sizeof(var), "GangLvl=%d\n",GangLvl[playerid]);fwrite(hFile, var);
//----------- вставить группу строк (изменения от 25.12.2015) ------------------
			format(var, sizeof(var), "FragSlvl=%d\n",PlayerInfo[playerid][pFragSlvl]);fwrite(hFile, var);
			format(var, sizeof(var), "FragTlvl=%d\n",PlayerInfo[playerid][pFragTlvl]);fwrite(hFile, var);
			format(var, sizeof(var), "FragBlvl=%d\n",PlayerInfo[playerid][pFragBlvl]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach0=%d\n",PlayerInfo[playerid][pDostig]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach1=%d\n",PlayerInfo[playerid][pDostigg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach2=%d\n",PlayerInfo[playerid][pDostiggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach3=%d\n",PlayerInfo[playerid][pDostigggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach4=%d\n",PlayerInfo[playerid][pDostiggggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach5=%d\n",PlayerInfo[playerid][pDostigggggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach6=%d\n",PlayerInfo[playerid][pDostiggggggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach7=%d\n",PlayerInfo[playerid][pDostigggggggg]);fwrite(hFile, var);
//------------------ (изменения от 25.12.2015) конец ---------------------------
			fclose(hFile);
            if(!DZ_AccountSnapshotValid(dz_regstage, playerid))
            {
                printf("[DRAZVIO REGISTER] Invalid staged account playerid=%d; .regnew preserved.", playerid);
                return 0;
            }
            if(fexist(string3)) return 0; // Never replace another account.
            // Stage 10: move a validated new file into its FINAL name.
            // Do not copy/truncate the live file; there is no pre-existing account.
            if(!fileMove(dz_regstage, string3))
            {
                printf("[DRAZVIO REGISTER] Cannot move staged account playerid=%d; .regnew preserved.", playerid);
                return 0;
            }
            if(!DZ_AccountSnapshotValid(string3, playerid))
            {
                printf("[DRAZVIO REGISTER] Post-move account check failed playerid=%d; inspect disk manually.", playerid);
                return 0;
            }
            ac_1{playerid} = false;
			OnPlayerLogin(playerid,password);
		}
        else
        {
            printf("[DRAZVIO REGISTER] Cannot open .regnew for playerid=%d.", playerid);
            return 0;
        }
#endif
#if (MOD90INS == 1)
		if (!DZ_SetPassword(playerid, password)) return 0;
		PlayerInfo[playerid][pReg] = 0;
		new s01[256], s02[256], s03[256], s04[256], s05[256], s06[256], saa[1536];
//		new s11[256], s12[256], s13[256], s14[256], s15[256], s16[256], sbb[1536];//удалить строку (изменения от 25.12.2015)
		new s11[256], s12[256], s13[256], s14[256], s15[256], s16[256], s17[256], sbb[1536];//вставить строку (изменения от 25.12.2015)
		new s00[3072];//создаём запрос БД
		format(s01, 256, "INSERT INTO Players (IDCopy,Name,Key,TDReg,DEndConD,DEndConM,DEndConY,IPAdr,MinLog,AdminLevel,");
		format(s02, 256, "AdminShadow,AdminLive,AdminScanCom,Registered,Prison,Prisonsec,Muted,Mutedsec,Money,Kills,Deaths,");
//		format(s03, 256, "VIP,Deport,RecPM,Wanted,Lock,Gang,GangLvl) ");//удалить строку (изменения от 25.12.2015)
		format(s03, 256, "VIP,Deport,RecPM,Wanted,Lock,Gang,GangLvl,FragSlvl,FragTlvl,FragBlvl) ");//вставить строку (изменения от 25.12.2015)
		format(s04, 256, "VALUES (1,'%s','%s','%s',",RealName[playerid],PlayerInfo[playerid][pKey],PlayerInfo[playerid][pTDReg]);
		format(s05, 256, "%d,%d,%d,'%s',",EndConD,EndConM,EndConY,PlayerInfo[playerid][pIPAdr]);
		format(s06, 256, "%d,%d,%d,",PlayerInfo[playerid][pMinlog],PlayerInfo[playerid][pAdmin],PlayerInfo[playerid][pAdmshad]);
		format(s11, 256, "%d,%d,%d,",PlayerInfo[playerid][pAdmlive],PlayerInfo[playerid][pAdmscancom],PlayerInfo[playerid][pReg]);
		format(s12, 256, "%d,%d,%d,",PlayerInfo[playerid][pPrison],PlayerInfo[playerid][pPrisonsec],PlayerInfo[playerid][pMuted]);
		format(s13, 256, "%d,%d,%d,",PlayerInfo[playerid][pMutedsec],GetPVarInt(playerid, "PlMon"),PlayerInfo[playerid][pKills]);
		format(s14, 256, "%d,%d,%d,",PlayerInfo[playerid][pDeaths],PlayerInfo[playerid][pVIP],PlayerInfo[playerid][pDeport]);
		format(s15, 256, "%d,%d,%d,",PlayerInfo[playerid][pRecPM],PlayerInfo[playerid][pWanted],PlayerInfo[playerid][pLock]);
//		format(s16, 256, "%d,%d)",PGang[playerid],GangLvl[playerid]);//удалить строку (изменения от 25.12.2015)
//----------- вставить группу строк (изменения от 25.12.2015) ------------------
		format(s16, 256, "%d,%d,",PGang[playerid],GangLvl[playerid]);
		format(s17, 256, "%d,%d,%d)",PlayerInfo[playerid][pFragSlvl],PlayerInfo[playerid][pFragTlvl],PlayerInfo[playerid][pFragBlvl]);//вставить строку (изменения от 25.12.2015)
//------------------ (изменения от 25.12.2015) конец ---------------------------
		format(saa, 1536, "%s%s%s%s%s%s", s01, s02, s03, s04, s05, s06);
//		format(sbb, 1536, "%s%s%s%s%s%s", s11, s12, s13, s14, s15, s16);//удалить строку (изменения от 25.12.2015)
		format(sbb, 1536, "%s%s%s%s%s%s%s", s11, s12, s13, s14, s15, s16, s17);//вставить строку (изменения от 25.12.2015)
		format(s00, 3072, "%s%s", saa, sbb);
		db_query(playerdb, s00);//отправляем запрос на добавление нового аккаунта в БД

		OnPlayerLogin(playerid,password);
#endif
	}
	return 1;
}

public OnPlayerSaveA(playerid)
{
	if(playerid >= 0 && playerid < MAX_PLAYERS)
	{
		if(gPlayerLogged[playerid])
		{
#if (MOD90INS == 0)
			new string3[64];
//			new playername3[MAX_PLAYER_NAME];
//			GetPlayerName(playerid, playername3, sizeof(playername3));
			format(string3, sizeof(string3), "players/%s.ini", RealName[playerid]);//реальный ник игрока
//			format(string3, sizeof(string3), "players/%s.ini", playername3);
//			format(string3, sizeof(string3), "%s.ini", playername3);
            // Stage 8: fail closed if a previous staged write needs recovery.
            // Never remove .savenew automatically after a crash.
            new dz_backup[80], dz_stage[80], dz_swapold[80], dz_oldKey[128];
            format(dz_backup, sizeof(dz_backup), "%s.bak", string3);
            format(dz_stage, sizeof(dz_stage), "%s.savenew", string3);
            format(dz_swapold, sizeof(dz_swapold), "%s.swapold", string3);
            // Stage 10: an interrupted file switch needs manual recovery.
            if(fexist(dz_swapold))
            {
                printf("[DRAZVIO SAVE] Unresolved .swapold playerid=%d; refusing write.", playerid);
                return 0;
            }
            if(fexist(dz_stage))
            {
                printf("[DRAZVIO SAVE] Unresolved .savenew playerid=%d; refusing write.", playerid);
                return 0;
            }
            if(!fexist(string3) || !dini_Isset(string3, "Key") || !dini_Isset(string3, "Registered"))
            {
                printf("[DRAZVIO SAVE] Missing/invalid live account playerid=%d; refusing write.", playerid);
                return 0;
            }
            // Compare backup against the DISK key, not the in-memory key: the
            // latter may have legitimately changed during password migration.
            format(dz_oldKey, sizeof(dz_oldKey), "%s", dini_Get(string3, "Key"));
            new dz_oldMoney = dini_Int(string3, "Money");
            new dz_oldReg = dini_Int(string3, "Registered");
            if(!strlen(dz_oldKey) || !fcopytextfile(string3, dz_backup) ||
               !DZ_FileHasValue(dz_backup, "Key", dz_oldKey) ||
               !dini_Isset(dz_backup, "Money") || dini_Int(dz_backup, "Money") != dz_oldMoney ||
               !dini_Isset(dz_backup, "Registered") || dini_Int(dz_backup, "Registered") != dz_oldReg)
            {
                printf("[DRAZVIO SAVE] Account backup failed playerid=%d; refusing write.", playerid);
                return 0;
            }
            new File: hFile = fopen(dz_stage, io_write);
			if (hFile)
			{
				new var[256];
				format(var, sizeof(var), "Key=%s\n",PlayerInfo[playerid][pKey]);fwrite(hFile, var);
				format(var, sizeof(var), "TDReg=%s\n",PlayerInfo[playerid][pTDReg]);fwrite(hFile, var);
				format(var, sizeof(var), "IPAdr=%s\n",PlayerInfo[playerid][pIPAdr]);fwrite(hFile, var);
				format(var, sizeof(var), "MinLog=%d\n",PlayerInfo[playerid][pMinlog]);fwrite(hFile, var);
				format(var, sizeof(var), "AdminLevel=%d\n",PlayerInfo[playerid][pAdmin]);fwrite(hFile, var);
				format(var, sizeof(var), "AdminShadow=%d\n",PlayerInfo[playerid][pAdmshad]);fwrite(hFile, var);
				format(var, sizeof(var), "AdminLive=%d\n",PlayerInfo[playerid][pAdmlive]);fwrite(hFile, var);
				format(var, sizeof(var), "AdminScanCom=%d\n",PlayerInfo[playerid][pAdmscancom]);fwrite(hFile, var);
				format(var, sizeof(var), "Registered=%d\n",PlayerInfo[playerid][pReg]);fwrite(hFile, var);
				format(var, sizeof(var), "Prison=%d\n",PlayerInfo[playerid][pPrison]);fwrite(hFile, var);
				format(var, sizeof(var), "Prisonsec=%d\n",PlayerInfo[playerid][pPrisonsec]);fwrite(hFile, var);
				format(var, sizeof(var), "Muted=%d\n",PlayerInfo[playerid][pMuted]);fwrite(hFile, var);
				format(var, sizeof(var), "Mutedsec=%d\n",PlayerInfo[playerid][pMutedsec]);fwrite(hFile, var);
				format(var, sizeof(var), "Money=%d\n",GetPVarInt(playerid, "PlMon"));fwrite(hFile, var);
				format(var, sizeof(var), "Kills=%d\n",PlayerInfo[playerid][pKills]);fwrite(hFile, var);
				format(var, sizeof(var), "Deaths=%d\n",PlayerInfo[playerid][pDeaths]);fwrite(hFile, var);
				format(var, sizeof(var), "VIP=%d\n",PlayerInfo[playerid][pVIP]);fwrite(hFile, var);
				format(var, sizeof(var), "Deport=%d\n",PlayerInfo[playerid][pDeport]);fwrite(hFile, var);
				format(var, sizeof(var), "RecPM=%d\n",PlayerInfo[playerid][pRecPM]);fwrite(hFile, var);
				format(var, sizeof(var), "Wanted=%d\n",PlayerInfo[playerid][pWanted]);fwrite(hFile, var);
				format(var, sizeof(var), "Lock=%d\n",PlayerInfo[playerid][pLock]);fwrite(hFile, var);
				format(var, sizeof(var), "Gang=%d\n",PGang[playerid]);fwrite(hFile, var);
				format(var, sizeof(var), "GangLvl=%d\n",GangLvl[playerid]);fwrite(hFile, var);
//----------- вставить группу строк (изменения от 25.12.2015) ------------------
				format(var, sizeof(var), "FragSlvl=%d\n",PlayerInfo[playerid][pFragSlvl]);fwrite(hFile, var);
				format(var, sizeof(var), "FragTlvl=%d\n",PlayerInfo[playerid][pFragTlvl]);fwrite(hFile, var);
				format(var, sizeof(var), "FragBlvl=%d\n",PlayerInfo[playerid][pFragBlvl]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach0=%d\n",PlayerInfo[playerid][pDostig]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach1=%d\n",PlayerInfo[playerid][pDostigg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach2=%d\n",PlayerInfo[playerid][pDostiggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach3=%d\n",PlayerInfo[playerid][pDostigggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach4=%d\n",PlayerInfo[playerid][pDostiggggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach5=%d\n",PlayerInfo[playerid][pDostigggggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach6=%d\n",PlayerInfo[playerid][pDostiggggggg]);fwrite(hFile, var);
			format(var, sizeof(var), "DZ_Ach7=%d\n",PlayerInfo[playerid][pDostigggggggg]);fwrite(hFile, var);
//------------------ (изменения от 25.12.2015) конец ---------------------------
                fclose(hFile);
                // Validate ALL saved fields before touching the live account.
                if(!DZ_AccountSnapshotValid(dz_stage, playerid))
                {
                    printf("[DRAZVIO SAVE] Staged account incomplete playerid=%d; .savenew preserved.", playerid);
                    return 0;
                }
                // Stage 10: two file moves instead of in-place truncation.
                // The gap between moves is NOT an atomic cross-file transaction;
                // .swapold and .bak are intentionally retained on any failure.
                if(!fileMove(string3, dz_swapold))
                {
                    printf("[DRAZVIO SAVE] Cannot park current .ini playerid=%d; .bak and .savenew preserved.", playerid);
                    return 0;
                }
                if(!fileMove(dz_stage, string3))
                {
                    printf("[DRAZVIO SAVE] Cannot publish .savenew playerid=%d; attempting old account rollback.", playerid);
                    if(!fexist(string3) && !fileMove(dz_swapold, string3))
                        printf("[DRAZVIO SAVE] CRITICAL: rollback failed playerid=%d; recover .swapold manually!", playerid);
                    return 0;
                }
                if(!DZ_AccountSnapshotValid(string3, playerid))
                {
                    printf("[DRAZVIO SAVE] Post-move verification failed playerid=%d; recover using .swapold/.bak.", playerid);
                    return 0;
                }
                // A successful commit preserves .bak, removes obsolete parked copy.
                if(!fileRemove(dz_swapold))
                    printf("[DRAZVIO SAVE] WARNING: .swapold could not be removed playerid=%d; inspect before next save.", playerid);
            }
            else
            {
                printf("[DRAZVIO SAVE] Account write failed for playerid=%d; see .bak file.", playerid);
                return 0;
            }
#endif
#if (MOD90INS == 1)
			new s01[256], s02[256], s03[256], s04[256], s05[256], s06[256], saa[1536];
//			new s11[256], s12[256], s13[256], s14[256], s15[256], s16[256], s17[256], sbb[1792];//удалить строку (изменения от 25.12.2015)
			new s11[256], s12[256], s13[256], s14[256], s15[256], s16[256], s17[256], s18[256], sbb[1792];//вставить строку (изменения от 25.12.2015)
			new s00[3328];//создаём запрос БД
			format(s01, 256, "UPDATE Players SET Key = '%s',TDReg = '%s',",PlayerInfo[playerid][pKey],PlayerInfo[playerid][pTDReg]);
			format(s02, 256, "DEndConD = %d,DEndConM = %d,DEndConY = %d,",EndConD,EndConM,EndConY);
			format(s03, 256, "IPAdr = '%s',MinLog = %d,",PlayerInfo[playerid][pIPAdr],PlayerInfo[playerid][pMinlog]);
			format(s04, 256, "AdminLevel = %d,AdminShadow = %d,",PlayerInfo[playerid][pAdmin],PlayerInfo[playerid][pAdmshad]);
			format(s05, 256, "AdminLive = %d,AdminScanCom = %d,",PlayerInfo[playerid][pAdmlive],PlayerInfo[playerid][pAdmscancom]);
			format(s06, 256, "Registered = %d,Prison = %d,",PlayerInfo[playerid][pReg],PlayerInfo[playerid][pPrison]);
			format(s11, 256, "Prisonsec = %d,Muted = %d,",PlayerInfo[playerid][pPrisonsec],PlayerInfo[playerid][pMuted]);
			format(s12, 256, "Mutedsec = %d,Money = %d,",PlayerInfo[playerid][pMutedsec],GetPVarInt(playerid, "PlMon"));
			format(s13, 256, "Kills = %d,Deaths = %d,",PlayerInfo[playerid][pKills],PlayerInfo[playerid][pDeaths]);
			format(s14, 256, "VIP = %d,Deport = %d,",PlayerInfo[playerid][pVIP],PlayerInfo[playerid][pDeport]);
			format(s15, 256, "RecPM = %d,Wanted = %d,",PlayerInfo[playerid][pRecPM],PlayerInfo[playerid][pWanted]);
//			format(s16, 256, "Lock = %d,Gang = %d,GangLvl = %d ",PlayerInfo[playerid][pLock],PGang[playerid],GangLvl[playerid]);//удалить строку (изменения от 25.12.2015)
//----------- вставить группу строк (изменения от 25.12.2015) ------------------
			format(s16, 256, "Lock = %d,Gang = %d,GangLvl = %d,",PlayerInfo[playerid][pLock],PGang[playerid],GangLvl[playerid]);
			format(s18, 256, "FragSlvl = %d,FragTlvl = %d,FragBlvl = %d ",PlayerInfo[playerid][pFragSlvl],PlayerInfo[playerid][pFragTlvl],PlayerInfo[playerid][pFragBlvl]);
//------------------ (изменения от 25.12.2015) конец ---------------------------
			format(s17, 256, "WHERE (Name = '%s')",RealName[playerid]);
			format(saa, 1536, "%s%s%s%s%s%s", s01, s02, s03, s04, s05, s06);
