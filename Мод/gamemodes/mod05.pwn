stock DZ_DriftReward(points, combo)
{
    if (points <= 0 || combo <= 0) return 0;
    if (points > DZ_MAX_DRIFT_REWARD / combo) return DZ_MAX_DRIFT_REWARD;
    return points * combo;
}
