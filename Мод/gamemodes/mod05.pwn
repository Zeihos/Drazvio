					SetPVarInt(player[playerid], "SecPris", PlayerInfo[player[playerid]][pPrisonsec]);//записываем в глобальную переменную секунды тюрьмы
					OnPlayerSpawn(player[playerid]);//респавн игрока
				}
				else
