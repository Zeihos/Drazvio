forward StartViktorina();
public StartViktorina()
{
new str[128],a,b;
a = random(vMaxN);
b = random(vMaxN);
Viktorina = a + b;
format(str,sizeof str,"{FFA500}Викторина: {ffffff}Сколько будет {FFA500}%d{ffffff} + {FFA500}%d{ffffff} ? {BEBEBE}(Ответ писать в чат)",a,b);
SendClientMessageToAll(1,str);
return 1;
}
stock IsTextUppercase(const text[])
{
	new len = strlen(text), count;
	for(new i = len - 1; i != -1; --i)
	{
		if('A' <= text[i] <= 'Z' || 'А' <= text[i] <= 'Я' || text[i] == 'Ё') count++;
	}
	if((float(count) / float(len)) * 100.0 > MAX_UPPERCASE_PERSENT) return 1;
	return 0;
}

stock UpperToLowerWithoutCapLetters(text[])
{
	for(new i, bool:cap = true, len = strlen(text); i < len; i++)
	{
		switch(text[i])
		{
			case '.', '!', '?', ';', '_', '-', ' ', 'A'..'Z': cap = true;
			case 'a'..'z', 'а'..'я', 'ё': cap = false;
			case 'А'..'Я':
			{
				if(cap) cap = false;
				else text[i] += 32;
			}
			case 'Ё':
			{
				if(cap) cap = false;
				else text[i] = 'ё';
			}
		}
	}
	return 1;
}

stock UpperToLower(text[])
{
	for(new i = strlen(text) - 1; i != -1; --i)
	{
		switch(text[i])
		{
			case 'A'..'Z', 'А'..'Я': text[i] += 32;
			case 'Ё': text[i] = 'ё';
		}
	}
	return 1;
}
stock IsPlayerApplyAnimation(playerid, animation[])
{
    if(!GetPlayerAnimationIndex(playerid)) return 0;
    new animlib[32], animname[32];
    GetAnimationName(GetPlayerAnimationIndex(playerid), animlib, sizeof(animlib), animname, sizeof(animname));
    if(strcmp(animname, animation, true) == 0) return 1;
	return 0;
}
public Gunjobanim(playerid)
{
        RemovePlayerAttachedObject(playerid,3);
        ApplyAnimation(playerid,"PED","IDLE_tired",4.1,0,1,1,0,1);
        ApplyAnimation(playerid,"CARRY","crry_prtial",4.1,0,1,1,1,1);

        SetPlayerAttachedObject(playerid,3,2969,1,0.075578,0.407083,0.000000,1.248928,97.393852,359.645050,1.000000,1.000000,1.000000);
        SetPVarInt(playerid, "Gjob",3);
        SendClientMessage(playerid, COLOR_LIGHTGREEN, "Оружие собрано. Следуйте к складу.");
        SetPlayerCheckpoint(playerid,-2163.6130,-230.5670,36.5156,1.5);
        return 1;
}

stock Nome(playerid)
{
    new name[MAX_PLAYER_NAME];
    GetPlayerName(playerid, name, MAX_PLAYER_NAME);
    return name;
}

forward IsVehicleOccupiedCar(vehicleid);
public IsVehicleOccupiedCar(vehicleid)
{
    for(new i=0;i<MAX_PLAYERS;i++)
    {
        if(IsPlayerInVehicle(i,vehicleid)) return 1;
    }
    return 0;
}

public PlayerUpdate()
{
        for(new Player; Player < GetMaxPlayers(); Player++)
        {
            if(IsPlayerConnected(Player) && GetPlayerState(Player) == PLAYER_STATE_DRIVER && VehicleIsCar(GetPlayerVehicleID(Player))) GetVehiclePos(GetPlayerVehicleID(Player),PlayerPositionX[Player],PlayerPositionY[Player],PlayerPositionZ[Player]);
        }
        return 1;
}

public PlayerDrift()
{
        for(new Player; Player < GetMaxPlayers(); Player++)
        {
            if(IsPlayerConnected(Player) && GetPlayerState(Player) == PLAYER_STATE_DRIVER && VehicleIsCar(GetPlayerVehicleID(Player)))
            {
                new Float:Angle;
                GetVehicleZAngle(GetPlayerVehicleID(Player),Angle);
                        if(floatabs(floatsub(Angle,PlayerTheoreticAngle(Player))) < 90.0 && floatabs(floatsub(Angle,PlayerTheoreticAngle(Player))) > 10.0 && VehicleSpeeed(GetPlayerVehicleID(Player)) < 300 && VehicleSpeeed(GetPlayerVehicleID(Player)) > 30)
                        {
                            if(PlayerMoney[Player] == 0 && PlayerCombo[Player] == 1)
                            {
                                TextDrawShowForPlayer(Player,ServerTextDrawTwo);
                                TextDrawShowForPlayer(Player,ServerTextDrawThree[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFour[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFive[Player]);
                                        TextDrawSetString(ServerTextDrawThree[Player]," ");
                                        TextDrawSetString(ServerTextDrawFour[Player]," ");
                                        TextDrawSetString(ServerTextDrawFive[Player]," ");
                            }
                            if(PlayerMoney[Player] == 0 && PlayerCombo[Player] == 2)
                            {
                                TextDrawShowForPlayer(Player,ServerTextDrawTwo);
                                TextDrawShowForPlayer(Player,ServerTextDrawThree[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFour[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFive[Player]);
                                        TextDrawSetString(ServerTextDrawThree[Player]," ");
                                        TextDrawSetString(ServerTextDrawFour[Player]," ");
                                        TextDrawSetString(ServerTextDrawFive[Player]," ");
                            }
                            if(PlayerMoney[Player] == 0 && PlayerCombo[Player] == 4)
                            {
                                TextDrawShowForPlayer(Player,ServerTextDrawTwo);
                                TextDrawShowForPlayer(Player,ServerTextDrawThree[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFour[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFive[Player]);
                                        TextDrawSetString(ServerTextDrawThree[Player]," ");
                                        TextDrawSetString(ServerTextDrawFour[Player]," ");
                                        TextDrawSetString(ServerTextDrawFive[Player]," ");
                            }
                            if(PlayerMoney[Player] == 0 && PlayerCombo[Player] == 6)
                            {
                                TextDrawShowForPlayer(Player,ServerTextDrawTwo);
                                TextDrawShowForPlayer(Player,ServerTextDrawThree[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFour[Player]);
                                TextDrawShowForPlayer(Player,ServerTextDrawFive[Player]);
                                        TextDrawSetString(ServerTextDrawThree[Player]," ");
                                        TextDrawSetString(ServerTextDrawFour[Player]," ");
                                        TextDrawSetString(ServerTextDrawFive[Player]," ");
                            }
                            new dz_inc = floatround(floatabs(floatsub(Angle, PlayerTheoreticAngle(Player))) * (VehicleSpeeed(GetPlayerVehicleID(Player)) * 0.1)) / 15;
                            if (dz_inc > 10000) dz_inc = 10000;
                            if (dz_inc > 0)
                            {
                                if (PlayerMoney[Player] > DZ_MAX_DRIFT_REWARD - dz_inc) PlayerMoney[Player] = DZ_MAX_DRIFT_REWARD;
                                else PlayerMoney[Player] += dz_inc;
                            }
                                new String[100];
                                if(PlayerInfo[Player][pVIP] == 0) PlayerCombo[Player] = 1;
                                if(PlayerInfo[Player][pVIP] == 1) PlayerCombo[Player] = 2;
                                if(PlayerInfo[Player][pVIP] == 2) PlayerCombo[Player] = 4;
                                if(PlayerInfo[Player][pVIP] == 3) PlayerCombo[Player] = 6;
                                format(String,sizeof(String),FixText("~R~~H~Денег за дрифт: ~W~~H~%d$"),DZ_DriftReward(PlayerMoney[Player], PlayerCombo[Player]));
                                TextDrawSetString(ServerTextDrawFour[Player],String);
                                format(String,sizeof(String),FixText("~R~~H~Умножение: ~W~~H~X%d"),PlayerCombo[Player]);
                                TextDrawSetString(ServerTextDrawFive[Player],String);
                                KillTimer(PlayerTimerOne[Player]);
                            PlayerTimerOne[Player] = SetTimerEx("DZ_Guard_PlayerDriftEnd", 3000, 0, "di", Player, DZ_EpochAt(Player));
									}
                        }
            }
        }

public PlayerDriftEnd(Player)
{
    if (Player < 0 || Player >= MAX_PLAYERS || !IsPlayerConnected(Player) || !gPlayerLogged[Player]) return 1;
    DriftPointsNow[Player] = DZ_DriftReward(PlayerMoney[Player], PlayerCombo[Player]);
        TextDrawHideForPlayer(Player,ServerTextDrawTwo);
    TextDrawHideForPlayer(Player,ServerTextDrawThree[Player]);
        TextDrawHideForPlayer(Player,ServerTextDrawFour[Player]);
        TextDrawHideForPlayer(Player,ServerTextDrawFive[Player]);
        TextDrawSetString(ServerTextDrawThree[Player]," ");
        TextDrawSetString(ServerTextDrawFour[Player]," ");
        TextDrawSetString(ServerTextDrawFive[Player]," ");
        new dz_balance = GetPVarInt(Player, "PlMon");
    if (dz_balance < 0) dz_balance = 0;
    if (dz_balance > DZ_MAX_BALANCE - DriftPointsNow[Player]) dz_balance = DZ_MAX_BALANCE;
    else dz_balance += DriftPointsNow[Player];
    SetPVarInt(Player, "PlMon", dz_balance);
        PlayerMoney[Player] = 0;
        if(PlayerInfo[Player][pVIP] == 0) PlayerCombo[Player] = 1;
        if(PlayerInfo[Player][pVIP] == 1) PlayerCombo[Player] = 2;
        if(PlayerInfo[Player][pVIP] == 2) PlayerCombo[Player] = 4;
        if(PlayerInfo[Player][pVIP] == 3) PlayerCombo[Player] = 6;
        return 1;
}

stock containsAnyIP ( string[] )
{
    new digits, digitGroups;

    for ( new pos; ; pos++ )
    {
        switch ( string[pos] )
        {
            case 0 : break;
            case '0'..'9', 'o', 'O', 'о', 'О', 'З', 'з' : digits++;
            default :
            {
                if ( digits >= 2 )
                {
                    digitGroups++;
                    digits = 0;
                }
            }
        }
    }

    if ( digits >= 2 ) digitGroups++;
    if ( digitGroups >= 4 ) return 1;

    return 0;
}




stock FixText(string[]) {
        new result[256];
		for(new i=0; i < 256; i++) {
			switch(string[i]) {
				case 'а':result[i] = 'a';
				case 'А':result[i] = 'A';
				case 'б':result[i] = '—';
