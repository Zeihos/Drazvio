    if(!DZ_AccountIntEquals(file, "Muted", PlayerInfo[playerid][pMuted])) return 0;
    if(!DZ_AccountIntEquals(file, "Mutedsec", PlayerInfo[playerid][pMutedsec])) return 0;
    if(!DZ_AccountIntEquals(file, "Money", GetPVarInt(playerid, "PlMon"))) return 0;
    if(!DZ_AccountIntEquals(file, "Kills", PlayerInfo[playerid][pKills])) return 0;
    if(!DZ_AccountIntEquals(file, "Deaths", PlayerInfo[playerid][pDeaths])) return 0;
    if(!DZ_AccountIntEquals(file, "VIP", PlayerInfo[playerid][pVIP])) return 0;
    if(!DZ_AccountIntEquals(file, "Deport", PlayerInfo[playerid][pDeport])) return 0;
    if(!DZ_AccountIntEquals(file, "RecPM", PlayerInfo[playerid][pRecPM])) return 0;
    if(!DZ_AccountIntEquals(file, "Wanted", PlayerInfo[playerid][pWanted])) return 0;
    if(!DZ_AccountIntEquals(file, "Lock", PlayerInfo[playerid][pLock])) return 0;
    if(!DZ_AccountIntEquals(file, "Gang", PGang[playerid])) return 0;
    if(!DZ_AccountIntEquals(file, "GangLvl", GangLvl[playerid])) return 0;
    if(!DZ_AccountIntEquals(file, "FragSlvl", PlayerInfo[playerid][pFragSlvl])) return 0;
    if(!DZ_AccountIntEquals(file, "FragTlvl", PlayerInfo[playerid][pFragTlvl])) return 0;
    if(!DZ_AccountIntEquals(file, "FragBlvl", PlayerInfo[playerid][pFragBlvl])) return 0;
    if(!DZ_AccountIntEquals(file, "DZ_Ach0", PlayerInfo[playerid][pDostig])) return 0;
    if(!DZ_AccountIntEquals(file, "DZ_Ach1", PlayerInfo[playerid][pDostigg])) return 0;
    if(!DZ_AccountIntEquals(file, "DZ_Ach2", PlayerInfo[playerid][pDostiggg])) return 0;
    if(!DZ_AccountIntEquals(file, "DZ_Ach3", PlayerInfo[playerid][pDostigggg])) return 0;
    if(!DZ_AccountIntEquals(file, "DZ_Ach4", PlayerInfo[playerid][pDostiggggg])) return 0;
    if(!DZ_AccountIntEquals(file, "DZ_Ach5", PlayerInfo[playerid][pDostigggggg])) return 0;
