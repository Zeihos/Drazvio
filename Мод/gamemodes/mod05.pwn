stock DZ_ShowTop10(playerid, mode)
{
    new topID[10], topValue[10];
    for (new n = 0; n < 10; n++) topID[n] = INVALID_PLAYER_ID;
    for (new i = 0, slots = GetMaxPlayers(); i < slots && i < MAX_PLAYERS; i++)
    {
        if (!IsPlayerConnected(i) || !gPlayerLogged[i]) continue;
        new score = 0;
        if (mode == 0) score = PlayerInfo[i][pKills];
        else if (mode == 1) score = GetPVarInt(i, "PlMon");
        else score = PlayerInfo[i][pMinlog];
        for (new j = 0; j < 10; j++)
        {
            if (topID[j] == INVALID_PLAYER_ID || score > topValue[j])
            {
                for (new k = 9; k > j; k--)
                {
                    topID[k] = topID[k - 1];
                    topValue[k] = topValue[k - 1];
                }
                topID[j] = i;
                topValue[j] = score;
                break;
            }
        }
    }
    new output[1536], row[128], nickname[MAX_PLAYER_NAME];
    for (new i = 0; i < 10; i++)
    {
        if (topID[i] == INVALID_PLAYER_ID)
        {
            format(row, sizeof(row), "{c0c0c0}%d место: {FFFFFF}Нет игрока\n", i + 1);
        }
        else
        {
            GetPlayerName(topID[i], nickname, sizeof(nickname));
            format(row, sizeof(row), "{c0c0c0}%d место: {FFFFFF}%s [ID: %d], %d\n", i + 1, nickname, topID[i], topValue[i]);
        }
        strcat(output, row, sizeof(output));
    }
    if (mode == 0) return ShowPlayerDialog(playerid, 6666, DIALOG_STYLE_MSGBOX, "DRAZVIO | Топ 10 убийств", output, "Закрыть", "");
    if (mode == 1) return ShowPlayerDialog(playerid, 6666, DIALOG_STYLE_MSGBOX, "DRAZVIO | Топ 10 балансов", output, "Закрыть", "");
    return ShowPlayerDialog(playerid, 6666, DIALOG_STYLE_MSGBOX, "DRAZVIO | Топ 10 времени", output, "Закрыть", "");
}
stock Top10killers(playerid) { return DZ_ShowTop10(playerid, 0); }
stock Top10rich(playerid) { return DZ_ShowTop10(playerid, 1); }
stock Top10minutes(playerid) { return DZ_ShowTop10(playerid, 2); }
stock BOP(word[])
{
	if(strlen(word)>22) return 0;
	if(strfind(word,"?", true)==-1) return 0;

	new ip[5][256],index;
	ip[0] = strtook(word,index,'?');
	ip[1] = strtook(word,index,'?');
	ip[2] = strtook(word,index,'?');
	if(strfind(word,":",true)>0){
		ip[3] = strtook(word,index,':');
		if(strfind(word,",",true)>0) ip[4] = strtook(word,index,',');else ip[4] = strtook(word,index);
	} else {
		if(strfind(word,",",true)==strlen(word)) ip[3] = strtook(word,index,',');else ip[3] = strtook(word,index);
		valstr(ip[4],0);
	}
	if(!iscifra(ip[0])||!iscifra(ip[1])||!iscifra(ip[2])||!iscifra(ip[3])||!iscifra(ip[4])
		||!strlen(ip[0])||!strlen(ip[1])||!strlen(ip[2])||!strlen(ip[3])||!strlen(ip[4])
		||(strval(ip[0])==192&&strval(ip[1])==168)
		||(strval(ip[0])==172&&strval(ip[1])>=16&&strval(ip[1])<=31)
		||strval(ip[0])==10||(strval(ip[0])==127&&strval(ip[1])==0&&strval(ip[2])==0&&strval(ip[3])==1)) return 0;
	return 1;
}
strtook(string[],&idx,seperator = ' ')
{
	new ret[128], i = 0, len = strlen(string);
	while(string[idx] == seperator && idx < len) idx++;
	while(idx < len && string[idx] != seperator)
    {
        if (i < sizeof(ret) - 1) ret[i++] = string[idx];
        idx++;
    }
    ret[i] = EOS;
	while(string[idx] == seperator && idx < len) idx++;
	return ret;
}

stock iscifra(string[]) { for (new i = 0, j = strlen(string); i < j; i++) if (string[i] > '9' || string[i] < '0') return 0; return 1; }
