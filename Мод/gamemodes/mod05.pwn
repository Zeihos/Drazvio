					db_query(playerdb, dstring);//отправляем запрос на удаление аккаунта (аккаунтов) из БД (если такой аккаунт (такие аккаунты) УЖЕ есть в БД)

					new s01[256], s02[256], s03[256], s04[256], s05[256], s06[256], saa[1536];
