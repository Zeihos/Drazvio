					if(PlayerInfo[playerid][pVIP] == 3) { printf(" <AC> VIP-3 %s [%d] (%d LVL): %s", aa333, playerid, PlayerInfo[playerid][pVIP], result); }//доработка для использования Русских ников
					if(PlayerInfo[playerid][pVIP] == 1) { format(string, sizeof(string), " <AC> VIP-1 %s [%d] (%d LVL): {FF0000}%s", sendername, playerid, PlayerInfo[playerid][pVIP], result); }
