			{
				SendClientMessage(playerid, COLOR_RED, " Ошибка, недопустимый символ (знак процентов или ~) !!!");
 				ShowPlayerDialog(playerid, 49, DIALOG_STYLE_PASSWORD,"Смена пароля","Введите новый пароль:","Сменить","Отмена");
				return 1;
			}
 			if(strlen(inputtext) < 8 || strlen(inputtext) > 20)
			{
				SendClientMessage(playerid, COLOR_RED, " Длина пароля должна быть от 8 до 20 символов !");
 				ShowPlayerDialog(playerid, 49, DIALOG_STYLE_PASSWORD,"Смена пароля","Введите новый пароль:","Сменить","Отмена");
				return 1;
			}
			if(strlen(inputtext) > 0 && DZ_VerifyPassword(playerid, inputtext))
			{
				SendClientMessage(playerid, COLOR_RED, " Вы ввели свой старый пароль !!!");
 				ShowPlayerDialog(playerid, 49, DIALOG_STYLE_PASSWORD,"Смена пароля","Введите новый пароль:","Сменить","Отмена");
				return 1;
			}
			new string[256], targetname[MAX_PLAYER_NAME];
			GetPlayerName(playerid,targetname,sizeof(targetname));
			format(string, sizeof(string), " Игрок %s [%d] сменил пароль.", targetname, playerid);
			print(string);
			format(string, sizeof(string), " Пароль успешно изменен.");
			SendClientMessage(playerid, COLOR_GREEN, string);
			if (!DZ_SetPassword(playerid, inputtext)) return 1;
