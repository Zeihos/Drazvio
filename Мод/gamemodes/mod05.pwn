			format(aa333, sizeof(aa333), "%s", pname);//доработка для использования Русских ников
			strcat(GHead[PGang[playerid]], aa333);//доработка для использования Русских ников
//			strcat(GHead[PGang[playerid]], pname);
			printf("[GangsSystem] %s [%d] создал команду %s (цвет команды %s).", aa333, playerid, GName[PGang[playerid]], GColor[PGang[playerid]]);//доработка для использования Русских ников
//			printf("[GangsSystem] %s [%d] создал команду %s (цвет банды %s).", pname, playerid, GName[PGang[playerid]], GColor[PGang[playerid]]);
			GPlayers[PGang[playerid]] = 1;
			strdel(GTDReg[PGang[playerid]], 0, 32);//очистка времени и даты регистрации банды
			gettime(timecor[0], timecor[1]);
			getdate(timecor[2], timecor[3], timecor[4]);
			TimCor();//коррекция времени
			DatCor();//коррекция даты
			format(GTDReg[PGang[playerid]], 32, "%02d:%02d - %02d/%02d/%04d", timecor[0], timecor[1], timecor[4], timecor[3], timecor[2]);
			GSpawnX[PGang[playerid]] = 0.00;//заполнение массивов банды
			GSpawnY[PGang[playerid]] = 0.00;
			GSpawnZ[PGang[playerid]] = 0.00;
			GInter[PGang[playerid]] = 0;
			GWorld[PGang[playerid]] = 0;
			GSkin[PGang[playerid]][0] = 500;
			GSkin[PGang[playerid]][1] = 500;
			GSkin[PGang[playerid]][2] = 500;
			GSkin[PGang[playerid]][3] = 500;
			GSkin[PGang[playerid]][4] = 500;
			GSkin[PGang[playerid]][5] = 500;
			new f[256];
			format(f, 256, "gangs/%i.ini", gangdata);
			new cfile = ini_createFile(f);
			if(cfile == INI_OK)
			{
			    ini_setString(cfile, "Gang TDReg", GTDReg[PGang[playerid]]);
			    ini_setString(cfile, "Gang head", GHead[PGang[playerid]]);
			    ini_setString(cfile, "Gang name", GName[PGang[playerid]]);
			    ini_setString(cfile, "Gang color", GColor[PGang[playerid]]);
   			    ini_setFloat(cfile, "SpawnX", GSpawnX[PGang[playerid]]);
			    ini_setFloat(cfile, "SpawnY", GSpawnY[PGang[playerid]]);
			    ini_setFloat(cfile, "SpawnZ", GSpawnZ[PGang[playerid]]);
		    	ini_setInteger(cfile, "GInter", GInter[PGang[playerid]]);
		    	ini_setInteger(cfile, "GWorld", GWorld[PGang[playerid]]);
       			ini_setInteger(cfile, "Skin1", GSkin[PGang[playerid]][0]);
			    ini_setInteger(cfile, "Skin2", GSkin[PGang[playerid]][1]);
			    ini_setInteger(cfile, "Skin3", GSkin[PGang[playerid]][2]);
			    ini_setInteger(cfile, "Skin4", GSkin[PGang[playerid]][3]);
			    ini_setInteger(cfile, "Skin5", GSkin[PGang[playerid]][4]);
			    ini_setInteger(cfile, "Skin6", GSkin[PGang[playerid]][5]);
			    ini_setInteger(cfile, "Players", GPlayers[PGang[playerid]]);
				ini_closeFile(cfile);
			}
			idgangsave[playerid] = PGang[playerid];//записываем в список ID банды игрока
			SetTimerEx("SaveGangOn", 300, 0, "i", gangdata);
	    }
		else
		{
			ShowPlayerDialog(playerid, 1002, DIALOG_STYLE_INPUT, "Создание команды", "Введите название команды:", "Принять", "Отмена");
		}
		return true;
	}
	if(dialogid == 1016)//удаление команды
	{
	    if(response)
	    {
			for(new i = 0; i < MAX_PLAYERS; i++)////цикл для всех игроков
			{
				if(PGang[playerid] == idgangsave[i])
				{//поиск ID банды в списке:
					idgangsave[i] = 0;//очистка ID банды для записи
				}
			}
			GangSA[PGang[playerid]] = 0;
			SetTimerEx("DZ_Guard_SaveGangOff", 300, 0, "ii", playerid, DZ_EpochAt(playerid));
	    }
		else
		{
			ShowPlayerDialog(playerid, 1001, DIALOG_STYLE_LIST, "Система команд", "Создать команду\nУдалить команду\nНазначить скины\nНазначить место спавна\
			\nОтменить спавн команды\nНазначить уровень\nПригласить в команду\nВыгнать из команды\nОткл. / вкл. разрешение приглашать Вас в команду\
			\nИзменить название команды\nИзменить цвет команды\nУйти из команды\nИнформация о команде\nЧлены команды он-лайн", "Выбор", "Отмена");
		}
		return true;
	}
	if(dialogid == 1004)//приглашение в команду
	{
	    if(response)
	    {
    		if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1)
			{
				SendClientMessage(playerid, 0xFF0000FF, "Ошибка, недопустимый символ (знак процентов или ~) !");
 				ShowPlayerDialog(playerid, 1004, DIALOG_STYLE_INPUT, "Приглашение в команду", "Введите id игрока, которого хотите пригласить:", "Принять", "Отмена");
				return 1;
			}
			if(IsPlayerConnected(strval(inputtext)))
			{
			    if(PlayerInfo[playerid][pFragSlvl] >= 1)return SendClientMessage(playerid, 0xFF0000FF, "Вы не можете приглашать Игрока из фракции синов");
				if(PGang[strval(inputtext)] == -600)
				{
					SendClientMessage(playerid, 0xFF0000FF, "Этот игрок отключил разрешение приглашать себя в команду !");
					return 1;
				}
				if(playspa[strval(inputtext)] == 1)
				{
					if(PGang[strval(inputtext)] == 0)
					{
						new string[256];
				    	format(string, sizeof(string), "Игрок %s пригласил Вас в команду %s", PlayNam(playerid), GName[PGang[playerid]]);
				    	ShowPlayerDialog(strval(inputtext), 1005, DIALOG_STYLE_MSGBOX, "Приглашение в команду", string, "Принять", "Отказать");
    					new pname[MAX_PLAYER_NAME];
						GetPlayerName(strval(inputtext), pname, sizeof(pname));
				    	format(string, sizeof(string), "Игрок %s пригласил игрока %s в команду.", PlayNam(playerid), pname);
						new aa333[64];//доработка для использования Русских ников
						format(aa333, sizeof(aa333), "%s", pname);//доработка для использования Русских ников
						printf("[GangsSystem] %s [%d] пригласил игрока %s в команду.", PlayNam(playerid), playerid, aa333);//доработка для использования Русских ников
//						printf("[GangsSystem] %s [%d] пригласил игрока %s в команду.", PlayNam(playerid), playerid, pname);
				    	for(new i; i<MAX_PLAYERS; i++)
				    	{
				        	if(PGang[i] == PGang[playerid])
				        	{
								SendClientMessage(i, 0x00FF00FF, string);
				        	}
						}
				    	tgang[strval(inputtext)] = PGang[playerid];
					}else return SendClientMessage(playerid, 0xFF0000FF, "Этот игрок уже в команде !");
				}else return SendClientMessage(playerid, 0xFF0000FF, "Этот игрок ещё не заспавнился !");
			}else return SendClientMessage(playerid, 0xFF0000FF, "Этот игрок не в игре !");
	    }
		else
		{
			ShowPlayerDialog(playerid, 1001, DIALOG_STYLE_LIST, "Система команд", "Создать команду\nУдалить команду\nНазначить скины\nНазначить место спавна\
			\nОтменить спавн команды\nНазначить уровень\nПригласить в команду\nВыгнать из команды\nОткл. / вкл. разрешение приглашать Вас в команду\
			\nИзменить название команды\nИзменить цвет команды\nУйти из команды\nИнформация о команде\nЧлены команды он-лайн", "Выбор", "Отмена");
		}
		return true;
	}
	if(dialogid == 1005)
	{
	    if(response)
	    {
			new string[256];
            PGang[playerid] = tgang[playerid];
            GangLvl[playerid] = 1;
			new hex[MAX_PLAYERS];
			hex[playerid] = HexToInt(GColor[PGang[playerid]]);
			if(GSkin[PGang[playerid]][GangLvl[playerid]-1] < 500)
			{//если у 1-го уровня установлен скин, то сменить скин вступившему игроку
				SetPVarInt(playerid, "PlSkin", GSkin[PGang[playerid]][GangLvl[playerid]-1]);
				SetPlayerSkin(playerid, GetPVarInt(playerid, "PlSkin"));
			}
			SetPlayerColor(playerid, hex[playerid]);//устанавливаем цвет ника
			for(new i=0;i<MAX_PLAYERS;i++)//устанавливаем цвет маркера для всех игроков
			{
				SetPlayerMarkerForPlayer(i, playerid, hex[playerid]);
			}
            format(string, sizeof(string), "Вы вступили в команду: {FF0000}%s", GName[PGang[playerid]]);
            SendClientMessage(playerid, 0xFFFF00FF, string);
            format(string, sizeof(string), "Игрок %s вступил в Вашу команду !", PlayNam(playerid));
			printf("[GangsSystem] %s [%d] вступил в команду %s.", PlayNam(playerid), playerid, GName[PGang[playerid]]);
            for(new i; i<MAX_PLAYERS; i++)
            {
				if(PGang[i] == PGang[playerid] && playerid != i)
				{
				    SendClientMessage(i, 0xFFFF00FF, string);
				}
            }
			GPlayers[PGang[playerid]]++;
			GangSave(PGang[playerid]);//запись ID команды в файл
	    }
	    else
		{
		    tgang[playerid] = 0;
		}
		return true;
	}
	if(dialogid == 1006)//изгнание из банды
	{
	    if(response)
	    {
    		if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1)
			{
				SendClientMessage(playerid, 0xFF0000FF, "Ошибка, недопустимый символ (знак процентов или ~) !");
 				ShowPlayerDialog(playerid, 1006, DIALOG_STYLE_INPUT, "Изгнание из команды", "Введите id игрока, которого хотите выгнать:", "Принять", "Отмена");
				return 1;
			}
			new dopper333;
			dopper333 = strval(inputtext);
			if(IsPlayerConnected(dopper333))
			{
				if(PGang[dopper333] == PGang[playerid])
				{
					if(dopper333 != playerid)
					{
						if(GangLvl[dopper333] <= GangLvl[playerid])
						{
							if(idgangsave[dopper333] > 0)//если ID банды для записи - активен, то:
							{
								new perloc;
								idgangsave[dopper333] = 0;//очистка ID банды для записи
								perloc = 0;
								while(perloc < MAX_PLAYERS)//цикл для всех игроков
								{
									if(PGang[dopper333] == PGang[perloc] && dopper333 != perloc)
									{//если есть хотя бы один игрок из банды выходящего, то:
										idgangsave[perloc] = PGang[dopper333];
										break;
									}
									perloc++;
								}
							}
							idgangsave[dopper333] = 0;//очистка ID банды для записи
							new string[256];
							PGang[dopper333] = 0;
							GangLvl[dopper333] = 0;
							format(string, 256, "Вы были выгнаны из команды игроком %s !", PlayNam(playerid));
							SendClientMessage(dopper333, 0xFF0000FF, string);
    						new pname[MAX_PLAYER_NAME];
							GetPlayerName(dopper333, pname, sizeof(pname));
            				format(string, sizeof(string), "Игрок %s выгнал из команды игрока %s !", PlayNam(playerid), pname);
							new aa333[64];//доработка для использования Русских ников
							format(aa333, sizeof(aa333), "%s", pname);//доработка для использования Русских ников
							printf("[GangsSystem] %s [%d] выгнал из команды игрока %s.", PlayNam(playerid), playerid, aa333);//доработка для использования Русских ников
//							printf("[GangsSystem] %s [%d] выгнал из команды игрока %s.", PlayNam(playerid), playerid, pname);
            				for(new i; i<MAX_PLAYERS; i++)
            				{
								if(PGang[i] == PGang[playerid])
								{
				    				SendClientMessage(i, 0xFF0000FF, string);
								}
            				}
							GPlayers[PGang[playerid]]--;
							GangSave(PGang[playerid]);//запись ID банды в файл
						}else return SendClientMessage(playerid, 0xFF0000FF, "Вы не можете выгнать лидера команды !");
					}else return SendClientMessage(playerid, 0xFF0000FF, "Вы не можете выгнать самого себя !");
				}else return SendClientMessage(playerid, 0xFF0000FF, "Этот игрок не в Вашей команде !");
			}else return SendClientMessage(playerid, 0xFF0000FF, "Этот игрок не в игре !");
	    }
		else
		{
			ShowPlayerDialog(playerid, 1001, DIALOG_STYLE_LIST, "Система команд", "Создать команду\nУдалить команду\nНазначить скины\nНазначить место спавна\
			\nОтменить спавн команды\nНазначить уровень\nПригласить в команду\nВыгнать из команды\nОткл. / вкл. разрешение приглашать Вас в команду\
			\nИзменить название команды\nИзменить цвет команды\nУйти из команды\nИнформация о команде\nЧлены команды он-лайн", "Выбор", "Отмена");
		}
		return true;
	}
	if(dialogid == 1007)//смена названия банды
	{
	    if(response)
	    {
    		if(strfind(inputtext, "%", true) != -1 || strfind(inputtext, "~", true) != -1)
			{
				SendClientMessage(playerid, 0xFF0000FF, "Ошибка, недопустимый символ (знак процентов или ~) !");
 				ShowPlayerDialog(playerid, 1007, DIALOG_STYLE_INPUT, "Смена названия команды", "Введите новое название команды:", "Принять", "Отмена");
				return 1;
