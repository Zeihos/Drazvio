			SetPlayerFacingAngle(playerid, TpDestP[playerid][3]);
			SetCameraBehindPlayer(playerid);
		}
		if(TpDestP[playerid][0] > -4000 && TpDestP[playerid][0] < 4000 &&
		TpDestP[playerid][1] > -4000 && TpDestP[playerid][1] < 4000)
		{
			SendClientMessage(playerid, COLOR_GREEN, " Вы были телепортированы на сохранённую позицию.");
		}
		else
		{
			SetTimerEx("DZ_Guard_DubTlp", 1000, 0, "ii", playerid, DZ_EpochAt(playerid));
		}
		return 1;
	}
