				LineStat[3], LineStat[4], LineStat[5]);
				SendClientMessage(playerid, COLOR_LIGHTBLUE, string);
				return 1;
			}
			if (stat == LineStat[para1] && stat == 0)
			{
				format(string,sizeof(string)," Трасса %d уже отключена !", para1);
				SendClientMessage(playerid, COLOR_RED, string);
				return 1;
			}
			if (stat == LineStat[para1] && stat == 1)
			{
				format(string,sizeof(string)," Трасса %d уже подключена !", para1);
				SendClientMessage(playerid, COLOR_RED, string);
				return 1;
			}
			if (stat == 0)
			{
				LineStat[para1] = stat;
				SaveLine();//запись статуса трасс
				format(string,sizeof(string)," *** Администратор %s отключил трассу %d .", sendername, para1);
				print(string);
				SendClientMessageToAll(COLOR_RED, string);
				if(para1 == 1) { LineOff1(); }
				if(para1 == 2) { LineOff2(); }
				if(para1 == 3) { LineOff3(); }
				if(para1 == 4) { LineOff4(); }
				if(para1 == 5) { LineOff5(); }
				return 1;
			}
			if (stat == 1)
			{
				LineStat[para1] = stat;
				SaveLine();//запись статуса трасс
				format(string,sizeof(string)," *** Администратор %s подключил трассу %d .", sendername, para1);
