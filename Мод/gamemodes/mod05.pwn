public OnPlayerKeyStateChange(playerid, newkeys, oldkeys)
{
	if(newkeys == 16 && GetPVarInt(playerid, "animkaon") == 1)
	{
	    SetPVarInt(playerid, "animkaon", 0);
		ClearAnimations(playerid);
	}
	if(newkeys == KEY_NO)
	{
		if(GetPlayerState(playerid) == 2)
		{//или на месте пассажира, то:
			new regm = 0, per1, per2, Float:per3, Float:cor1, Float:cor2, Float:cor3;//флипнуть
			StopDrift(playerid,regm,per1,per2,Float:per3,Float:cor1,Float:cor2,Float:cor3);
		}
	}
	if(newkeys == 16 && Intropic[playerid] > 0)
	{
		new Float:X, Float:Y, Float:Z;
		GetVehiclePos(Intropic[playerid], X, Y, Z);
		SetPlayerPos(playerid, X+4, Y, Z);
		SetPlayerInterior(playerid, 0);
		Intropic[playerid] = 0;
	}
	if(newkeys == KEY_FIRE && PlayerStartJob[playerid])
	{
		if(!IsPlayerInRangeOfPoint(playerid, 3, -1854.7035,-1650.9668,25.7248)
		&& !IsPlayerInRangeOfPoint(playerid, 3, -1803.5344,-1655.2640,25.8294)
		&& !IsPlayerInRangeOfPoint(playerid, 3, -1788.5780,-1640.7179,27.0669)
		&& !IsPlayerInRangeOfPoint(playerid, 3, -1869.1316,-1634.7915,-58.500)
		&& !IsPlayerInRangeOfPoint(playerid, 3, -1868.9603,-1643.6682,-58.046))
		{
			SendClientMessage(playerid, -1, "Вы уронили металл.");
   			DisablePlayerCheckpoint(playerid);
			ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 1);
			PlayerStartJob[playerid] = false;
   			RemovePlayerAttachedObject(playerid, 4);
   			SetPlayerAttachedObject(playerid, 3, 18634, 6, 0.078222, 0.000000, 0.110844, 298.897308, 264.126861, 193.350555, 1.000000, 1.000000, 1.000000);
        	GetPlayerMetall[playerid] = 0;
   			GetPlayerMetallEx[playerid] = 0;
		}
	}
    if( (newkeys & KEY_FIRE) || ( (newkeys & 128) && (oldkeys & 128) && (newkeys & KEY_SECONDARY_ATTACK) ) )//Зелёные зоны
	{
		if(IsPlayerInRangeOfPoint(playerid,100.0,1232.08, -1652.49, 11.79))//Спавн LS
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,15,193.31, 173.87, 1003.02))//Спавн LS
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,25.0,1103.94, -1235.00, 15.82))//зз огнетушитель
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,15.0,2007.39, -2087.33, 13.55))//зз развозчик писем
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,50.0,-2314.76, -151.27, 35.52))//зз пиццельон
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,75.0,2183.8772,-2254.4063,14.7700))//зз Грузин-
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
 		if(PlayerToPoint(100.0,playerid,-50.5098,-232.3062,6.7646))//ЗЗ На дальнобое
    	{
   			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
    	    return 1;
    	}
   		if(PlayerToPoint(10.0,playerid,700.1700,-1475.1852,5.4688))//ЗЗ На водолазе
    	{
    	    ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
    	    return 1;
    	}
		if(IsPlayerInRangeOfPoint(playerid,100.0,1088.24, 1072.23, 10.84))//Спавн LV
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,100.0,1088.24, 1072.23, 10.84))//Спавн LV
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,100.0,-2934.19, 472.95, 4.91))//Спавн SF
		{
            ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,40.0,-3665.56, 1877.92, 809.04))//Ивент-3
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,40.0,-3269.85, 2521.37, 13.62))//Ивент-4
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
		if(IsPlayerInRangeOfPoint(playerid,40.0,2294.031250, 530.909790, 1.794376))//Ивент-4
		{
			ShowPlayerDialog(playerid, 666, DIALOG_STYLE_MSGBOX, "{00FF00}Зелёная зона", "{FF0000}Здесь запрещен ДМ!", "{FFFFFF}OK", "");
			return 1;
		}
        return 1;
	}
	new string[256];
	if((newkeys & 512 && GetPVarInt(playerid, "MnMode") != 2) || (newkeys & 65536 && GetPVarInt(playerid, "MnMode") == 2))
	{
		if(IsPlayerInAnyVehicle(playerid))
	 	{
			if(PlayerInfo[playerid][pPrisonsec] > 0)
			{
				SendClientMessage(playerid, COLOR_RED, " В тюрьме игровое меню не работает !");
				return 1;
			}
			if(admper1[playerid] != 600)
			{
				SendClientMessage(playerid, COLOR_RED, " В режиме наблюдения игровое меню не работает !");
				return 1;
			}
			if(perfrost[playerid] != 600)
			{
				SendClientMessage(playerid, COLOR_RED, " Нельзя, Вы заморожены !");
				return 1;
			}
			if(PlayLock1[0][playerid] != 600)
			{
				SendClientMessage(playerid, COLOR_RED, " Нельзя, Вы заблокированы !");
				return 1;
			}
			if(CallRemoteFunction("mpsysplfunc", "d", playerid) != 0)//чтение статуса участника из системы МП
			{
				SendClientMessage(playerid, COLOR_RED, " В системе МП игровое меню не работает !");
				return 1;
			}
			if(GetPlayerVirtualWorld(playerid) == 96)
			{
			    return 1;
			}
		gettime(timecor[0], timecor[1]);
		TimCor();//коррекция времени
		format(string, sizeof(string), "Игровое меню. Точное время: %02d:%02d",timecor[0],timecor[1]);
  //Gangs system
    	ShowPlayerDialog(playerid, 4, DIALOG_STYLE_LIST, string, "• {FF0000}Транспорт\n• {00FCFF}Меню покупок\n• {FFFF00}Телепорты\n• {00FCFF}Радио\
					\n• {00FCFF}Одежда\n• {00FCFF}Действия\n• {FF0000}Donate\n• {00FCFF}Помощь\n• {00FCFF}On-Line\n• {FF0000}Система команд\n• {00FCFF}Фразы\n• {00FCFF}Достижения\n• {00FCFF}Топ игроков", "ОК", "Отмена");

	 	}
	}
	if((newkeys & 1024 && GetPVarInt(playerid, "MnMode") != 2) || (newkeys & 65536 && GetPVarInt(playerid, "MnMode") == 2))
	{
		if(PlayerInfo[playerid][pPrisonsec] > 0)
		{
			SendClientMessage(playerid, COLOR_RED, " В тюрьме игровое меню не работает !");
			return 1;
		}
		if(admper1[playerid] != 600)
		{
			SendClientMessage(playerid, COLOR_RED, " В режиме наблюдения игровое меню не работает !");
			return 1;
		}
		if(perfrost[playerid] != 600)
		{
			SendClientMessage(playerid, COLOR_RED, " Нельзя, Вы заморожены !");
			return 1;
		}
		if(PlayLock1[0][playerid] != 600)
		{
			SendClientMessage(playerid, COLOR_RED, " Нельзя, Вы заблокированы !");
			return 1;
		}
		if(CallRemoteFunction("mpsysplfunc", "d", playerid) != 0)//чтение статуса участника из системы МП
		{
			SendClientMessage(playerid, COLOR_RED, " В системе МП игровое меню не работает !");
			return 1;
		}
		if(GetPlayerVirtualWorld(playerid) == 96)
		{
			return 1;
		}
        gettime(timecor[0], timecor[1]);
		TimCor();//коррекция времени
		format(string, sizeof(string), "Игровое меню. Точное время: %02d:%02d",timecor[0],timecor[1]);
  //Gangs system
  		ShowPlayerDialog(playerid, 4, DIALOG_STYLE_LIST, string, "• {FF0000}Транспорт\n• {00FCFF}Меню покупок\n• {FFFF00}Телепорты\n• {00FCFF}Радио\
					\n• {00FCFF}Одежда\n• {00FCFF}Действия\n• {FF0000}Donate\n• {00FCFF}Помощь\n• {00FCFF}On-Line\n• {FF0000}Система команд\n• {00FCFF}Фразы\n• {00FCFF}Достижения\n• {00FCFF}Топ игроков", "ОК", "Отмена");

	}
	if( newkeys == 1 || newkeys == 9 || newkeys == 33 && oldkeys != 1 || oldkeys != 9 || oldkeys != 33)
	{
    	new car = GetPlayerVehicleID(playerid);
		new Model5 = GetVehicleModel(car);
        switch(Model5)
        {
            case 446,432,448,452,424,453,454,461,462,463,468,471,430,472,449,473,481,484,493,495,509,510,521,538,522,523,532,537,570,581,586,590,569,595,604,611: return 0;
        }
        AddVehicleComponent(GetPlayerVehicleID(playerid), 1010);
	}

//------------------------------- Elevator -------------------------------------
	if(!IsPlayerInAnyVehicle(playerid) && (newkeys & KEY_NO))
	{
		new Float:pos[3];
		GetPlayerPos(playerid, pos[0], pos[1], pos[2]);
		if(pos[2] > 10.38 && pos[2] < 128.73 &&
		pos[1] < -1301.4 && pos[1] > -1303.2417 && pos[0] < 1786.2131 && pos[0] > 1784.1555)
		{
			for(new i; i < sizeof(ElevatorQueue); i ++)
			{//если этаж занят местом игрока, то отобразить этот этаж красным цветом
				if(FloorRequestedBy[i] != 10000){strcat(string, "{FF0000}");}
				strcat(string, FloorNames[i]);
				strcat(string, "\n");
			}

			ShowPlayerDialog(playerid, 150, DIALOG_STYLE_LIST, "Управление лифтом", string, "OK", "Отмена");
		}
		if(pos[2] > 10.38 && pos[2] < 128.73 &&
		pos[1] > -1301.4 && pos[1] < -1299.1447 && pos[0] < 1785.6147 && pos[0] > 1781.9902)
		{
			new i = 20;//определение этажа, откуда поступил вызов
			while(pos[2] < GetDoorsZCoordForFloor(i) + 3.5 && i > 0){i --;}
			if(i == 0 && pos[2] < GetDoorsZCoordForFloor(0) + 2.0){i = -1;}
			if(i <= 19)
			{
				CallElevator(playerid, i + 1, 0);//вызов, или начало движения лифта
			}
		}
	}
//----------------------------- End Elevator -----------------------------------

	return 1;
}

public OnRconLoginAttempt(ip[], password[], success)
{
    #pragma unused password
    // RCON disabled by default in server.cfg; this protects against misconfiguration.
    for (new i = 0; i < MAX_PLAYERS; i++)
    {
        if (!IsPlayerConnected(i)) continue;
        new playerIP[46];
        GetPlayerIp(i, playerIP, sizeof(playerIP));
        if (strcmp(ip, playerIP, true) != 0) continue;
        if (success)
        {
            passrcon[i] = 0;
            continue;
        }
        passrcon[i]++;
        if (passrcon[i] >= 10)
        {
            passrcon[i] = 0;
            SendClientMessage(i, 0xFF5555FF, "DRAZVIO: Слишком много неудачных попыток RCON. Подключение закрыто.");
            SetTimerEx("DZ_Guard_PlayKick", 300, false, "ii", i, DZ_EpochAt(i));
        }
    }
    return 1;
}

public OnPlayerUpdate(playerid)
{
	if(IsPlayerInRangeOfPoint(playerid, 50.0, -2576.97, -2686.21, 805.80))
	{
	    if(GetPVarInt(playerid, "CLUBMUSIC") == 0)
	    {
	        SetPVarInt(playerid, "CLUBMUSIC", 1);
	        PlayAudioStreamForPlayer(playerid, "http://air2.radiorecord.ru:805/mix_320", -2576.97, -2686.21, 805.80, 50.0, true);
		}
	}
	if(!IsPlayerInRangeOfPoint(playerid, 50.0, -2576.97, -2686.21, 805.80))
	{
		if(GetPVarInt(playerid, "CLUBMUSIC") == 1)
		{
		    SetPVarInt(playerid, "CLUBMUSIC", 0);
		    StopAudioStreamForPlayer(playerid);
		}
	}
    // Достижения проверяем раз в секунду, только после входа в аккаунт.
    new dzTick = GetTickCount();
    if (gPlayerLogged[playerid] && dzTick - DZ_AchievementTick[playerid] >= 1000)
    {
        DZ_AchievementTick[playerid] = dzTick;
        if (!PlayerInfo[playerid][pDostig] && PlayerInfo[playerid][pKills] >= 1000)
        {
            PlayerInfo[playerid][pDostig] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostigg] && PlayerInfo[playerid][pKills] >= 2000)
        {
            PlayerInfo[playerid][pDostigg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostiggg] && PlayerInfo[playerid][pKills] >= 3000)
        {
            PlayerInfo[playerid][pDostiggg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostigggg] && PlayerInfo[playerid][pVIP] >= 1)
        {
            PlayerInfo[playerid][pDostigggg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostiggggg] && PlayerInfo[playerid][pVIP] >= 2)
        {
            PlayerInfo[playerid][pDostiggggg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostigggggg] && PlayerInfo[playerid][pVIP] >= 3)
        {
            PlayerInfo[playerid][pDostigggggg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostiggggggg] && GetPVarInt(playerid, "PlMon") >= 100000000)
        {
            PlayerInfo[playerid][pDostiggggggg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
        if (!PlayerInfo[playerid][pDostigggggggg] && PlayerInfo[playerid][pAdmin] >= 1)
        {
            PlayerInfo[playerid][pDostigggggggg] = 1;
            SendClientMessage(playerid, 0x00FF99FF, "DRAZVIO: Достижение получено!");
        }
    }
	if(PlayerOnJob[playerid] && !PlayerStartJob[playerid] && !IsPlayerInAnyVehicle(playerid))
	{
		if(IsPlayerInRangeOfPoint(playerid, 1, -1854.7035,-1650.9668,25.7248)
		|| IsPlayerInRangeOfPoint(playerid, 1, -1803.5344,-1655.2640,25.8294)
		|| IsPlayerInRangeOfPoint(playerid, 1, -1788.5780,-1640.7179,27.0669))
		{
			SendClientMessage(playerid, -1, "Вы начали добывать обычный металл.");
			DZ_MinerSession[playerid]++;
            SetTimerEx("TimerGiveMiner", 5000, false, "ii", playerid, DZ_MinerSession[playerid]);
			ApplyAnimation(playerid, "SWORD", "sword_4", 4.0, 1, 0, 0, 0, 0);
	  		PlayerStartJob[playerid] = true;
		}
		if(IsPlayerInRangeOfPoint(playerid, 1, -1869.1316,-1634.7915,-58.500)
		|| IsPlayerInRangeOfPoint(playerid, 1, -1868.9603,-1643.6682,-58.046))
		{
			SendClientMessage(playerid, -1, "Вы начали добывать качественный металл.");
			DZ_MinerSession[playerid]++;
            SetTimerEx("TimerGiveMinerEx", 5000, false, "ii", playerid, DZ_MinerSession[playerid]);
			ApplyAnimation(playerid, "SWORD", "sword_4", 4.0, 1, 0, 0, 0, 0);
	  		PlayerStartJob[playerid] = true;
		}
		return 1;
	}
	if(PlayerStartJob[playerid])
	{
	    if(IsPlayerApplyAnimation(playerid, "FALL_back")
		|| IsPlayerApplyAnimation(playerid, "FALL_collapse")
		|| IsPlayerApplyAnimation(playerid, "FALL_fall")
		|| IsPlayerApplyAnimation(playerid, "FALL_front")
		|| IsPlayerApplyAnimation(playerid, "FALL_glide")
		|| IsPlayerApplyAnimation(playerid, "FALL_land")
		|| IsPlayerApplyAnimation(playerid, "FALL_skyDive")
		|| IsPlayerApplyAnimation(playerid, "JUMP_glide")
		|| IsPlayerApplyAnimation(playerid, "JUMP_land")
		|| IsPlayerApplyAnimation(playerid, "JUMP_launch")
		|| IsPlayerApplyAnimation(playerid, "JUMP_launch_R"))
	    {
			if(!IsPlayerInRangeOfPoint(playerid, 3, -1854.7035,-1650.9668,25.7248)
			&& !IsPlayerInRangeOfPoint(playerid, 3, -1803.5344,-1655.2640,25.8294)
			&& !IsPlayerInRangeOfPoint(playerid, 3, -1788.5780,-1640.7179,27.0669)
			&& !IsPlayerInRangeOfPoint(playerid, 3, -1869.1316,-1634.7915,-58.500)
			&& !IsPlayerInRangeOfPoint(playerid, 3, -1868.9603,-1643.6682,-58.046))
			{
				SendClientMessage(playerid, -1, "Вы уронили металл.");
			    DisablePlayerCheckpoint(playerid);
				ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 0, 1);
				PlayerStartJob[playerid] = false;
			    RemovePlayerAttachedObject(playerid, 4);
			    SetPlayerAttachedObject(playerid, 3, 18634, 6, 0.078222, 0.000000, 0.110844, 298.897308, 264.126861, 193.350555, 1.000000, 1.000000, 1.000000);
        		GetPlayerMetall[playerid] = 0;
