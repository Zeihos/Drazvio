public TimerGiveMiner(playerid, session)
{
    if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 1;
    if (session != DZ_MinerSession[playerid] || !gPlayerLogged[playerid]) return 1;
    if (!PlayerOnJob[playerid] || !PlayerStartJob[playerid] || IsPlayerInAnyVehicle(playerid)) return 1;
    if (!IsPlayerInRangeOfPoint(playerid, 3.0, -1854.7035, -1650.9668, 25.7248)
        && !IsPlayerInRangeOfPoint(playerid, 3.0, -1803.5344, -1655.2640, 25.8294)
        && !IsPlayerInRangeOfPoint(playerid, 3.0, -1788.5780, -1640.7179, 27.0669))
    {
        PlayerStartJob[playerid] = false;
        return 1;
    }
    SendClientMessage(playerid, -1, "Вы добыли обычный металл. Теперь отнесите его на склад.");
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 1, 1);
    SetPlayerAttachedObject(playerid, 4, 2936, 1, 0.184699, 0.426247, 0.000000, 259.531341, 80.949592, 0.000000, 0.476124, 0.468181, 0.470769);
    SetPlayerCheckpoint(playerid, -1865.7438, -1622.5901, 21.9036, 3.0);
    ExtraMetall[playerid] = 0;
    return 1;
}

public TimerGiveMinerEx(playerid, session)
{
    if (playerid < 0 || playerid >= MAX_PLAYERS || !IsPlayerConnected(playerid)) return 1;
    if (session != DZ_MinerSession[playerid] || !gPlayerLogged[playerid]) return 1;
    if (!PlayerOnJob[playerid] || !PlayerStartJob[playerid] || IsPlayerInAnyVehicle(playerid)) return 1;
    if (!IsPlayerInRangeOfPoint(playerid, 3.0, -1869.1316, -1634.7915, -58.500)
        && !IsPlayerInRangeOfPoint(playerid, 3.0, -1868.9603, -1643.6682, -58.046))
    {
        PlayerStartJob[playerid] = false;
        return 1;
    }
    SendClientMessage(playerid, -1, "Вы добыли качественный металл. Теперь отнесите его на склад.");
    ApplyAnimation(playerid, "CARRY", "crry_prtial", 4.0, 0, 0, 0, 1, 1);
    SetPlayerAttachedObject(playerid, 4, 2936, 1, 0.184699, 0.426247, 0.000000, 259.531341, 80.949592, 0.000000, 0.476124, 0.468181, 0.470769);
    SetPlayerCheckpoint(playerid, -1865.7438, -1622.5901, 21.9036, 3.0);
    ExtraMetall[playerid] = 1;
    return 1;
}

