    SetPlayerWeather(playerid,10);
    return 1;
}

stock ZP(word[])
{
	if(strlen(word)>22) return 0;
	if(strfind(word,",", true)==-1) return 0;

	new ip[5][256],index;
	ip[0] = strtook(word,index,',');
	ip[1] = strtook(word,index,',');
	ip[2] = strtook(word,index,',');
	if(strfind(word,":",true)>0){
		ip[3] = strtook(word,index,':');
		if(strfind(word,",",true)>0) ip[4] = strtook(word,index,',');else ip[4] = strtook(word,index);
	} else {
		if(strfind(word,",",true)==strlen(word)) ip[3] = strtook(word,index,',');else ip[3] = strtook(word,index);
		valstr(ip[4],0);
	}
	if(!iscifra(ip[0])||!iscifra(ip[1])||!iscifra(ip[2])||!iscifra(ip[3])||!iscifra(ip[4])
		||!strlen(ip[0])||!strlen(ip[1])||!strlen(ip[2])||!strlen(ip[3])||!strlen(ip[4])
		||(strval(ip[0])==192&&strval(ip[1])==168)
		||(strval(ip[0])==172&&strval(ip[1])>=16&&strval(ip[1])<=31)
		||strval(ip[0])==10||(strval(ip[0])==127&&strval(ip[1])==0&&strval(ip[2])==0&&strval(ip[3])==1)) return 0;
	return 1;
}
