# Keep only reviewed static scriptfiles in source control.
# Any new runtime directory or INI needs a conscious exception.
/server/scriptfiles/*
!/server/scriptfiles/CarSpawn/
!/server/scriptfiles/data/
/server/scriptfiles/CarSpawn/*
!/server/scriptfiles/CarSpawn/*.txt
/server/scriptfiles/data/*
!/server/scriptfiles/data/*.ini.example

# Private server settings, player data and files created at runtime.
/server/server.cfg
/server/gamemodes/*.amx
/server/filterscripts/gatesys2.amx
/server/filterscripts/reklama.amx
/server/plugins/FileFunctions.dll

# Build outputs and temporary files.
/build-amx/
/dist/
/backups/
/*.zip
*.log
*.bak
*.backup
*.before_build
*.savenew
*.regnew
*.swapold
*.part
*.tmp
*.db
*.sqlite3
__pycache__/
*.pyc
.DS_Store
Thumbs.db
